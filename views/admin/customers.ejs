<%- include("../../views/partials/admin/sidebar") %>
<head>
    <link rel="stylesheet" href="/assets/css/customers.css">
</head>
<body>

    <!-- Sidebar Overlay for Mobile -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Main Content - This wrapper is crucial -->
    <main class="main-content" id="mainContent">
        <!-- Your customer page content starts here -->
        <div class="content-header row">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="content-title card-title">Customers</h2>
            </div>
        </div>         

      <div class="card">
    <header class="card-header text-center mb-20">
        <form action="/admin/users/" method="get" class="d-inline">
            <div class="input-group input-group-sm border border-1 border-grey rounded-pill" style="width: 500px; margin: 0 auto;">
                <input type="text" class="form-control border-0 rounded-pill" 
                       placeholder="Search customers..." 
                       name="search" 
                       value="<%= searchTerm || '' %>">
                <button class="btn border-0" type="submit">Search</button>
                <% if(searchTerm || searchTerm.trim() !== ""){ %>
                    <a href="/admin/users" class="p-2 text-danger" ><i class="bi bi-x-circle"></i></a>
                <% } %>
            </div>
        </form>
    </header>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th scope="col"><b>Name</b></th>
                        <th scope="col"><b>Email</b></th>
                        <th scope="col"><b>Joined</b></th>
                        <th scope="col"><b>Phone No</b></th>
                        <th scope="col"><b>Action</b></th>
                    </tr>
                </thead>
                <tbody>
                    <% if(data && data.length > 0) { %>
                        <% for(let i = 0; i < data.length; i++) { %>
                            
                            <tr>

                                <td><%= data[i].name %></td>
                                <td><%= data[i].email %></td>
                                <td><%= data[i].createdOn.toLocaleString('en-IN',{timeZone:'Asia/Kolkata',
                                    day:'2-digit',
                                    month:'2-digit',
                                    year:'numeric',
                                    hour:'2-digit',
                                    minute:'2-digit',
                                    second:'2-digit',
                                    hour12:true
                                })%></td>
                                <td><%= data[i].phone %></td>
                                <td>
                                    <% if (data[i].isBlocked === false) { %>
                                        <button class="btn btn-danger" style="width: 80px;" onclick="toggleBlock('<%= data[i]._id %>', true, this)">
                                        Block
                                        </button>
                                    <% } else { %>
                                        <button class="btn btn-success" style="width: 80px;" onclick="toggleBlock('<%= data[i]._id %>', false, this)">
                                        Unblock
                                        </button>
                                    <% } %>
                                </td>


                            </tr>
                        <% } %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="text-center">No customers found</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

      <!-- Pagination -->
<% if(totalPages > 1) { %>
<div class="container mt-3">
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <!-- Previous button -->
            <% if(currentPage > 1) { %>
                <li class="page-item">
                    <a class="page-link" href="?page=<%= currentPage - 1 %><%= searchTerm ? '&search=' + encodeURIComponent(searchTerm) : '' %>">Previous</a>
                </li>
            <% } %>
            
            <!-- Page numbers -->
            <% for(let i = 1; i <= totalPages; i++) { %>
                <li class="page-item <%= (i === currentPage) ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= i %><%= searchTerm ? '&search=' + encodeURIComponent(searchTerm) : '' %>"><%= i %></a>
                </li> 
            <% } %>
            
            <!-- Next button -->
            <% if(currentPage < totalPages) { %>
                <li class="page-item">
                    <a class="page-link" href="?page=<%= currentPage + 1 %><%= searchTerm ? '&search=' + encodeURIComponent(searchTerm) : '' %>">Next</a>
                </li>
            <% } %>
        </ul>
    </nav>
</div>
<% } %>
    </main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>


     

         async function toggleBlock(userId, shouldBlock, button) {
                const action = shouldBlock ? 'block' : 'unblock';
                const result = await Swal.fire({
                title: `Are you sure?`,
                text: `Do you want to ${action} this user?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: `Yes, ${action}`,
                cancelButtonText: 'Cancel'
                });

                if (!result.isConfirmed) return;

                try {
                const response = await fetch(`/admin/${shouldBlock ? 'blockCustomer' : 'unblockCustomer'}?id=${userId}`, {
                    method: 'GET'
                });

                if (response.ok) {
                    button.classList.toggle('btn-danger');
                    button.classList.toggle('btn-success');
                    const newText = shouldBlock ? 'Unblock' : 'Block';
                    const newState = !shouldBlock;
                    button.textContent = newText;
                    button.setAttribute('onclick', `toggleBlock('${userId}', ${newState}, this)`);

                    Swal.fire({
                    title: 'Success!',
                    text: `User has been ${action}ed successfully.`,
                    icon: 'success',
                    timer: 1500,
                    showConfirmButton: false
                    });
                } else {
                    Swal.fire('Error', 'Action failed. Please try again.', 'error');
                }
                } catch (err) {
                console.error(err);
                Swal.fire('Error', 'Server error.', 'error');
                }
        }
    </script>
</body>
