<%- include("../../views/partials/admin/sidebar") %>
    <title>Admin - Order Management</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/adminOrders.css">
    </head>

    <body>
        <!-- Sidebar Overlay for mobile -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- Main Content -->
        <main class="main-content" id="mainContent">
            <div class="content-card">
                <div class="mb-4">
                    <h1 class="page-title">Order Management</h1>
                    <p class="text-muted">Manage and track all customer orders</p>
                </div>

                <!-- Stats Cards -->
                <div class="row mb-4 g-2 row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 row-cols-xl-5">
                    <div class="col">
                        <div class="stats-card p-2 text-center h-100">
                            <div class="text-warning mb-1"><i class="fas fa-clock"></i></div>
                            <h4 class="mb-0" id="pendingCount">
                                <%= statusCounts.Pending %>
                            </h4>
                            <p class="text-muted small mb-0">Pending</p>
                        </div>
                    </div>
                    <div class="col">
                        <div class="stats-card p-2 text-center h-100">
                            <div class="text-primary mb-1"><i class="fas fa-cog"></i></div>
                            <h4 class="mb-0" id="processingCount">
                                <%= statusCounts.Processing %>
                            </h4>
                            <p class="text-muted small mb-0">Processing</p>
                        </div>
                    </div>
                    <div class="col">
                        <div class="stats-card p-2 text-center h-100">
                            <div class="text-info mb-1"><i class="fas fa-shipping-fast"></i></div>
                            <h4 class="mb-0" id="shippedCount">
                                <%= statusCounts.Shipped %>
                            </h4>
                            <p class="text-muted small mb-0">Shipped</p>
                        </div>
                    </div>
                    <div class="col">
                        <div class="stats-card p-2 text-center h-100">
                            <div class="text-secondary mb-1"><i class="fas fa-truck"></i></div>
                            <h4 class="mb-0" id="outForDeliveryCount">
                                <%= statusCounts['Out-for-delivery'] %>
                            </h4>
                            <p class="text-muted small mb-0">Out for Delivery</p>
                        </div>
                    </div>
                    <div class="col">
                        <div class="stats-card p-2 text-center h-100">
                            <div class="text-success mb-1"><i class="fas fa-check-circle"></i></div>
                            <h4 class="mb-0" id="deliveredCount">
                                <%= statusCounts.Delivered %>
                            </h4>
                            <p class="text-muted small mb-0">Delivered</p>
                        </div>
                    </div>
                    <div class="col">
                        <div class="stats-card p-2 text-center h-100">
                            <div class="text-danger mb-1"><i class="fas fa-times-circle"></i></div>
                            <h4 class="mb-0" id="cancelledCount">
                                <%= statusCounts.Cancelled %>
                            </h4>
                            <p class="text-muted small mb-0">Cancelled</p>
                        </div>
                    </div>
                    <div class="col">
                        <div class="stats-card p-2 text-center h-100">
                            <div class="text-dark mb-1"><i class="fas fa-undo"></i></div>
                            <h4 class="mb-0" id="returnedCount">
                                <%= statusCounts.Returned %>
                            </h4>
                            <p class="text-muted small mb-0">Returned</p>
                        </div>
                    </div>
                    <div class="col">
                        <div class="stats-card p-2 text-center h-100">
                            <div class="text-muted mb-1"><i class="fas fa-exclamation-triangle"></i></div>
                            <h4 class="mb-0" id="paymentFailedCount">
                                <%= statusCounts['Payment-failed'] %>
                            </h4>
                            <p class="text-muted small mb-0">Pay Failed</p>
                        </div>
                    </div>
                    <div class="col">
                        <div class="stats-card p-2 text-center h-100 border-danger">
                            <div class="text-danger mb-1"><i class="fas fa-ban"></i></div>
                            <h4 class="mb-0" id="cancelRequestCount">
                                <%= statusCounts['Cancellation Requested'] %>
                            </h4>
                            <p class="text-muted small mb-0">Cancel Req</p>
                        </div>
                    </div>
                    <div class="col">
                        <div class="stats-card p-2 text-center h-100 border-warning">
                            <div class="text-warning mb-1"><i class="fas fa-reply-all"></i></div>
                            <h4 class="mb-0" id="returnRequestCount">
                                <%= statusCounts['Return Requested'] %>
                            </h4>
                            <p class="text-muted small mb-0">Return Req</p>
                        </div>
                    </div>
                </div>

                <!-- Filters -->
                <div class="filter-section p-4 mb-4">
                    <div class="row align-items-center">
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Status Filter</label>
                            <select class="form-select" id="statusFilter">
                                <option value="">All Status</option>
                                <option value="Pending">Pending</option>
                                <option value="Processing">Processing</option>
                                <option value="Shipped">Shipped</option>
                                <option value="Out-for-delivery">Out for Delivery</option>
                                <option value="Delivered">Delivered</option>
                                <option value="Cancelled">Cancelled</option>
                                <option value="Returned">Returned</option>
                                <option value="Payment-failed">Payment Failed</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Date Range</label>
                            <select class="form-select" id="dateFilter">
                                <option value="">All Time</option>
                                <option value="today">Today</option>
                                <option value="week">This Week</option>
                                <option value="month">This Month</option>
                                <option value="custom">Custom Range</option>
                            </select>
                            <input type="date" id="startDate" class="form-control d-none mt-2">
                            <input type="date" id="endDate" class="form-control d-none mt-2">


                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Search Orders</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="searchInput"
                                    placeholder="Search by Order ID, Customer Name...">
                                <button class="btn btn-primary" type="button"><i class="fas fa-search"></i></button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Orders Table -->
                <div class="order-table">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="px-4 py-3">#</th>
                                    <th class="px-4 py-3">Order ID</th>
                                    <th class="py-3">Customer</th>
                                    <th class="py-3">Date</th>
                                    <th class="py-3">Items QTY</th>
                                    <th class="py-3">Amount</th>
                                    <th class="py-3">Status</th>
                                    <th class="py-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="ordersTableBody">
                                <% orders.forEach((order, index)=> { %>
                                    <tr>
                                        <td class="px-4">
                                            <%= (currentPage - 1) * limit + index + 1 %>
                                        </td>
                                        <td>
                                            <%=order.orderId %>
                                        </td>
                                        <td>
                                            <%= order.userId ? order.userId.name : 'Guest User' %>
                                        </td>
                                        <td>
                                            <%= order.createdOn.toLocaleDateString('en-IN') %>
                                        </td>
                                        <td>
                                            <% order.orderedItems.forEach(item=> { %>
                                                <%= item.quantity %>
                                                    <%= item.product ? item.product._id : '' %> <br>
                                                        <% }) %>
                                        </td>
                                        <td>₹<%= order.totalPrice%>
                                        </td>
                                        <td><span
                                                class="badge bg-<%= order.status === 'Delivered' ? 'success' : 'warning' %>"></span>
                                            <%= order.status %>
                                        </td>
                                        <td>
                                            <a href="/admin/viewOrderDetails/<%= order.orderId %>"
                                                class="btn btn-sm btn-primary">View</a>
                                        </td>
                                    </tr>
                                    <% }) %>

                            </tbody>
                        </table>
                    </div>

                </div>

                <div class="pagination" id="pagination">

                </div>

            </div>
        </main>


        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
        <script>

            document.addEventListener('DOMContentLoaded', () => {

                let currentPage = 1;

                const statusFilter = document.getElementById('statusFilter')
                const dateFilter = document.getElementById('dateFilter')
                const tableBody = document.getElementById('ordersTableBody')
                const searchInput = document.getElementById('searchInput')
                const startDateEl = document.getElementById("startDate")
                const endDateEl = document.getElementById("endDate")

                statusFilter.addEventListener('change', () => applyFilters(1));
                searchInput.addEventListener('input', () => applyFilters(1))

                dateFilter.addEventListener('change', () => {
                    if (dateFilter.value === 'custom') {
                        startDateEl.classList.remove('d-none');
                        endDateEl.classList.remove('d-none');
                    } else {
                        startDateEl.classList.add('d-none');
                        endDateEl.classList.add('d-none');
                        startDateEl.value = "";
                        endDateEl.value = "";
                    }
                    applyFilters(1)
                });

                startDateEl.addEventListener('change', () => applyFilters(1));
                endDateEl.addEventListener('change', () => applyFilters(1));

                async function applyFilters(page = 1) {

                    currentPage = page;

                    const status = statusFilter.value;
                    const date = dateFilter.value;
                    const search = searchInput.value;
                    const startDate = startDateEl.value;
                    const endDate = endDateEl.value;
                    const today = new Date().toISOString().split("T")[0];
                    startDateEl.setAttribute("max", today);
                    endDateEl.setAttribute("max", today);


                    // 🔒 Prevent invalid custom request
                    if (date === 'custom' && (!startDate || !endDate)) return;


                    const url = `/admin/order?status=${status}&date=${date}&search=${search}&startDate=${startDate}&endDate=${endDate}&page=${page}`;

                    try {
                        const res = await fetch(url, {
                            headers: {
                                'Accept': 'application/json'
                            }
                        });
                        const data = await res.json();
                        renderTable(data.orders, data.currentPage, data.limit);
                        renderPagination(data.currentPage, data.totalPages)
                        updateStats(data.statusCounts);
                    } catch (error) {

                        console.error("error in order filter ejs ", error)
                    }
                }

                function updateStats(counts) {
                    if (!counts) return;
                    document.getElementById('pendingCount').innerText = counts.Pending || 0;
                    document.getElementById('processingCount').innerText = counts.Processing || 0;
                    document.getElementById('shippedCount').innerText = counts.Shipped || 0;
                    document.getElementById('outForDeliveryCount').innerText = counts['Out-for-delivery'] || 0;
                    document.getElementById('deliveredCount').innerText = counts.Delivered || 0;
                    document.getElementById('cancelledCount').innerText = counts.Cancelled || 0;
                    document.getElementById('returnedCount').innerText = counts.Returned || 0;
                    document.getElementById('paymentFailedCount').innerText = counts['Payment-failed'] || 0;
                    document.getElementById('cancelRequestCount').innerText = counts['Cancellation Requested'] || 0;
                    document.getElementById('returnRequestCount').innerText = counts['Return Requested'] || 0;
                }

                function renderTable(orders, page = 1, limit = 10) {
                    tableBody.innerHTML = "";

                    if (!orders.length) {
                        tableBody.innerHTML = `<tr><td colspan="8" class="text-center">No Orders Found</td></tr>`;
                        return;
                    }

                    orders.forEach((order, index) => {
                        const row = document.createElement('tr');
                        const count = (page - 1) * limit + index + 1;
                        row.innerHTML = `
                    <td class="px-4">${count}</td>
                    <td>${order.orderId}</td>
                    <td> ${order.userId ? order.userId.name : 'Guest User'}</td>
                    <td>${new Date(order.createdOn).toLocaleDateString('en-IN')}</td>
                    <td>
                        ${(order.orderedItems || []).map(item =>
                            `${item.quantity} * ${item.product ? item.price : 'Unkown Product'}`
                        ).join("<br>")}    
                    </td> 
                    <td>₹${order.totalPrice}</td>  
                    <td>
                        <span class="badge bg-${order.status === "Delivered" ? "success" : "warning"}" >
                        ${order.status}
                        </span>
                    </td>  
                    <td>
                    <a href="/admin/viewOrderDetails/${order.orderId}" class="btn btn-sm btn-primary">View</a>    
                    </td>  
                ` ;
                        tableBody.appendChild(row);
                    });
                }

                function renderPagination(currentPage, totalPages) {
                    const pagination = document.getElementById('pagination');

                    pagination.innerHTML = "";

                    if (totalPages <= 1) return

                    if (currentPage > 1) {
                        pagination.innerHTML += ` <a href="#" data-page="${currentPage - 1}">&laquo; Prev</a>`;
                    }

                    for (let i = 1; i <= totalPages; i++) {
                        pagination.innerHTML += ` <a href="#"
                            data-page="${i}"
                            class="${currentPage === i ? "active" : ""}">
                            ${i}
                        </a>
                        `;
                    }

                    if (currentPage < totalPages) {
                        pagination.innerHTML += `
                            <a href="#" data-page="${currentPage + 1}">Next &raquo;</a>
                            `;
                    }

                    pagination.querySelectorAll("a").forEach(link => {
                        link.addEventListener("click", e => {
                            e.preventDefault();
                            applyFilters(Number(link.dataset.page));
                        });
                    });

                }

                applyFilters(1);

            })


        </script>

    </body>

    </html>