<%- include("../../views/partials/admin/sidebar") %>
<head>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.5.13/dist/cropper.min.css" />
</head>
<style>
  .page-item {
    margin: 0 3px;
  }

  .page-link {
    padding: 6px 12px;
    border: 1px solid #dee2e6;
    color: #007bff;
    border-radius: 4px;
    text-decoration: none;
  }

  .page-item.active .page-link {
    background-color: #007bff;
    color: white;
    border-color: #007bff;
  }
  .pagination {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 5px;
    padding-left: 0;
    list-style: none;
  }

  .error-message {
    color: red;
  }

  .ml-105 {
    margin-left: 105px;
  }

  .mt-20 {
    margin-top: 20px;
  }

  .content-header {
    margin-bottom: 25px;
  }

  .content-title {
    font-size: 24px;
    font-weight: 600;
    color: var(--primary-color);
    margin: 0;
  }
</style>
<!-- Sidebar Overlay for Mobile -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- Main Content -->
<main class="main-content" id="mainContent">
  <div class="content-card">
    <section class="content-main">
      <div class="content-header">
        <div>
          <h2 class="content-title card-title">Brands</h2>
        </div>
      </div>
      <div class="card">
        <div class="card-body">
          <div class="row">
            <div class="col-md-3">
              <form id="brandform" enctype="multipart/form-data">
                <div class="mb-4">
                  <label for="product_name" class="form-label"
                    >Brand Name</label
                  >
                  <input
                    type="text"
                    name="name"
                    id="brandname"
                    placeholder="Type here"
                    class="form-control"
                  />
                </div>
                <label for="product_name" class="form-label">Brand Image</label>
                <div class="input-upload">
                  <img src="" alt="" />
                  <input
                    class="form-control border"
                    id="brandimg"
                    name="image"
                    type="file"
                  />
                </div>
                <div class="d-grid">
                  <button class="btn btn-primary mt-20" type="submit">
                    Add Brand
                  </button>
                </div>
              </form>
              <!-- 🟩 Place this crop modal here -->
            <div id="cropModal" style="display: none;">
                  <div style="text-align: center;">
                    <img id="imagePreview" style="max-width: 100%; height: auto;" />
                  </div>
                  <button id="cropButton" class="btn btn-success mt-3">Crop & Upload</button>
                </div>
            </div>
           
            <div class="col-md-7 ml-105">
              <div class="table-responsive">
                <table class="table table-hover">
                  <thead>
                    <tr>
                      <th>Brand</th>
                      <th>Logo</th>
                      <th>Status</th>
                      <th>Block/Unblock</th>
                      <th>Edit</th>
                    </tr>
                  </thead>

                  <tbody>
                    <% data.reverse().forEach((brand,index)=>{%>
                    <tr>
                      <td class="text-start"><%=brand.brandName%></td>
                      <td class="text-start">
                        <div
                          class="d-flex align-items-center justify-content-center"
                          style="width: 50px; height: 50px"
                        >
                          <img
                            src="<%= brand.brandImage%>"
                            alt="<%=brand.brandName%>"
                            class="img-fluid rounded-circle"
                            style="width: 100%; height: auto"
                          />
                        </div>
                      </td>
                      <td class="text-start">
                        <% if(brand.isBlocked === true){ %>
                        <span
                          class="badge rounded-pill bg-danger alert-danger bg-opacity-50 text-white"
                          style="width: 60px"
                          >Blocked</span
                        >
                        <%}else{%>
                        <span
                          class="badge rounded-pill alert-success bg-success bg-opacity-50 text-white"
                          style="width: 60px"
                          >Active</span
                        >
                        <%}%>
                      </td>
                      <td class="text-start">
                        <%if(brand.isBlocked === false){%>
                        <!-- <button class="btn btn-danger" style="width: 90px"> -->
                        <a
                          href="/admin/blockBrand?id=<%=brand._id%>"
                          class="btn btn-danger text-white no-underline"
                        >
                          Block
                        </a>
                        <!-- </button> -->
                        <%}else{%>
                        <!-- <button class="btn btn-success" style="width: 90px"> -->
                        <a
                          href="/admin/unBlockBrand?id=<%=brand._id%>"
                          class="btn btn-success text-white"
                          >Unblock</a
                        >
                        <!-- </button> -->
                        <%}%>
                      </td>
                      <td><a class="text-decoration-none" href="/admin/editBrand?id=<%= brand._id %>">✏️</a></td>
                    </tr>
                    <%})%>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="pagination-container d-flex justify-content-center m-4">
        <ul class="pagination">
          <% if(currentPage >1){%>
          <li class="page-item">
            <a class="page-link" href="?page=<%= currentPage-1 %>">prev</a>
          </li>
          <%}%> <%for(let i=1; i<=totalPages; i++){%>
          <li class="page-item <%= currentPage === i ? 'active' : '' %>">
            <a class="page-link" href="?page=<%= i %>"><%= i%></a>
          </li>
          <%}%> <%if(currentPage < totalPages){%>
          <li class="page-item">
            <a class="page-link" href="?page=<%= currentPage + 1 %>">next</a>
          </li>
          <%}%>
        </ul>
      </div>
    </section>
  </div>
</main>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/cropperjs@1.5.13/dist/cropper.min.js"></script>
<script>
  let cropper; // for global access

  const brandImageInput = document.getElementById("brandimg");
  const imagePreview = document.getElementById("imagePreview");
  const cropModal = document.getElementById("cropModal");
  const cropButton = document.getElementById("cropButton");

  // Step 1: When user selects an image
  brandImageInput.addEventListener("change", (event) => {
    const file = event.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (e) => {
      imagePreview.src = e.target.result;
      cropModal.style.display = "block"; // show crop modal

      // Destroy old cropper instance if it exists
      if (cropper) cropper.destroy();

      // Create new cropper
      cropper = new Cropper(imagePreview, {
        viewMode: 1,
        autoCropArea: 1,
        responsive: true,
        movable: true,
        zoomable: true,
        rotatable: false,
        scalable: false,
        // 👇 allows free ratio (you can adjust or lock aspectRatio)
        aspectRatio: NaN, 
      });
    };
    reader.readAsDataURL(file);
  });

  // Step 2: When user clicks "Crop & Upload"
  cropButton.addEventListener("click", async () => {
    const canvas = cropper.getCroppedCanvas({
      width: 400, // optional, set desired output width
      imageSmoothingQuality: "high",
    });

    const croppedBlob = await new Promise((resolve) =>
      canvas.toBlob(resolve, "image/jpeg")
    );

    cropModal.style.display = "none"; // hide crop UI

    // Upload cropped image to Cloudinary
    const cloudUrl = "https://api.cloudinary.com/v1_1/dbl2eazti/image/upload";
    const cloudFormData = new FormData();
    cloudFormData.append("file", croppedBlob);
    cloudFormData.append("upload_preset", "hourly");

    try {
      const cloudResponse = await fetch(cloudUrl, {
        method: "POST",
        body: cloudFormData,
      });

      const cloudResult = await cloudResponse.json();

      if (cloudResult.secure_url) {
        // append brand image URL to form
        const formData = new FormData(document.getElementById("brandform"));
        formData.append("brandImage", cloudResult.secure_url);

        // send to backend
        const response = await fetch("/admin/addBrand", {
          method: "POST",
          body: formData,
        });

        const result = await response.json();

        if (result.success) {
          Swal.fire({
            icon: "success",
            title: "Brand Added",
            text: result.message,
            showConfirmButton: false,
            timer: 2000,
          }).then(() => window.location.reload());
        } else {
          Swal.fire({
            icon: "error",
            title: "Oops",
            text: result.message || "Something went wrong",
          });
        }
      } else {
        throw new Error("Cloudinary upload failed");
      }
    } catch (error) {
      console.error("Error during brand upload:", error);
      Swal.fire({
        icon: "error",
        title: "Upload Failed",
        text: "Something went wrong. Try again.",
      });
    }
  });
</script>

    