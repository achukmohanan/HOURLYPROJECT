<%- include("../../views/partials/admin/sidebar") %>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Product | HOURLY | ADMIN</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs/dist/cropper.min.css">
    <link href="https://unpkg.com/cropperjs/dist/cropper.min.css" rel="stylesheet" />
    <style>
        :root {
            --sidebar-width: 250px;
            --header-height: 70px;
            --primary-color: #2c3e50;
            --secondary-color: #785d5d;
            --accent-color: #3498db;
            --text-light: #ecf0f1;
            --bg-light: #f8f9fa;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-light);
        }

        /* Main Content - Adjusted to work with existing sidebar */
        .main-content {
            margin-top: var(--header-height);
            margin-left: var(--sidebar-width);
            padding: 30px;
            transition: margin-left 0.3s ease;
            min-height: calc(100vh - var(--header-height));
        }

        .main-content.expanded {
            margin-left: 0;
        }

        /* Product page specific styles */
        .content-main {
            background: white;
            border-radius: 10px;
            box-shadow: 0 2px 20px rgba(0,0,0,0.08);
            padding: 30px;
            margin-bottom: 20px;
        }

        .content-header h2 {
            color: var(--primary-color);
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 30px;
        }

        .thumbnails-container {
            display: flex;
            overflow-x: auto;
        }

        .thumbnail {
            margin-right: 10px;
        }

        .input-upload {
            position: relative;
        }

        .error-message {
            color: #dc3545;
            display: none;
            font-size: 0.875em;
            margin-top: 0.25rem;
        }

        .form-control, .form-select {
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
            padding: 0.5rem 0.75rem;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--accent-color);
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }

        .btn {
            border-radius: 0.375rem;
            font-weight: 500;
            transition: all 0.15s ease-in-out;
        }

        .btn-primary {
            background-color: var(--accent-color);
            border-color: var(--accent-color);
        }

        .btn-primary:hover {
            background-color: #2980b9;
            border-color: #2980b9;
        }

        .card {
            border: none;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            border-radius: 0.5rem;
            margin-bottom: 1.5rem;
        }

        .card-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
            padding: 1rem 1.25rem;
            border-radius: 0.5rem 0.5rem 0 0 !important;
        }

        .card-header h4 {
            margin: 0;
            color: var(--primary-color);
            font-size: 1.1rem;
            font-weight: 600;
        }

        .image-cropper {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
            padding: 1rem;
            margin-top: 0.5rem;
        }

        .existing-image {
            position: relative;
            display: inline-block;
            margin-right: 10px;
            margin-bottom: 10px;
        }

        .existing-image img {
            width: 60px;
            height: 70px;
            object-fit: cover;
            border-radius: 4px;
            border: 1px solid #dee2e6;
        }

        .existing-image .remove-btn {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #dc3545;
            color: white;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            cursor: pointer;
            border: none;
        }

        .image-preview {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border: 1px solid #ddd;
            border-radius: 4px;
            margin-bottom: 10px;
        }

        /* Mobile Responsive - Adjust for sidebar */
        @media (max-width: 768px) {
            .main-content {
                margin-left: 0;
                padding: 20px 15px;
                margin-top: var(--header-height);
            }

            .content-main {
                padding: 20px;
            }

            .content-header h2 {
                font-size: 24px;
            }
        }

        @media (max-width: 576px) {
            .main-content {
                padding: 15px 10px;
            }

            .content-main {
                padding: 15px;
            }
        }
        .image-cropper {
  width: 100%;
  max-height: 300px;
  overflow: hidden;
}

    </style>
</head>
<body>
    <!-- Main Content - Designed to work with your existing sidebar -->
    <main class="main-content" id="mainContent">
        <section class="content-main">
            <div class="row">
                <div class="col-12">
                    <div class="content-header">
                        <h2 class="content-title">Edit Product</h2>
                    </div>
                </div>
                
                <div class="col-lg-8">
                    <div class="card">
                        <div class="card-body">
                            <form method="post" action="/admin/editProduct/<%=product._id%>" enctype="multipart/form-data" onsubmit="return valideForm()">
                                <!-- Product Name -->
                                <div class="mb-4">
                                    <label for="product_name" class="form-label">Product Name</label>
                                    <input type="text" name="productName" value="<%=product.productName %>" class="form-control" id="product_name">
                                    <div id="productName-error" class="error-message"></div>
                                </div>
                                
                                <!-- Brand and Category Row -->
                                <div class="row">
                                    <div class="col-lg-6 mb-4">
                                        <label class="form-label">Brand</label>
                                        <select class="form-select" name="brand">
                                            <% for(let i=0; i<brand.length; i++) { %>
                                            <option value="<%= brand[i].brandName %>"><%=brand[i].brandName %></option>
                                            <%}%>
                                        </select>
                                        <div id="brand-error" class="error-message"></div>
                                    </div>
                                    <div class="col-lg-6 mb-4">
                                        <label class="form-label">Category</label>
                                        <select class="form-select" name="category">
                                            <% for(let i=0; i<cat.length; i++){ %>
                                            <option value="<%=cat[i].name%> "><%= cat[i].name %></option>
                                            <%}%>
                                        </select>
                                        <div id="category-error" class="error-message"></div>
                                    </div>
                                </div>

                                <!-- Description -->
                                <div class="mb-4">
                                    <label class="form-label">Full description</label>
                                    <input name="descriptionData" value="<%=product.description %>" class="form-control" rows="4" placeholder="Enter product description"></input>
                                    <div id="description-error" class="error-message"></div>
                                </div>

                                <!-- Price and Quantity Row -->
                                <div class="row">
                                    <div class="col-lg-4 mb-4">
                                        <label class="form-label">Regular price</label>
                                        <input placeholder="$" name="regularPrice" type="number" value="<%=product.regularPrice %>" class="form-control">
                                        <div id="regularPrice-error" class="error-message"></div>
                                    </div>
                                    <div class="col-lg-4 mb-4">
                                        <label class="form-label">Sale price</label>
                                        <input name="salePrice" type="number" value="<%= product.salePrice %>" class="form-control">
                                        <div id="salePrice-error" class="error-message"></div>
                                    </div>
                                    <div class="col-lg-4 mb-4">
                                        <label class="form-label">Quantity</label>
                                        <input name="quantity" type="number" value="<%= product.quantity%>" class="form-control">
                                        <div id="quantity-error" class="error-message"></div>
                                    </div>
                                </div>

                                <!-- Color -->
                                <div class="row">
                                    <div class="col-lg-6 mb-4">
                                        <label class="form-label">Color</label>
                                        <input name="color" type="text" value="<%=product.color %>" class="form-control">
                                        <div id="color-error" class="error-message"></div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Image Upload Section -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4>Choose images</h4>
                        </div>
                
                        <div class="card-body">
                            <!-- Existing Images Display -->
                            
                            <div class="mb-4">
                                <label class="form-label">Current Images</label>
                                <div class="d-flex flex-wrap">
                                     <%for(let i=0; i<product.productImage.length; i++){%>
                                    <div class="existing-image">
                                        <input type="hidden" value="<%=product.productImage[i] %>" id="imageDatas">
                                        <img src="/uploads/reimage/<%= product.productImage[i] %>" alt="Product Image">
                                        <button type="button" class="remove-btn" onclick="deleteSingleImage('<%=product.productImage[i] %>','<%=product._id %>')">
                                            <i class="fa fa-times"></i>
                                        </button>
                                    </div>
                                    <%}%>
                                </div>
                            </div>
                            
                            <!-- New Image Upload -->
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Image 1</label>
                                    <div class="mb-2">
                                        <img src="" alt="" id="imgView1" class="image-preview" style="display: none;">
                                    </div>
                                    <input class="form-control" type="file" name="images" id="input1" 
                                           accept="image/png, image/jpeg, image/jpg" 
                                           onchange=" viewImage(event, 1)">
                                    <div class="image-cropper d-none" id="cropper1">
                                        <img src="" id="croppedImg1" alt="">
                                        <div class="mt-2">
                                            <button type="button" id="saveButton1" class="btn btn-sm btn-primary">Save</button>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Image 2</label>
                                    <div class="mb-2">
                                        <img src="" alt="" id="imgView2" class="image-preview" style="display: none;">
                                    </div>
                                    <input class="form-control" type="file" name="images" id="input2" 
                                           accept="image/png, image/jpeg, image/jpg" 
                                           onchange=" viewImage(event, 2)">
                                    <div class="image-cropper d-none" id="cropper2">
                                        <img src="" id="croppedImg2" alt="">
                                        <div class="mt-2">
                                            <button type="button" id="saveButton2" class="btn btn-sm btn-primary">Save</button>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Image 3</label>
                                    <div class="mb-2">
                                        <img src="" alt="" id="imgView3" class="image-preview" style="display: none;">
                                    </div>
                                    <input class="form-control" type="file" name="images" id="input3" 
                                           accept="image/png, image/jpeg, image/jpg" 
                                           onchange=" viewImage(event, 3)">
                                    <div class="image-cropper d-none" id="cropper3">
                                        <img src="" id="croppedImg3" alt="">
                                        <div class="mt-2">
                                            <button type="button" id="saveButton3" class="btn btn-sm btn-primary">Save</button>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Image 4</label>
                                    <div class="mb-2">
                                        <img src="" alt="" id="imgView4" class="image-preview" style="display: none;">
                                    </div>
                                    <input class="form-control" type="file" name="images" id="input4" 
                                           accept="image/png, image/jpeg, image/jpg" 
                                           onchange=" viewImage(event, 4)">
                                    <div class="image-cropper d-none" id="cropper4">
                                        <img src="" id="croppedImg4" alt="">
                                        <div class="mt-2">
                                            <button type="button" id="saveButton4" class="btn btn-sm btn-primary">Save</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div id="images-error" class="error-message"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Update Button -->
            <div class="row">
                <div class="col-12">
                    <div class="d-flex justify-content-end">
                        <button class="btn btn-primary px-4" id="updatebtn" type="button" onclick="validateAndSubmit()">
                            <i class="fas fa-save me-2"></i>Update Product
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/cropperjs/dist/cropper.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://unpkg.com/cropperjs/dist/cropper.min.js"></script>
    
    <script>
        // Image preview functions
        // function viewImage1(event) {
        //     const img = document.getElementById('imgView1');
        //     if (event.target.files && event.target.files[0]) {
        //         img.src = URL.createObjectURL(event.target.files[0]);
        //         img.style.display = 'block';
        //     }
        // }

        // function viewImage2(event) {
        //     const img = document.getElementById('imgView2');
        //     if (event.target.files && event.target.files[0]) {
        //         img.src = URL.createObjectURL(event.target.files[0]);
        //         img.style.display = 'block';
        //     }
        // }

        // function viewImage3(event) {
        //     const img = document.getElementById('imgView3');
        //     if (event.target.files && event.target.files[0]) {
        //         img.src = URL.createObjectURL(event.target.files[0]);
        //         img.style.display = 'block';
        //     }
        // }

        // function viewImage4(event) {
        //     const img = document.getElementById('imgView4');
        //     if (event.target.files && event.target.files[0]) {
        //         img.src = URL.createObjectURL(event.target.files[0]);
        //         img.style.display = 'block';
        //     }
        // }

        // function viewImage(event, index) {
        //     // Your existing cropping logic can be implemented here
        //     console.log('Image selected for cropping:', index);
        // }

        let croppedImagesReady = {
  1: false,
  2: false,
  3: false,
  4: false,
};


  let croppers = {}; // Store cropper instances per image
  function viewImage(event, index) {
    const image = event.target.files[0];
    if (!image) return;

    const imgView = document.getElementById(`imgView${index}`);
    const cropperDiv = document.getElementById(`cropper${index}`);
    const croppedImg = document.getElementById(`croppedImg${index}`);
    const saveBtn = document.getElementById(`saveButton${index}`);

    const reader = new FileReader();
    reader.onload = () => {
      croppedImg.src = reader.result;
      cropperDiv.classList.remove('d-none');

      if (croppers[index]) {
        croppers[index].destroy(); // Destroy old cropper if exists
      }

      croppers[index] = new Cropper(croppedImg, {
        aspectRatio: 1,
        viewMode: 1,
        autoCropArea: 1,
        movable: true,
        zoomable: true,
        scalable: true,
        rotatable: false
      });

  saveBtn.onclick = function () {
  const canvas = croppers[index].getCroppedCanvas();
  canvas.toBlob(blob => {
    const newFile = new File([blob], `cropped_${image.name}`, { type: image.type });
    const dataTransfer = new DataTransfer();
    dataTransfer.items.add(newFile);
    document.getElementById(`input${index}`).files = dataTransfer.files;

    imgView.src = URL.createObjectURL(blob);
    imgView.style.display = 'block';
    cropperDiv.classList.add('d-none');

    croppedImagesReady[index] = true;  // ✅ Mark cropped
  }, image.type);
};

    };
    reader.readAsDataURL(image);
  }



        // Adapt to sidebar toggle (if your sidebar has toggle functionality)
        // This will work with your existing sidebar JavaScript
        document.addEventListener('DOMContentLoaded', function() {
            const mainContent = document.getElementById('mainContent');
            
            // Listen for sidebar toggle events if they exist
            document.addEventListener('sidebarToggle', function(e) {
                if (e.detail && e.detail.collapsed) {
                    mainContent.classList.add('expanded');
                } else {
                    mainContent.classList.remove('expanded');
                }
            });
        });

//validation
function validateAndSubmit() {
  const inputs = [1, 2, 3, 4];
  let anyImageNeedsCropping = false;

  for (let i of inputs) {
    const input = document.getElementById(`input${i}`);
    if (input.files.length > 0 && !croppedImagesReady[i]) {
      anyImageNeedsCropping = true;
      alert(`Please click 'Save' to crop Image ${i} before submitting.`);
      break;
    }
  }

  if (!anyImageNeedsCropping && validateForm()) {
    document.forms[0].submit();
  }
}





function validateForm() {
   let imageDatas = false
           console.log("validate form");
           clearErrorMessages();
           const name = document.getElementsByName('productName')[0].value;
           const description = document.getElementsByName('descriptionData')[0].value;
           const brand = document.getElementsByName('brand')[0].value;
           const price = document.getElementsByName('regularPrice')[0].value;
           const saleprice = document.getElementsByName('salePrice')[0].value;
           const color = document.getElementsByName('color')[0].value;
           const category = document.getElementsByName('category')[0].value;
           const images = document.getElementById('input1')
           const quantity=document.getElementsByName('quantity')
imageDatas = document.getElementById("imageDatas")?.value;
           let isValid = true;    
           if (name.trim() === "") {
   displayErrorMessage('productName-error', 'Please enter a product name.');
   isValid = false;
}
          
           if (description=== '') {
               displayErrorMessage('description-error', 'Please enter a product description.');
               isValid = false;
           } 


           if ( parseInt(quantity) < 0) {
               displayErrorMessage('quantity-error', 'Please enter a valid non-negative quantity.');
               isValid = false;
           }




           if (!/^\d+(\.\d{1,2})?$/.test(price) || parseFloat(price) < 0) {
               displayErrorMessage('regularPrice-error', 'Please enter a valid non-negative price.');
               isValid = false;
           }
          if (!/^\d+(\.\d{1,2})?$/.test(saleprice) || parseFloat(saleprice) < 0) {
               displayErrorMessage('salePrice-error', 'Please enter a valid non-negative price.');
               isValid = false;
           }
          
           if (color.trim() === "") {
               displayErrorMessage('color-error', 'Please enter a color.');
               isValid = false;
           }
           if (!imageDatas && images.files.length === 0) {
               displayErrorMessage("images-error",'Please select an image.');
               isValid = false;
           }
           return isValid;
       }
      
       function displayErrorMessage(elementId, message) {
           var errorElement = document.getElementById(elementId);
           errorElement.innerText = message;
           errorElement.style.display = "block";
       }


       function clearErrorMessages() {
           const errorElements = document.getElementsByClassName('error-message');
           Array.from(errorElements).forEach(element => {
               element.innerText = '';
           });
           const errorMessage = document.getElementById('errorMessage');


       }

       function deleteSingleImage(imageId,productId){
        $.ajax({
            url:'/admin/deleteImage',
            method:'post',
            data:{imageNameToServer:imageId,productIdToServer:productId},
            success:((response)=>{
                if(response.status === true){
                    window.location.reload()
                }
            })
        })
       }

    </script>
</body>
