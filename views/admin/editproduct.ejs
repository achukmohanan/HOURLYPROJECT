<%- include("../../views/partials/admin/sidebar") %>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Product | HOURLY | ADMIN</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">
    
    <style>

        /* Main Content - Adjusted to work with existing sidebar */
        .main-content {
            margin-top: var(--header-height);
            margin-left: var(--sidebar-width);
            padding: 30px;
            transition: margin-left 0.3s ease;
            min-height: calc(100vh - var(--header-height));
        }

        .main-content.expanded {
            margin-left: 0;
        }

        /* Product page specific styles */
        .content-main {
            background: white;
            border-radius: 10px;
            box-shadow: 0 2px 20px rgba(0,0,0,0.08);
            padding: 30px;
            margin-bottom: 20px;
        }

        .content-header h2 {
            color: var(--primary-color);
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 30px;
        }

        .thumbnails-container {
            display: flex;
            overflow-x: auto;
        }

        .thumbnail {
            margin-right: 10px;
        }

        .input-upload {
            position: relative;
        }

        .error-message {
            color: #dc3545;
            display: none;
            font-size: 0.875em;
            margin-top: 0.25rem;
        }

        .form-control, .form-select {
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
            padding: 0.5rem 0.75rem;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--accent-color);
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }

        .btn {
            border-radius: 0.375rem;
            font-weight: 500;
            transition: all 0.15s ease-in-out;
        }

        .btn-primary {
            background-color: var(--accent-color);
            border-color: var(--accent-color);
        }

        .btn-primary:hover {
            background-color: #2980b9;
            border-color: #2980b9;
        }

        .card {
            border: none;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            border-radius: 0.5rem;
            margin-bottom: 1.5rem;
        }

        .card-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
            padding: 1rem 1.25rem;
            border-radius: 0.5rem 0.5rem 0 0 !important;
        }

        .card-header h4 {
            margin: 0;
            color: var(--primary-color);
            font-size: 1.1rem;
            font-weight: 600;
        }

        .image-cropper {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
            padding: 1rem;
            margin-top: 0.5rem;
        }

        .existing-image {
            position: relative;
            display: inline-block;
            margin-right: 10px;
            margin-bottom: 10px;
        }

        .existing-image img {
            width: 60px;
            height: 70px;
            object-fit: cover;
            border-radius: 4px;
            border: 1px solid #dee2e6;
        }

        .existing-image .remove-btn {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #dc3545;
            color: white;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            cursor: pointer;
            border: none;
        }

        .image-preview {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border: 1px solid #ddd;
            border-radius: 4px;
            margin-bottom: 10px;
        }

        /* Mobile Responsive - Adjust for sidebar */
        @media (max-width: 768px) {
            .main-content {
                margin-left: 0;
                padding: 20px 15px;
                margin-top: var(--header-height);
            }

            .content-main {
                padding: 20px;
            }

            .content-header h2 {
                font-size: 24px;
            }
        }

        @media (max-width: 576px) {
            .main-content {
                padding: 15px 10px;
            }

            .content-main {
                padding: 15px;
            }
        }
       .image-cropper {
  width: 100%;
  height: 350px;               /* FIXED view height */
  overflow: hidden;            /* Hide overflow */
  position: relative;
  border: 1px solid #dee2e6;   /* FIXED spacing */
  background: #f8f9fa;
  margin-top: 0.5rem;
  display: flex;
  justify-content: center;
  align-items: center;
}

.image-cropper img {
  max-width: 100%;
  max-height: 100%;
  display: block;
}

    </style>
</head>
<body>
    <!-- Main Content - Designed to work with your existing sidebar -->
    <main class="main-content" id="mainContent">
        <section class="content-main">
            <div class="row">
                <div class="col-12">
                    <div class="content-header">
                        <h2 class="content-title">Edit Product</h2>
                    </div>
                </div>
                
                <div class="col-lg-8">
                    <div class="card">
                        <div class="card-body">
                            <form id="editProductForm">
                                <!-- Product Name -->
                                <div class="mb-4">
                                    <label for="product_name" class="form-label">Product Name</label>
                                    <input type="text" name="productName" value="<%=product.productName %>" class="form-control" id="product_name">
                                    <div id="productName-error" class="error-message"></div>
                                </div>
                                
                                <!-- Brand and Category Row -->
                                <div class="row">
                                    <div class="col-lg-6 mb-4">
                                        <label class="form-label">Brand</label>
                                        <select class="form-select" name="brand">   
                                            <% for(let i=0; i<brand.length; i++) { %>
                                            <option value="<%= brand[i].brandName %>"
                                                <%if(product.brand === brand[i].brandName) { %> selected  <% }   %>>
                                                <%=brand[i].brandName %>
                                            </option>
                                            <%}%>
                                        </select>
                                        <div id="brand-error" class="error-message"></div>
                                    </div>
                                    <div class="col-lg-6 mb-4">
                                        <label class="form-label">Category</label>
                                        <select class="form-select" name="category">
                                            <% for(let i=0; i<cat.length; i++){ %>
                                            <option value="<%=cat[i]._id %>"
                                                <%= (product.category.toString() === cat[i]._id.toString()) ?  'selected' : ''   %>>
                                                <%= cat[i].name %>
                                            </option>
                                            <%}%>
                                        </select>
                                        <div id="category-error" class="error-message"></div>
                                    </div>
                                </div>

                                <!-- Description -->
                                <div class="mb-4">
                                    <label class="form-label">Full description</label>
                                    <input name="description" value="<%=product.description %>" class="form-control" rows="4" placeholder="Enter product description"></input>
                                    <div id="description-error" class="error-message"></div>
                                </div>

                                <!-- Price and Quantity Row -->
                                <div class="row">
                                    <div class="col-lg-4 mb-4">
                                        <label class="form-label">Regular price</label>
                                        <input placeholder="$" name="regularPrice" type="number" value="<%=product.regularPrice %>" class="form-control">
                                        <div id="regularPrice-error" class="error-message"></div>
                                    </div>
                                    <div class="col-lg-4 mb-4">
                                        <label class="form-label">Sale price</label>
                                        <input name="salePrice" type="number" value="<%= product.salePrice %>" class="form-control">
                                        <div id="salePrice-error" class="error-message"></div>
                                    </div>
                                    <div class="col-lg-4 mb-4">
                                        <label class="form-label">Quantity</label>
                                        <input name="quantity" type="number" value="<%= product.quantity%>" class="form-control">
                                        <div id="quantity-error" class="error-message"></div>
                                    </div>
                                </div>

                                <!-- Color -->
                                <div class="row">
                                    <div class="col-lg-6 mb-4">
                                        <label class="form-label">Color</label>
                                        <input name="color" type="text" value="<%=product.color %>" class="form-control">
                                        <div id="color-error" class="error-message"></div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Image Upload Section -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4>Choose images</h4>
                        </div>
                
                        <div class="card-body">
                            <!-- Existing Images Display -->
                            
                            <div class="mb-4">
                                <label class="form-label">Current Images</label>
                                <div class="d-flex flex-wrap">
                                     <%for(let i=0; i<product.productImage.length; i++){%>
                                    <div class="existing-image">
                                        <input type="hidden" value="<%=product.productImage[i] %>" class="imageDatas">
                                        <img src="<%= product.productImage[i] %>" alt="Product Image">
                                        <button type="button" class="remove-btn" onclick="deleteSingleImage('<%=product.productImage[i] %>','<%=product._id %>')">
                                            <i class="fa fa-times"></i>
                                        </button>
                                    </div>
                                    <%}%>
                                </div>
                            </div>
                            
                            <!-- New Image Upload -->
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Image 1</label>
                                    <div class="mb-2">
                                        <img src="" alt="" id="imgView1" class="image-preview" style="display: none;">
                                    </div>
                                    <input class="form-control" type="file" name="images" id="input1" 
                                           accept="image/png, image/jpeg, image/jpg" 
                                           onchange=" viewImage(event, 1)">
                                    <div class="image-cropper d-none" id="cropper1">
                                        <img src="" id="croppedImg1" alt="">
                                        <div class="mt-2">
                                            <button type="button" id="saveButton1" class="btn btn-sm btn-primary">Save</button>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Image 2</label>
                                    <div class="mb-2">
                                        <img src="" alt="" id="imgView2" class="image-preview" style="display: none;">
                                    </div>
                                    <input class="form-control" type="file" name="images" id="input2" 
                                           accept="image/png, image/jpeg, image/jpg" 
                                           onchange=" viewImage(event, 2)">
                                    <div class="image-cropper d-none" id="cropper2">
                                        <img src="" id="croppedImg2" alt="">
                                        <div class="mt-2">
                                            <button type="button" id="saveButton2" class="btn btn-sm btn-primary">Save</button>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Image 3</label>
                                    <div class="mb-2">
                                        <img src="" alt="" id="imgView3" class="image-preview" style="display: none;">
                                    </div>
                                    <input class="form-control" type="file" name="images" id="input3" 
                                           accept="image/png, image/jpeg, image/jpg" 
                                           onchange=" viewImage(event, 3)">
                                    <div class="image-cropper d-none" id="cropper3">
                                        <img src="" id="croppedImg3" alt="">
                                        <div class="mt-2">
                                            <button type="button" id="saveButton3" class="btn btn-sm btn-primary">Save</button>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Image 4</label>
                                    <div class="mb-2">
                                        <img src="" alt="" id="imgView4" class="image-preview" style="display: none;">
                                    </div>
                                    <input class="form-control" type="file" name="images" id="input4" 
                                           accept="image/png, image/jpeg, image/jpg" 
                                           onchange=" viewImage(event, 4)">
                                    <div class="image-cropper d-none" id="cropper4">
                                        <img src="" id="croppedImg4" alt="">
                                        <div class="mt-2">
                                            <button type="button" id="saveButton4" class="btn btn-sm btn-primary">Save</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div id="images-error" class="error-message"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Update Button -->
            <div class="row">
                <div class="col-12">
                    <div class="d-flex justify-content-end">
                        <button class="btn btn-primary px-4" id="updatebtn" type="button" onclick="validateAndSubmit()">
                            <i class="fas fa-save me-2"></i>Update Product
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </main>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
 
    
  <script>
/* ---------- CONFIG ---------- */
// Cloudinary unsigned upload preset + cloud name (already used in your code)
const CLOUDINARY_URL = "https://api.cloudinary.com/v1_1/dbl2eazti/image/upload";
const CLOUDINARY_UPLOAD_PRESET = "hourly";

/* ---------- STATE ---------- */
// For each index we'll store either false or an object { url, public_id }
let croppedImagesReady = {1: false, 2: false, 3: false, 4: false};
let croppers = {}; // cropper instances

/* ---------- cropper flow ---------- */
function viewImage(event, index) {
  const image = event.target.files && event.target.files[0];
  if (!image) return;

  const cropperDiv = document.getElementById(`cropper${index}`);
  const croppedImgEl = document.getElementById(`croppedImg${index}`);
  const imgView = document.getElementById(`imgView${index}`);
  const saveBtn = document.getElementById(`saveButton${index}`);

  const reader = new FileReader();
  reader.onload = () => {
    croppedImgEl.src = reader.result;
    cropperDiv.classList.remove('d-none');

    // destroy previous cropper
    if (croppers[index]) {
      try { croppers[index].destroy(); } catch(e) {}
    }

    // Wait a tiny tick to ensure image is in DOM
    setTimeout(() => {
      croppers[index] = new Cropper(croppedImgEl, {
        aspectRatio: 1,
        viewMode: 1,
        autoCropArea: 1,
        movable: true,
        zoomable: true,
      });
    }, 50);

    // Save handler (async)
    saveBtn.onclick = async function () {
      try {
        const canvas = croppers[index].getCroppedCanvas({
          width: 800, // optional resizing — Cloudinary handles transformations later, adjust if you want
          height: 800,
          imageSmoothingQuality: 'high'
        });

        // Convert to blob
        canvas.toBlob(async (blob) => {
          if (!blob) {
            Swal.fire("Error", "Failed to get cropped image.", "error");
            return;
          }

          // Upload to Cloudinary
          const cloudForm = new FormData();
          cloudForm.append("file", blob);
          cloudForm.append("upload_preset", CLOUDINARY_UPLOAD_PRESET);

          const cloudRes = await fetch(CLOUDINARY_URL, {
            method: "POST",
            body: cloudForm
          });

          const cloudData = await cloudRes.json();

          if (cloudData && cloudData.secure_url) {
            // store both url and public_id for later delete support
            croppedImagesReady[index] = {
              url: cloudData.secure_url,
              public_id: cloudData.public_id
            };

            imgView.src = cloudData.secure_url;
            imgView.style.display = 'block';
            cropperDiv.classList.add('d-none');

            // destroy cropper instance now that upload is done
            try { croppers[index].destroy(); } catch(e){}
            croppers[index] = null;

            console.log("Uploaded to Cloudinary:", cloudData.secure_url);
          } else {
            console.error("Cloudinary upload error", cloudData);
            Swal.fire("Upload failed", "Could not upload image to Cloudinary.", "error");
          }
        }, 'image/jpeg', 0.9); // can change mime and quality
      } catch (err) {
        console.error(err);
        Swal.fire("Error", "Something went wrong while saving the crop.", "error");
      }
    };
  };

  reader.readAsDataURL(image);
}

/* ---------- validation & submit ---------- */
function displayErrorMessage(elementId, message) {
  var errorElement = document.getElementById(elementId);
  if (!errorElement) return;
  errorElement.innerText = message;
  errorElement.style.display = "block";
}

function clearErrorMessages() {
  const errorElements = document.getElementsByClassName('error-message');
  Array.from(errorElements).forEach(element => {
    element.innerText = '';
    element.style.display = 'none';
  });
}

/* Validates fields and ensures cropping/uploading done */
function validateForm() {
  clearErrorMessages();
  const name = document.getElementsByName('productName')[0].value.trim();
  const description = document.getElementsByName('description')[0].value.trim();
  const price = document.getElementsByName('regularPrice')[0].value;
  const saleprice = document.getElementsByName('salePrice')[0].value;
  const color = document.getElementsByName('color')[0].value.trim();
  const quantity = document.getElementsByName('quantity')[0].value;
  const hasExistingImages  = document.querySelectorAll(".imageDatas").length > 0;

  let isValid = true;
  if (!name) {
    displayErrorMessage('productName-error', 'Please enter a product name.');
    isValid = false;
  }
  if (!description) {
    displayErrorMessage('description-error', 'Please enter a product description.');
    isValid = false;
  }
  if (quantity === '' || isNaN(quantity) || parseInt(quantity) < 0) {
    displayErrorMessage('quantity-error', 'Please enter a valid non-negative quantity.');
    isValid = false;
  }
  if (!/^\d+(\.\d{1,2})?$/.test(price) || parseFloat(price) < 0) {
    displayErrorMessage('regularPrice-error', 'Please enter a valid non-negative price.');
    isValid = false;
  }
  if (saleprice !== '' && (!/^\d+(\.\d{1,2})?$/.test(saleprice) || parseFloat(saleprice) < 0)) {
    displayErrorMessage('salePrice-error', 'Please enter a valid non-negative sale price.');
    isValid = false;
  }
  if (!color) {
    displayErrorMessage('color-error', 'Please enter a color.');
    isValid = false;
  }

  // If no existing images and no newly uploaded images -> invalid
  const hasNewImages = Object.values(croppedImagesReady).some(v => v && typeof v === 'object');
  if (!hasExistingImages && !hasNewImages) {
    displayErrorMessage('images-error', 'Please select at least one image.');
    isValid = false;
  }

  return isValid;
}

/* Main submit function */
async function validateAndSubmit() {
  // Check if any selected file is not yet uploaded to Cloudinary
  for (let i = 1; i <= 4; i++) {
    const input = document.getElementById(`input${i}`);
    if (input && input.files.length > 0) {
      // If user selected a file but did not press Save (upload), croppedImagesReady will be false
      if (!croppedImagesReady[i]) {
        Swal.fire("Please crop & save", `Please click Save to crop & upload Image ${i} before submitting.`, "warning");
        return;
      }
    }
  }

  // Validate fields
  if (!validateForm()) return;

  // Build JSON to send
  const body = {
    productId: "<%= product._id %>",
    productName: document.getElementsByName("productName")[0].value.trim(),
    description: document.getElementsByName("description")[0].value.trim(),
    brand: document.getElementsByName("brand")[0].value,
    category: document.getElementsByName("category")[0].value,
    regularPrice: document.getElementsByName("regularPrice")[0].value,
    salePrice: document.getElementsByName("salePrice")[0].value,
    quantity: document.getElementsByName("quantity")[0].value,
    color: document.getElementsByName("color")[0].value.trim(),
    existingImages: [],
    newImages: [] // array of { url, public_id }
  };

  // Existing images (hidden inputs)
  document.querySelectorAll(".imageDatas").forEach(img => {
    body.existingImages.push(img.value);
  });

  // newImages from Cloudinary
  for (let i = 1; i <= 4; i++) {
    if (croppedImagesReady[i] && typeof croppedImagesReady[i] === "object") {
      body.newImages.push(croppedImagesReady[i]);
    }
  }

  try {
    const res = await fetch(`/admin/editProduct/<%= product._id %>`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body)
    });

    const result = await res.json();
    if (result.success) {
      Swal.fire("Updated!", "Product updated successfully!", "success")
        .then(() => window.location.reload())
    } else {
      Swal.fire("Error", result.message || "Something went wrong", "error");
    }
  } catch (err) {
    console.error(err);
    Swal.fire("Error", "Server error occurred.", "error");
  }
}

/* When user clicks delete (existing image), remove from DOM immediately and call delete route.
   This keeps front-end existingImages array clean without a reload. */
function deleteSingleImage(imageUrl, productId) {
  Swal.fire({
    title: "Delete Image?",
    text: "Are you sure you want to delete this image?",
    icon: "warning",
    showCancelButton: true,
    confirmButtonColor: "#d33",
    cancelButtonColor: "#3085d6",
    confirmButtonText: "Yes, delete it!",
    cancelButtonText: "Cancel"
  }).then((result) => {
    if (!result.isConfirmed) return;  // user clicked cancel ❌

    // Remove from DOM immediately
    [...document.querySelectorAll(".existing-image")].forEach(wrapper => {
      const hidden = wrapper.querySelector(".imageDatas");
      if (hidden && hidden.value === imageUrl) wrapper.remove();
    });

    // Call backend
    fetch('/admin/deleteImage', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ imageUrlToDelete: imageUrl, productIdToServer: productId })
    })
    .then(res => res.json())
    .then(res => {
      if (res.success) {
        Swal.fire("Deleted!", "Image removed successfully.", "success");
      } else {
        Swal.fire("Error", res.message || "Could not delete image.", "error");
      }
    })
    .catch(err => {
      console.log("error is in frontend ",err);
      Swal.fire("Error", "Server error while deleting image.", "error");
    });
  });
}

</script>

</body>
