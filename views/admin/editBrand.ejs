<%- include("../../views/partials/admin/sidebar") %>
<head>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css"rel="stylesheet"/>
</head>
    <style>
        /* Remove conflicting body styles */
        .main-content {
            background-color: #f8f9fa;
        }
        
        .brand-container {
            max-width: 1200px;
            margin: 0 auto;
        }
        
        .breadcrumb {
            background-color: transparent;
            padding: 0;
            margin-bottom: 20px;
        }
        
        .form-section {
            background-color: white;
            border-radius: 8px;
            padding: 30px;
            box-shadow: 0 2px 20px rgba(0,0,0,0.08);
        }
        
        .brand-image-preview {
            border: 1px solid #dee2e6;
            border-radius: 4px;
            padding: 20px;
            text-align: center;
            background-color: #fff;
            min-height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .brand-image-preview img {
            max-width: 100%;
            height: auto;
            max-height: 200px;
        }
        
        .form-label {
            font-weight: 600;
            margin-bottom: 10px;
            text-transform: uppercase;
            font-size: 14px;
        }
        
        .file-input-wrapper {
            position: relative;
        }
        
        .file-input-label {
            display: inline-block;
            padding: 8px 16px;
            background-color: #e9ecef;
            border: 1px solid #ced4da;
            border-radius: 4px;
            cursor: pointer;
            margin-right: 10px;
        }
        
        .file-input-label:hover {
            background-color: #dee2e6;
        }
        
        input[type="file"] {
            display: none;
        }
        
        @media (max-width: 768px) {
            .form-section {
                padding: 20px;
            }
            .brand-image-preview {
                margin-top: 20px;
            }
        }
    </style>

    <!-- Sidebar Overlay (Mobile) -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Main Content -->
    <main class="main-content" id="mainContent">
        <div class="brand-container">
            <h2 class="mb-3">Edit Brand</h2>
            
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/admin/brands" class="text-decoration-none">Brand</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Edit Brand</li>
                </ol>
            </nav>

            <div class="form-section">
                <form id="editBrandForm" enctype="multipart/form-data">
                    <div class="row">
                        <div class="col-lg-6 col-md-12 mb-4">
                            <label for="brandName" class="form-label"  >Brand Name</label>
                            <% if(brand){%>
                            <input type="text" class="form-control" id="brandName" value="<%= brand.brandName %>" placeholder="Enter brand name">
                            <% }else{ %>
                                <p class="text-danger">Brand not found</p>
                            <% } %>
                        </div>
                        
                        <div class="col-lg-6 col-md-12 mb-4">
                            <div class="brand-image-preview">
                                <img src="<%=brand.brandImage %>" alt="Brand Image" id="imagePreview">
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 mb-3">
                            <label for="brandImage" class="form-label">Brand Image</label>
                            <div class="file-input-wrapper">
                                <label for="brandImage" class="file-input-label">Choose File</label>
                                <input type="file" id="brandImage" accept="image/*" onchange="previewImage(event)">
                                <span id="fileName" class="text-muted">no file Chosen</span>
                            </div>
                            <p>If you wants to change Brand Name and Image tap the Crop and Upload </p>
                            <button type="button"  id="uploadBtn" class="btn btn-success mt-2">Crop & Upload</button>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <button type="submit"  id="cropBtn" class="btn btn-primary me-2">Save</button>
                            <button type="button" class="btn btn-secondary">Cancel</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
    <script>
        document.getElementById('editBrandForm').addEventListener('submit', (e)=> e.preventDefault());
        let cropper;

        function previewImage(event) {
            const file = event.target.files[0];
            const fileName = document.getElementById('fileName');
            const imagePreview = document.getElementById('imagePreview');
            
            if (!file) return;
                // fileName.textContent = file.name;
                
                const reader = new FileReader();
                reader.onload = function(e) {
                    imagePreview.src = e.target.result;

                     // Destroy old cropper if it exists
                    if(cropper) cropper.destroy();

                    // Wait until image is visible
                    imagePreview.onload = () => {
                        cropper = new Cropper(imagePreview, {
                            aspectRatio: NaN,    
                            viewMode: 2,
                            autoCropArea: 1,
                            dragMode: 'crop',   
                            movable: true,       
                            zoomable: true,     
                            rotatable: true,    
                            scalable: true,   
                            cropBoxResizable: true, 
                            cropBoxMovable: true     
                        });
                        };


                }   
                reader.readAsDataURL(file);
            } 
        

        //

        document.getElementById('uploadBtn').addEventListener('click',async ()=>{
            if(!cropper){
               return Swal.fire({
                    icon:'error',
                    title:'Please Select Image',
                    text:'Please choose an image first!',
                    showConfirmButton:true
                })
            }

            const brandName = document.getElementById('brandName').value.trim();
             if (!brandName) {
                return Swal.fire({
                icon: 'error',
                title: 'Brand Name Required'
                });
            }

              // Get cropped image as blob
              const canvas = cropper.getCroppedCanvas({
                width:500,
                height:500
              })

                // Convert to blob
                canvas.toBlob(async (blob)=>{

                    const formData = new FormData();
                    formData.append('brandImage',blob,'brand.jpg');
                    formData.append('brandName',brandName);
                

                const response = await fetch('/admin/editBrand?id=<%= brand._id %>',{
                    method:'POST',
                    body:formData
                });

                const data = await response.json()

                if(response.ok){
                    Swal.fire({
                        icon:'success',
                        title:'Success',
                        text:data.message ||  'Updated!'
                    }).then(()=>{

                        window.location.reload()
                    })
                    if(data.imageUrl) document.getElementById('imagePreview').src = data.imageUrl;
                }else{
                    Swal.fire({
                        icon:'error',
                        title:'OOPS',
                        text:data.message || 'Something went wrong!'
                    })
                }
                },"image/jpeg");
        });

        //save 
        document.getElementById('cropBtn').addEventListener('click',async()=>{
            const brandName = document.getElementById('brandName').value.trim();
            if(!brandName){
                return Swal.fire({
                    icon:'error',
                    title:'Brand Name Required',

                })
            }

            const formData = new FormData();
            formData.append('brandName', brandName);

             const response = await fetch(`/admin/editBrand?id=<%= brand._id %>`, {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            if (response.ok) {
                Swal.fire({
                icon: 'success',
                title: 'Updated!',
                text: data.message || 'Brand name updated successfully!'
                });
            } else {
                Swal.fire({
                icon: 'error',
                title: 'Oops...',
                text: data.message || 'Something went wrong!'
                });
            }
        })


    </script>
</body>
