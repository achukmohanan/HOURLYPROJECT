<%- include("../../views/partials/admin/sidebar") %>

<!-- Main Content Wrapper -->
<div class="main-content" id="mainContent">
    <!-- Sidebar Overlay for Mobile -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    
    <!-- Page Title -->
    <div class="page-header">
        <h1 class="page-title">Sales Report</h1>
        <nav class="breadcrumb-nav">
            <a href="/admin/dashboard">Dashboard</a> / <span>Sales Report</span>
        </nav>
    </div>

    <!-- Table Controls -->
    <div class="table-controls">
        <div class="controls-left">
            <div class="control-group">
                <label>Sort</label>
                <select class="form-select" id="sortBy">
                    <option value="name">Product Name</option>
                    <option value="price">Price</option>
                    <option value="buyer">Buyer</option>
                    <option value="total">Total</option>
                </select>
            </div>
            
            <div class="control-group">
                <label>By</label>
                <select class="form-select" id="sortOrder">
                    <option value="asc">Ascending</option>
                    <option value="desc">Descending</option>
                </select>
            </div>
            
            <div class="control-group">
                <label>Filter</label>
                <select class="form-select" id="filterCategory">
                    <option value="">All Categories</option>
                    <option value="watch">Watch</option>
                </select>
            </div>
        </div>
        
      <div class="report-controls">
  <label>From</label>
  <input type="date" id="startDate">

  <label>To</label>
  <input type="date" id="endDate">

  <button class="btn btn-primary" id="generateReport">Generate Report</button>
</div>

    </div>

    <div id="reportSummary" class="mt-3" >

    </div>

    <!-- Products Table -->
    <div class="products-table">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Buyer</th>
                    <th>email</th>
                    <th>Product Name</th>
                    <th>Product ID</th>
                    <th>Qty</th>
                    <th>Price</th>
                    <th>paymentMethod</th>
                    
                    <th>couponApplied</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                <% if(orders && orders.length>0){%>
                <% orders.forEach(order => { %>
                   <% order.orderedItems.forEach(item =>{ %>  
                    <tr> 
                <td><%= order.userId?.name %></td>
                <td><%= order.userId?.email %></td>
                <td><%= item.product.productName %></td>
                <td><%= item.product._id %></td>
                <td><%= item.quantity%></td>
                <td><%= item.price%></td>
                <td><%= order.paymentMethod %></td>
               
                <td><%=order.couponApplied %></td>
                <td><%= order.totalPrice%></td>
                </tr> 
                <% }) %>
            <% }) %>
            <%}else{%>
    <tr>
          <td colspan="8" class="text-center">NO SALES</td>
        </tr>
            <%} %>
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="pagination-container">
        <button class="pagination-btn" id="prevBtn" disabled>
            <i class="fas fa-chevron-left"></i>
        </button>
        <button class="pagination-btn active" data-page="1">1</button>
        <!-- <button class="pagination-btn" data-page="2">2</button> -->
        <!-- <button class="pagination-btn" data-page="3">3</button> -->
        <button class="pagination-btn" id="nextBtn">
            <i class="fas fa-chevron-right"></i>
        </button>
    </div>
</div>

<style>
/* Page Header */
.page-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e9ecef;
}

.page-title {
    color: #2c3e50;
    font-size: 28px;
    font-weight: 600;
    margin-bottom: 0.5rem;
}

.breadcrumb-nav {
    color: #6c757d;
    font-size: 14px;
}

.breadcrumb-nav a {
    color: #6c757d;
    text-decoration: none;
}

.breadcrumb-nav a:hover {
    color: #2c3e50;
}

/* Table Controls */
.table-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
    background: #ffffff;
    padding: 1.25rem;
    border-radius: 0.5rem;
    box-shadow: 0 0.125rem 0.625rem rgba(0,0,0,0.1);
    width: 100%;
}

.controls-left {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
}

.control-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.control-group label {
    font-size: 0.875rem;
    font-weight: 500;
    color: #666666;
    min-width: 3.75rem;
    margin-bottom: 0;
}

.form-select {
    font-size: 0.875rem;
    border: 1px solid #dddddd;
    border-radius: 0.3125rem;
    padding: 0.375rem 0.75rem;
    min-width: 7.5rem;
    background-color: #ffffff;
}

.export-btn {
    background: #2c3e50;
    color: #ffffff;
    border: none;
    padding: 0.625rem 1.5625rem;
    border-radius: 0.3125rem;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    letter-spacing: 0.0625rem;
}

.export-btn:hover {
    background: #1d5064;
    transform: translateY(-1px);
}

/* Products Table */
.products-table {
    background: #ffffff;
    border-radius: 0.5rem;
    overflow: hidden;
    box-shadow: 0 0.125rem 0.625rem rgba(0,0,0,0.1);
    margin-bottom: 1.5rem;
    width: 100%;
}

.products-table table {
    width: 100%;
    margin-bottom: 0;
}

.products-table th {
    background-color: #f8f9fa !important;
    color: #333333;
    font-weight: 600;
    font-size: 0.875rem;
    padding: 0.9375rem 0.75rem;
    text-align: left;
    border-bottom: 2px solid #dee2e6;
    white-space: nowrap;
    vertical-align: middle;
}

.products-table td {
    padding: 0.75rem;
    font-size: 0.875rem;
    vertical-align: middle;
    border-bottom: 1px solid #f0f0f0;
}

.products-table tbody tr:hover {
    background-color: #f8f9fa !important;
}

.product-id {
    color: #666666;
    font-family: 'Courier New', monospace;
    font-size: 0.75rem;
}

.price {
    font-weight: 600;
    color: #2c3e50;
}

.category-badge {
    background: #e3f2fd;
    color: #1976d2;
    padding: 0.25rem 0.75rem;
    border-radius: 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
}

.buyer-name {
    font-weight: 500;
    color: #2c3e50;
}

/* Pagination */
.pagination-container {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 1.25rem;
    gap: 0.3125rem;
    background: #ffffff;
    padding: 1.25rem;
    border-radius: 0.5rem;
    box-shadow: 0 0.125rem 0.625rem rgba(0,0,0,0.1);
    width: 100%;
}

.pagination-btn {
    padding: 0.625rem 0.9375rem;
    border: 1px solid #dddddd;
    background: #ffffff;
    color: #333333;
    border-radius: 0.25rem;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 0.875rem;
    min-width: 2.8125rem;
    display: flex;
    align-items: center;
    justify-content: center;
}

.pagination-btn:hover:not(.disabled) {
    background: #f5f5f5;
    border-color: #bbbbbb;
}

.pagination-btn.active {
    background: #2c3e50;
    color: #ffffff;
    border-color: #2c3e50;
}

.pagination-btn.disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

/* Mobile Responsive */
@media (max-width: 768px) {
    .table-controls {
        flex-direction: column;
        align-items: stretch;
    }

    .controls-left {
        justify-content: center;
        margin-bottom: 1rem;
    }

    .products-table {
        overflow-x: auto;
    }

    .products-table table {
        min-width: 56.25rem;
    }

    .control-group {
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .control-group label {
        min-width: auto;
        margin-bottom: 0.25rem;
    }
}
</style>

<script>
document.getElementById('generateReport').addEventListener('click',async()=>{
    const startDate = document.getElementById('startDate').value;
    const endDate = document.getElementById('endDate').value;

    const res = await fetch(`/admin/sales-Report?startDate=${startDate}&endDate=${endDate}`);
        const data = await res.json();

        document.getElementById("reportSummary").innerHTML = `
                <p>Total Sales: ₹${data.totalSales}</p>
                <p>Total Orders: ${data.totalOrders}</p>
                <p>Total Quantity Sold: ${data.totalQuantity}</p>
            `;
})
</script>