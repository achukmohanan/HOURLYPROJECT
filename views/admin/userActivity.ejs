<%- include("../../views/partials/admin/sidebar") %>

    <head>
        <link rel="stylesheet" href="/assets/css/customers.css">
        <style>
            .duration-badge {
                background-color: #e9ecef;
                color: #495057;
                padding: 4px 8px;
                border-radius: 4px;
                font-size: 12px;
                font-weight: 500;
            }

            .status-online {
                width: 10px;
                height: 10px;
                background-color: #28a745;
                border-radius: 50%;
                display: inline-block;
                margin-right: 5px;
            }

            .status-offline {
                width: 10px;
                height: 10px;
                background-color: #dc3545;
                border-radius: 50%;
                display: inline-block;
                margin-right: 5px;
            }
        </style>
    </head>

    <body>

        <!-- Sidebar Overlay for Mobile -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- Main Content -->
        <main class="main-content" id="mainContent">
            <div class="content-header row">
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="content-title card-title">User Activity Log</h2>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th scope="col"><b>User Name</b></th>
                                    <th scope="col"><b>Login Time</b></th>
                                    <th scope="col"><b>Logout Time</b></th>
                                    <th scope="col"><b>Duration</b></th>
                                    <th scope="col"><b>Status</b></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(activities && activities.length> 0) { %>
                                    <% for(let i=0; i < activities.length; i++) { %>
                                        <tr>
                                            <td>
                                                <%= activities[i].name %>
                                            </td>
                                            <td>
                                                <%= activities[i].loginTime ?
                                                    activities[i].loginTime.toLocaleString('en-IN', {
                                                    timeZone: 'Asia/Kolkata' , day: '2-digit' , month: '2-digit' ,
                                                    year: 'numeric' , hour: '2-digit' , minute: '2-digit' ,
                                                    second: '2-digit' , hour12: true }) : 'N/A' %>
                                            </td>
                                            <td>
                                                <%= activities[i].logoutTime ?
                                                    activities[i].logoutTime.toLocaleString('en-IN', {
                                                    timeZone: 'Asia/Kolkata' , day: '2-digit' , month: '2-digit' ,
                                                    year: 'numeric' , hour: '2-digit' , minute: '2-digit' ,
                                                    second: '2-digit' , hour12: true }) : 'Still Logged In' %>
                                            </td>
                                            <td>
                                                <% if(activities[i].duration) { %>
                                                    <span class="duration-badge">
                                                        <% let seconds=activities[i].duration; let h=Math.floor(seconds
                                                            / 3600); let m=Math.floor((seconds % 3600) / 60); let
                                                            s=seconds % 60; let durationStr="" ; if(h> 0) durationStr +=
                                                            h + "h ";
                                                            if(m > 0) durationStr += m + "m ";
                                                            durationStr += s + "s";
                                                            %>
                                                            <%= durationStr %>
                                                    </span>
                                                    <% } else if(!activities[i].logoutTime) { %>
                                                        <span class="text-muted">Active</span>
                                                        <% } else { %>
                                                            <span class="text-muted">N/A</span>
                                                            <% } %>
                                            </td>
                                            <td>
                                                <% if(!activities[i].logoutTime) { %>
                                                    <span class="status-online"></span> Online
                                                    <% } else { %>
                                                        <span class="status-offline"></span> Offline
                                                        <% } %>
                                            </td>
                                        </tr>
                                        <% } %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="5" class="text-center">No activity records found</td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Pagination -->
            <% if(totalPages> 1) { %>
                <div class="container mt-3">
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            <% if(currentPage> 1) { %>
                                <li class="page-item">
                                    <a class="page-link" href="?page=<%= currentPage - 1 %>">Previous</a>
                                </li>
                                <% } %>

                                    <% for(let i=1; i <=totalPages; i++) { %>
                                        <li class="page-item <%= (i === currentPage) ? 'active' : '' %>">
                                            <a class="page-link" href="?page=<%= i %>">
                                                <%= i %>
                                            </a>
                                        </li>
                                        <% } %>

                                            <% if(currentPage < totalPages) { %>
                                                <li class="page-item">
                                                    <a class="page-link" href="?page=<%= currentPage + 1 %>">Next</a>
                                                </li>
                                                <% } %>
                        </ul>
                    </nav>
                </div>
                <% } %>
        </main>

        <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    </body>