<%- include("../../views/partials/user/supportheader") %>
    <title> Add User Address - HOURLY</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet">

    <style>
      .hamburger {
        display: none;
        flex-direction: column;
        cursor: pointer;
      }
      .hamburger span {
        width: 25px;
        height: 3px;
        background-color: white;
        margin: 3px 0;
        transition: 0.3s;
      }
    
      .no-underline {
        text-decoration: none;
      }
      .text-dark {
        color: #333 !important;
      }
      .fw-semibold {
        font-weight: 600;
      }
      .border-3 {
        border-width: 3px !important;
      }
      @media (max-width: 768px) {
       
        .hamburger {
          display: flex;
        }
      }
     

     
    </style>
  </head>
  <body>
  
    <div class="container mt-4">
      <h3 class="mt-3" style="color: #046963; margin-bottom: 70px">
        Create User Address
      </h3>

      <form id="addressForm" class="border-0 p-3" novalidate>
        <div class="row mb-5">
          <div class="form-group2 col-md-4">
            <label class="form-label d-block" ><i class="fas fa-tag me-1"></i>Address Type:</label>
          
            <div class="form-check form-check-inline">
            <input
              type="radio"
              class="form-check-input"
              id="home"
              value="Home"
              name="addressTypeRadio"
              required
            />
            <label  class="form-check-label" for="home">Home</label>
          </div>
           <!-- Work -->
              <div class="form-check form-check-inline">
                <input
                  class="form-check-input  "
                  type="radio"
                  name="addressTypeRadio"
                  value="Work"
                  id="work"
                />
                <label class="form-check-label" for="work">Work</label>
              </div>

              <div class="form-check form-check-inline">
                <input
                  class="form-check-input "
                  type="radio"
                  name="addressTypeRadio"
                  value="Other"
                  id="other"
                />
                <label class="form-check-label" for="other">Other</label>
              </div>

              <input
                  type="text"
                  class="form-control mt-2 d-none"
                  id="otherAddressType"
                  placeholder="(e.g., Hostel, Parents House)"
                />
                <input type="hidden" id="addressType" name="addressType" />
                <div id="addressType-error" class="text-danger mt-1"></div>

         </div>  
          <div class="form-group2 col-md-4">
            <label for="name" class="form-label"><i class="fas fa-user me-1"></i>Name:</label>
            <input
              type="text"
              class="form-control border-3"
              id="name"
              name="name"
              required
            />
          </div>
          <div class="form-group2 col-md-4">
            <label for="pincode" class="form-label"><i class="fas fa-mail-bulk me-1"></i>Pincode:</label>
            <input
              type="number"
              class="form-control border-3"
              id="pincode"
              name="pincode"
              required
            />
          </div>
        </div>
       
        <!-- ------------- -->
        <div class="row mb-3">
          <div class="form-group2 col-md-4">
            <label for="landMark" class="form-label"><i class="fas fa-map-marker-alt me-1"></i>Landmark:</label>
            <input
              type="text"
              class="form-control border-3"
              id="landMark"
              name="landMark"
              required
            />
          </div>
          <div class="form-group2 col-md-4">
            <label for="state" class="form-label"> <i class="fas fa-map me-1"></i>State:</label>
            <input
              type="text"
              class="form-control border-3"
              id="state"
              name="state"
              readonly
            />
          </div>
           <div class="form-group2 col-md-4">
            <label for="city" class="form-label"><i class="fas fa-city me-1"></i>City:</label>
            <input
              type="text"
              class="form-control border-3"
              id="city"
              name="city"
              readonly
            />
          </div>
        </div>
        <div class="row mb-3">
          <div class="form-group2 col-md-4">
            <label for="phone" class="form-label"><i class="fas fa-phone me-1"></i>Phone:</label>
            <input
              type="tel"
              class="form-control border-3"
              id="phone"
              name="phone"
              required
            />
          </div>
          <div class="form-group2 col-md-4">
            <label for="altPhone" class="form-label"><i class="fas fa-phone-alt me-1"></i>Alternate Phone:</label>
            <input
              type="tel"
              class="form-control border-3"
              id="altPhone"
              name="altPhone"
              required
            />
          </div>
        </div>
        <button type="submit" id="submitButton" class="btn btn-primary">
          Submit
        </button>
      </form>
    </div>

  

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>

      const radios = document.querySelectorAll(
          'input[name="addressTypeRadio"]'
        );
        const otherInput = document.getElementById("otherAddressType");
        const hiddenAddressType = document.getElementById("addressType");

        radios.forEach((radio) => {
          radio.addEventListener("change", () => {
            if (radio.value === "Other") {
              otherInput.classList.remove("d-none");
              otherInput.value = "";
              hiddenAddressType.value = "";
            } else {
              otherInput.classList.add("d-none");
              hiddenAddressType.value = radio.value;
            }
          });
        });

        otherInput.addEventListener("input", () => {
          hiddenAddressType.value = otherInput.value.trim();
        });


        //--------
        document.getElementById('pincode').addEventListener('blur',fetchPincode);

        async function fetchPincode (){
          const pincode = document.getElementById('pincode').value.trim()

          if(!/^\d{6}$/.test(pincode)){
            Swal.fire({
              icon:'error',
              title:'Please',
              text:'Please enter a Valid Pincode',
              // showProgressBar:true,
              // timmer:2000
            })
            return;
          }

          try {
            const res = await fetch(`https://api.postalpincode.in/pincode/${pincode}`)

            const data = await res.json();
            console.log("data is ",data);
            if(data[0].Status === "Success"){
              const postOffice = data[0].PostOffice[0];

              document.getElementById('city').value = postOffice.District;
              document.getElementById('state').value = postOffice.State

            }else{
              Swal.fire({
                icon: "error",
                title: "Not Found",
                text: "No location found for this pincode",
              });
               document.getElementById('city').value = ''
              document.getElementById('state').value = ''
            }
            
          } catch (error) {
            console.log("Error in the fetch api -pincode",error)
            Swal.fire({
            icon: "error",
            title: "Error", 
            text: "Unable to fetch location details",
        });
          }
        }

        //
      document
        .getElementById("addressForm")
        .addEventListener("submit", async function (event) {
          event.preventDefault();
          if (!validateForm()) {
            return;
          }
          const addressType = document.getElementById("addressType").value;
          const name = document.getElementById("name").value;
          const city = document.getElementById("city").value;
          const landMark = document.getElementById("landMark").value;
          const state = document.getElementById("state").value;
          const pincode = document.getElementById("pincode").value;
          const phone = document.getElementById("phone").value;
          const altPhone = document.getElementById("altPhone").value;

          const data = await fetch("/addAddress", {
            method: "post",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              addressType,
              name,
              city,
              landMark,
              state,
              pincode,
              phone,
              altPhone,
            }),
          });

          if (data.ok) {
            const response = await data.json();
            Swal.fire({
              icon: "success",
              title: "Success",
              text: response.message,
              timer:2000,
              timerProgressBar:true,
              background:'#e8ffe8'
            }).then(() => {
              window.location.href = "/checkout";
            });
          } else {
            Swal.fire({
              icon: "error",
              title: "Oops...",
              text: "Something went wrong!",
              background:'#e8ffe8'
            });
          }
        });
//validation

    function showError(inputId, message) {
  const input = document.getElementById(inputId);

  if (!input) return;

  let errorDiv = document.getElementById(inputId + "-error");

  // create error div only once
  if (!errorDiv) {
    errorDiv = document.createElement("div");
    errorDiv.id = inputId + "-error";
    errorDiv.className = "text-danger mt-1";
  }

  errorDiv.textContent = message;

  // Special case for hidden input (Address Type)
  if (input.type === "hidden") {
    const container = document.querySelector(
      'input[name="addressTypeRadio"]'
    )?.closest(".form-group2");

    if (container && !errorDiv.parentNode) {
      container.appendChild(errorDiv);
    }
  } else {
    if (!errorDiv.parentNode) {
      input.parentNode.appendChild(errorDiv);
    }
  }
}


      function clearError(inputId) {
        const error = document.getElementById(inputId + "-error");
        if (error) error.remove();
      }


    function validateForm() {
  let isValid = true;

  const fields = [
    "addressType",
    "name",
    "city",
    "landMark",
    "state",
    "pincode",
    "phone",
    "altPhone",
  ];

  // clear all errors first
  fields.forEach(clearError);

  const addressType = document.getElementById("addressType").value.trim();
  const name = document.getElementById("name").value.trim();
  const city = document.getElementById("city").value.trim();
  const landMark = document.getElementById("landMark").value.trim();
  const state = document.getElementById("state").value.trim();
  const pincode = document.getElementById("pincode").value.trim();
  const phone = document.getElementById("phone").value.trim();
  const altPhone = document.getElementById("altPhone").value.trim();

  const namePattern = /^[A-Za-z\s]+$/;
  const pincodePattern = /^\d{6}$/;
  const phonePattern = /^\d{10}$/;

  // REQUIRED CHECK
  if (!addressType) {
    showError("addressType", "Please select address type");
    isValid = false;
  }

  if (!name) {
    showError("name", "Name is required");
    isValid = false;
  } else if (!namePattern.test(name)) {
    showError("name", "Only alphabets and spaces allowed");
    isValid = false;
  }

  if (!city) {
    showError("city", "City is required");
    isValid = false;
  } else if (!namePattern.test(city)) {
    showError("city", "City must contain only letters");
    isValid = false;
  }

  if (!state) {
    showError("state", "State is required");
    isValid = false;
  } else if (!namePattern.test(state)) {
    showError("state", "State must contain only letters");
    isValid = false;
  }

  if (!landMark) {
    showError("landMark", "Landmark is required");
    isValid = false;
  }

  if (!pincode) {
    showError("pincode", "Pincode is required");
    isValid = false;
  } else if (!pincodePattern.test(pincode)) {
    showError("pincode", "Pincode must be 6 digits");
    isValid = false;
  }

  if (!phone) {
    showError("phone", "Phone number is required");
    isValid = false;
  } else if (!phonePattern.test(phone)) {
    showError("phone", "Phone must be 10 digits");
    isValid = false;
  }

  if (!altPhone) {
    showError("altPhone", "Alternate phone is required");
    isValid = false;
  } else if (!phonePattern.test(altPhone)) {
    showError("altPhone", "Alternate phone must be 10 digits");
    isValid = false;
  }

  if (phone && altPhone && phone === altPhone) {
    showError("altPhone", "Phone numbers must be different");
    isValid = false;
  }

  return isValid;
}


     
    </script>
  </body>
</html><%- include("../../views/partials/user/supportfooter") %>
