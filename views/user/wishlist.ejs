 <%- include("../../views/partials/user/supportheader") %>
    <title>HOURLY | WISHLIST</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            background-color: #f5f5f5;
            color: #333;
        }

      
        /* Main Content */
        .main-content {
            max-width: 1200px;
            margin: 70px auto;
            padding: 40px 20px;
        }

        .breadcrumb {
            margin-bottom: 40px;
            font-size: 14px;
            color: #666;
        }

        .breadcrumb a {
            text-decoration: none;
            color: #666;
        }

        .page-title {
            font-size: 32px;
            font-weight: bold;
            margin-bottom: 40px;
            color: #333;
        }

        .cart-container {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 60px;
        }

        /* Cart Items */
        .cart-section h3 {
            font-size: 18px;
            font-weight: normal;
            margin-bottom: 30px;
            color: #333;
        }

        .cart-item {
            display: flex;
            align-items: center;
            padding: 20px 0;
            border-bottom: 1px solid #eee;
        }

        .item-image {
            width: 80px;
            height: 80px;
            background-color: #f0f0f0;
            border-radius: 8px;
            margin-right: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .item-image img {
            width: 60px;
            height: 60px;
            object-fit: contain;
        }

        .item-details {
            flex: 1;
        }

        .item-name {
            font-size: 16px;
            font-weight: normal;
            margin-bottom: 5px;
            color: #333;
        }

        .item-subtitle {
            font-size: 12px;
            color: #999;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .item-price {
            font-size: 16px;
            color: #333;
            margin-right: 20px;
            min-width: 100px;
        }

        .quantity-controls {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-right: 20px;
        }

        .quantity-btn {
            width: 30px;
            height: 30px;
            border: 1px solid #ddd;
            background: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .quantity-btn:hover {
            background: #f5f5f5;
        }

        .quantity {
            width: 40px;
            text-align: center;
            font-size: 14px;
        }

        .remove-btn {
            background: none;
            border: none;
            font-size: 18px;
            cursor: pointer;
            color: #999;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .remove-btn:hover {
            color: #666;
        }

        /* Order Summary */
        .summary-section h3 {
            font-size: 18px;
            font-weight: normal;
            margin-bottom: 30px;
            color: #333;
        }

        .summary-line {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
            font-size: 14px;
        }

        .summary-line.total {
            font-size: 16px;
            font-weight: bold;
            padding-top: 15px;
            border-top: 1px solid #eee;
            margin-top: 20px;
        }

        .checkout-btn {
            width: 100%;
            background-color: #333;
            color: white;
            border: none;
            padding: 15px;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            margin-top: 20px;
        }

        .checkout-btn:hover {
            background-color: #555;
        }

        .continue-shopping {
            text-align: center;
            margin-top: 15px;
        }

        .continue-shopping a {
            color: #666;
            text-decoration: none;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .no-underline {
  text-decoration: none;
}

       
        
    </style>
</head>
<body>
   

    <!-- Main Content -->
    <main class="main-content">
        <div class="breadcrumb">
            <a href="#">Home</a> > Wishlist
        </div>
             <h3 class="text-muted" >Hi <%=user.name %></h3>
        <h1 class="page-title">Your Wishlist</h1>

        <div class="cart-container">
            <!-- Wishlist Items -->
            <div class="cart-section"> 
                <%if(wishlist && wishlist.products.length >0){%>
            <% wishlist.products.forEach(item =>{%> 
                <div class="cart-item">
                    <div class="item-image">
                        <div class="watch-classic">
                           <img src=" <%= item.productId.productImage[0] %>" alt=""></div>
                    </div>
                    
                    <div class="item-details">
                        <div class="item-name"><%= item.productId.productName %></div>
                        <div class="item-subtitle"> </div>  
                    </div>
                    <div class="item-price">
                       <a href="/productDetails?id=<%= item.productId._id %>" class="item-price no-underline">Tap here to see the Price</a> 
                    </div>
                    <!-- <div class="quantity-controls">    
                        <button class="quantity-btn" onclick="updateQuantity('<%= item.productId._id %>', -1)">-</button>
                        <span class="quantity" id="qty-<%= item.productId._id %>"><%=item.quantity %></span>
                        <button class="quantity-btn" onclick="updateQuantity('<%= item.productId._id %>', 1)">+</button>   
                    </div> -->
                    <button class="deletebtn remove-btn" data-productId="<%= item.productId._id %>" type="button" >×</button>
                </div>
                  <%}) %> 
                <%}else{%>
                <div class="d-flex  justify-content-center border p-5">
                    <p>YOUR WISHLIST IS EMPTY!</p>
                </div>
               <%}%> `1
          
             </div>
               

            <!-- Order Summary -->
            <!-- <div class="summary-section">
                <h3>Order Summary</h3>
                 -->
                <!-- <div class="summary-line">
                    <span>Subtotal</span>
                    <span id="subtotal">Rs. 18,15,000</span>
                </div>
                <div class="summary-line">
                    <span>Shipping</span>
                    <span>Free</span>
                </div>
                <div class="summary-line">
                    <span>Tax</span>
                    <span id="tax">Rs. 50,000</span>
                </div>
                <div class="summary-line total">
                    <span>Total</span>
                    <span id="total">Rs. 18,65,000</span>
                </div> -->
                
                <!-- <button class="checkout-btn">CHECKOUT</button>
                
                <div class="continue-shopping">
                    <a href="#">Continue Shopping</a>
                </div>
            </div>
        </div> -->
    </main>
    
</body>
    
