<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hourly Sign Up</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
  <link rel="stylesheet" href="/assets/css/signup.css">
</head>

<body>
  <div class="container">
    <div class="form-box">
      <h2>SIGN UP</h2>
      <p>Please fill in the information below</p>
      <!-- 🔹 Google Login Button -->
      <a class="google-btn" href="/auth/google" style="text-decoration: none;">
        <img src="https://res.cloudinary.com/dbl2eazti/image/upload/v1761223608/google_bixbs6.png" alt="Google icon" />
        Sign up with Google
      </a>
      <form id="signupform" novalidate>
        <div class="form-group">
          <div id="error1" class="error-message"></div>
          <input type="text" id="name" name="name" placeholder="Enter Full Name"    />
        </div>
        <!-- <input type="text" placeholder="Last name" required /> -->
        <div class="form-group">
          <div id="error2" class="error-message"></div>
          <input type="email" id="email" name="email" placeholder="Enter E-mail Address"    />
        </div>
        <div class="form-group">
          <div id="error3" class="error-message"></div>
          <input type="tel" id="phone" name="phone" placeholder="Enter Mobile Number"    />
        </div>
        <div class="form-group">
          <div class="optinal text-muted">(OPTIONAL)</div> 
          <div id="error6" class="error-message"></div>
          <input type="tel" id="referalcode" name="referalcode" placeholder="Referal Code"    />
        </div>

        <div class="form-group">
          <div id="error4" class="error-message"></div>
          <input type="password" id="password" name="password" placeholder="Enter Password"   />
        </div>
        <div class="form-group">
          <div id="error5" class="error-message"></div>
          <input type="password" id="cPassword" name="cPassword" placeholder="Enter Confirm Password"   />
        </div>
        <button type="submit" id="signupBtn" disabled>signup</button>
        <p>already a User? <a href="/login">Login Now</a></p>
      </form>
    </div>

    <div class="image-box">
      <img src="https://res.cloudinary.com/dbl2eazti/image/upload/v1761223625/HourlyYours_axzt7h.png" alt="Watch">
      <!-- <div class="hourly-label">HOURLY</div> -->
    </div>
    <div id="global-spinner" class="loader-overlay hidden">
              <div class="loader">
                  <h1 class="text" >HOURLY WATCHES</h1>
              </div>
          </div>
  </div>
        <script  src="/assets/js/globalSnippper.js" ></script>
  <script>
    const signupBtn = document.getElementById("signupBtn");
    const nameid = document.getElementById('name');
    const emailid = document.getElementById('email');
    const phoneid = document.getElementById('phone');
    const passwordid = document.getElementById('password');
    const cPasswordid = document.getElementById('cPassword');
    const referalcodeid = document.getElementById('referalcode');

    const error1 = document.getElementById('error1');
    const error2 = document.getElementById('error2');
    const error3 = document.getElementById('error3');
    const error4 = document.getElementById('error4');
    const error5 = document.getElementById('error5');

    const signupform = document.getElementById('signupform')

    function markValid(input, errorBox) {
  input.classList.add("valid");
  input.classList.remove("invalid");
  errorBox.style.display = "none";
}
function markInvalid(input, errorBox) {
  input.classList.add("invalid");
  input.classList.remove("valid");
  errorBox.style.display = "block";
}

  function toggleSignupButton() {
  const nameValid = nameValidateChecking();
  const emailValid = emailValidateChecking();
  const phoneValid = phoneValidateChecking();
  const passwordValid = passwordValidateChecking();
  const confirmValid = confirmPasswordChecking();

  if (nameValid && emailValid && phoneValid && passwordValid && confirmValid) {
    signupBtn.disabled = false;
  } else {
    signupBtn.disabled = true;
  }
}

   

   // ---------------------- name validation ----------------------
    function nameValidateChecking() {
      const nameval = nameid.value.trim();
      const namepattern = /^[A-Za-z\s]+$/;

      if (nameval === "") {  
        error1.style.display = "block";
        error1.innerHTML = "Please enter a valid name";
        return false;
      }

      if (!namepattern.test(nameval)) {
        error1.style.display = "block";
        error1.innerHTML = "Name can only contain alphabets & spaces";
        return false;
      }

      
      return true;
    }


   // ---------------------- EMAIL VALIDATION ----------------------
function emailValidateChecking() {
  const emailval = emailid.value.trim().toLowerCase();

  const emailpattern = /^([a-zA-Z0-9._-]+)@([a-zA-Z0-9.-]+)\.[A-Za-z]{2,}$/;

  if (!emailpattern.test(emailval)) {
    error2.style.display = "block";
    error2.innerHTML = "Invalid email format";
    return false;
  }

  error2.style.display = "none";
  return true;
}


    // ---------------------- PHONE VALIDATION ----------------------
function phoneValidateChecking(){
  const phoneval = phoneid.value.trim();
  const onlyNumbers = /^[0-9]{10}$/;

  if (!onlyNumbers.test(phoneval)) {
    error3.style.display = "block";
    error3.innerHTML = "Phone number must be exactly 10 digits";
    return false;
  }

  const invalidNumbers = ["0000000000", "1234567890"];

  if (invalidNumbers.includes(phoneval) || /^(\d)\1{9}$/.test(phoneval)) {
    error3.style.display = "block";
    error3.innerHTML = "Invalid phone number";
    return false;
  }

  error3.style.display = "none";
  return true;
}

   // ---------------------- PASSWORD VALIDATION ----------------------
function passwordValidateChecking() {
  const passwordval = passwordid.value;
  const strongPassword = /^(?=.*[A-Za-z])(?=.*\d)(?=.*[!@#$%^&*]).{8,}$/;

  if (!strongPassword.test(passwordval)) {
    error4.style.display = "block";
    error4.innerHTML = "Password must be 8+ chars, include letters, numbers & special chars like '!@#$%^&*'";
    return false;
  }

  error4.style.display = "none";
  return true;
}


// ---------------------- CONFIRM PASSWORD VALIDATION ----------------------
function confirmPasswordChecking() {  
  if (passwordid.value !== cPasswordid.value) {
    error5.style.display = "block";
    error5.innerHTML = "Passwords do not match";
    return false;
  }

  error5.style.display = "none";
  return true;
}



    nameid.addEventListener("input", () => {
  nameValidateChecking()
    ? markValid(nameid, error1)
    : markInvalid(nameid, error1);

    toggleSignupButton()
});

emailid.addEventListener("input", () => {
  emailValidateChecking()
    ? markValid(emailid, error2)
    : markInvalid(emailid, error2);

    toggleSignupButton()
});

phoneid.addEventListener("input", () => {
  phoneValidateChecking()
    ? markValid(phoneid, error3)
    : markInvalid(phoneid, error3);

    toggleSignupButton()
});

passwordid.addEventListener("input", () => {
  passwordValidateChecking()
    ? markValid(passwordid, error4)
    : markInvalid(passwordid, error4);

  confirmPasswordChecking()
    ? markValid(cPasswordid, error5)
    : markInvalid(cPasswordid, error5);

    toggleSignupButton()
});

cPasswordid.addEventListener("input", () => {
  confirmPasswordChecking()
    ? markValid(cPasswordid, error5)
    : markInvalid(cPasswordid, error5);

    toggleSignupButton()
});

      signupform.addEventListener('submit', async function (e) {
        e.preventDefault();

      const nameValid = nameValidateChecking();
      const emailValid = emailValidateChecking();
      const phoneValid = phoneValidateChecking();
      const passwordValid = passwordValidateChecking();
      const confirmValid = confirmPasswordChecking();
  


        if (nameValid && emailValid && phoneValid && passwordValid && confirmValid) {
     
        const formData = {
        name: nameid.value,
        email: emailid.value,
        phone: phoneid.value,
        password: passwordid.value, 
        cPassword: cPasswordid.value,
        referalcode: referalcodeid.value
    };
        
      

        try {
          const res = await fetch('/signup',{
            method:'POST',
            headers:{
              'Content-Type':'application/json'
            },
            body:JSON.stringify(formData)
          });
          
          const data = await res.json();
 
          if(data.success){
          Swal.fire({
          icon: 'success',
          title: 'Success',
          text: data.message,
          timer:2000,
          timerProgressBar:true,
          showConfirmButton:false,
          background:'#e8ffe8'

        }).then(() => {
          window.location.href = '/confirmwithotp';
        });
          }else{
            Swal.fire({
          icon: 'error',
          title: 'Error',
          text: data.message,
          showConfirmButton:true,
          background:'#e8ffe8'
        });
          }
        } catch (error) {
          console.log("error in the fetch ",error);
          
           Swal.fire({
        icon: 'error',
        title: 'Error',
        text: 'Something went wrong. Please try again later.',
        showConfirmButton:true,
        background:'#e8ffe8'
      });
        }
      }else{
        Swal.fire({
          icon:'error',
          title:'OOPS',
          text:"Please fill all fields correctly!",
          showConfirmButton:true,
          background:'#e8ffe8'
        })
      }
      });
    


  </script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</body>

</html>