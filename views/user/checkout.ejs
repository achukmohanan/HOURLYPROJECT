<%- include('../../views/partials/user/supportheader')%>
<link rel="stylesheet" href="/assets/css/checkout.css">
    <title>Checkout - HOURLY</title>

</head>
<body>
    <main class="main-content">
        <div class="checkout-section">
            <h1><i class="bi bi-bag-check"></i> Checkout</h1>
            <div class="breadcrumb">
                <span class="breadcrumb-item ">Cart</span>
                <span class="breadcrumb-item active" >Checkout</span>
                <span class="breadcrumb-item">Payment</span>
            </div>


            <div class="form-section ">
                <h2 class="section-title"><i class="bi bi-geo-alt"></i> Select Address</h2>
                 
                <div >
                    <form id="checkoutform" action="/payment" method="post">
                    <select name="addressId" id="addressSelect">
                        <% if(addressList.length > 0){ %>
                        <% addressList[0].address.forEach((addr,index)=> {%>
                            <option value="<%=index %>">
                            <%=addr.addressType %> -<%= addr.city %> - <%= addr.pincode %> 
                            </option>
                            <%}) %>
                            <%}else{%>
                                <option value="">No Address Found</option>
                                <%}%>
                    </select>
                    <div id="addressmessage" style="color:red; margin-top: 5px; " ></div>
                </div>

               
               <a href="/addAddress-checkout" class="btn btn-primary m-4" type="button">Add New Address</a>
            </div>

               <div class="form-section mt-5">
                    
                     <h5> <i class="bi bi-credit-card-2-back-fill"></i> Available Coupons</h5>

                    <% if (coupons.length > 0) { %>
                    <div class="d-flex flex-wrap gap-3">
                        <% coupons.slice(0,5).forEach(coupon => { 
                        let isExpired = new Date(coupon.expireOn) < new Date();
                        %>
                        <div class="coupon-card <%= isExpired ? 'expired-coupon' : '' %>">
                            <p class="coupon-code"><%= coupon.code %> <i class="bi bi-copy" style="cursor: pointer; color: aliceblue;" onclick="copyClip('<%= coupon.code %>')"></i></p>
                            
                            <small>Type : <%= coupon.purpose %></small><br>
                            <small><%= coupon.description %></small><br>
                            <small>MIN Purchase :<%= coupon.minPurchase.toLocaleString('en-IN',{style:'currency',currency:'INR'}) %></small><br>
                            <small>Offer <%= coupon.discountValue %>% OFF</small><br>
                            <small>Max Discount :₹<%= coupon.maxDiscount %></small><br>
                            <small>Expires: <%= coupon.expireOn.toLocaleString('en-IN') %></small>
                        </div>
                        <% }) %>
                    </div>
                    <% } else { %>
                    <p>No coupons available right now.</p>
                    <% } %>
               </div>

               <div class="form-section mt-5">
                <h3> <i class="bi bi-wallet-fill"></i> WALLET</h3>
                <p>Available Balace</p>
                <h1 class="text-info"><%= user.wallet.toLocaleString('en-IN',{style:'currency',currency:'INR'}) %></h1>
               </div>

    
        </div>
        <div class="summary-section  ">
                <h3 class="text-dark fw-bold" ><i class="bi bi-border-width"></i> Order Summary</h3>
                 <% cart.items.forEach(item=>{%>
                <div class="summary-line">
                    <span>Product :<%= item.productId.productName %></span>

                    <span id="price-<%= item.productId._id %>"> ₹ <%= (item.productId.salePrice * item.quantity).toLocaleString('en-IN')  %></span>
                </div>
                <%})%>
                <div class="summary-line"> 
                    <span>Shipping</span>
                    <span style="color: #0bdb15;">Free</span>
                </div>
                <div class="summary-line" id="discountRow" style="<%= discount > 0 ? 'display:flex' : 'display:none' %>">
                    <span>Discount</span>
                        <span class="text-danger" id="discountAmount">- ₹<%= discount ? discount.toLocaleString('en-IN') : "" %></span>
                    </div>
             
            <h5>Apply Coupon</h5>
                
                    <input 
                        type="text" 
                        class="form-control me-2 mb-2" 
                        name="couponCode"
                        id="couponCode"
                        placeholder="Enter coupon code"
                        value="<%= cart.coupon ? cart.coupon.code : '' %>"
                    >   
                    <input type="hidden" name="discount" id="discountInput" value="0 ">
                    <input type="hidden" name="appliedCoupon" id="appliedCoupon" value="<%= cart.coupon ? cart.coupon.code : '' %>">

                    <button type="button" class="btn btn-primary" id="applyCouponBtn">Apply</button>
                    <button type="button" class="btn btn-danger" id="removeCouponBtn" style="display: none;">Remove</button>
                    <div id="couponMessage"></div>

                <hr>
                <div class="summary-line ">
                    <span class="fw-bold">Total</span>
                    <span  id="total" 
                     data-coupon="<%= cart.coupon ? cart.coupon.code : '' %>"
                     data-original-total="<%= finalAmount %>"
                     data-discount="<%= discount %>"
                     > ₹ <%= finalAmount.toLocaleString('en-IN') %></span>
                </div>
                
                <button type="submit" class="btn checkout-btn"><i class="bi bi-currency-rupee"></i> Proceed to Pay </button>
                
                <div class="continue-shopping">
                    <a href="/cart"><i class="bi bi-arrow-left"></i>  Back to Cart</a>
                </div>
            </div>
             </form>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded',()=>{
            
            const addressSelect = document.getElementById('addressSelect');
            const errorAddress = document.getElementById('addressmessage')
            const checkoutForm = document.getElementById('checkoutform')

            checkoutForm.addEventListener('submit',function(e){
            if(!addressSelect.value){
                e.preventDefault()
                errorAddress.textContent = "⚠️ Please select an address before proceeding.";
            }
        })

        const couponMsg = document.getElementById('couponMessage');
        const discountInput = document.getElementById('discountInput');
        const removeCouponBtn = document.getElementById('removeCouponBtn');
        const totalEl = document.getElementById('total');
        const applyBtn = document.getElementById('applyCouponBtn');
        const couponCodeInput = document.getElementById('couponCode');
        let appliedDiscount = 0;

        const discount = Number(totalEl.dataset.discount);
const couponCode = totalEl.dataset.coupon;

if (discount > 0 && couponCode) {
  // show discount row
  document.getElementById('discountRow').style.display = 'flex';

  // show discount amount
  document.getElementById('discountAmount').innerText =
    `- ₹${discount.toLocaleString('en-IN')}`;

  // restore coupon code
  couponCodeInput.value = couponCode;

  // 🔥 THIS IS WHAT YOU MISSED
  removeCouponBtn.style.display = 'inline-block';
  applyBtn.style.display = 'none';

  // sync hidden input (optional)
  discountInput.value = discount;
}

        
        

        applyBtn.addEventListener('click',async ()=>{
            const code = couponCodeInput.value.trim();
            if(!code){
                couponMsg.style.color = 'grey';
                couponMsg.innerText = 'No Coupon Applied'
                return  
            }
            try {
                const response = await fetch('/apply-coupon', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code })
                });

                const data = await response.json();

                if(data.success){
                    couponMsg.style.color = 'green';
                    couponMsg.innerText = data.message 

                    document.getElementById('discountRow').style.display = 'flex';
                    document.getElementById('discountAmount').innerText =
                     `- ₹${data.discount.toLocaleString('en-IN')}`;

                     document.getElementById('total').innerText =
                    `₹ ${data.finalAmount.toLocaleString('en-IN')}`;

                    document.getElementById('discountInput').value = data.discount;
                    
                    document.getElementById('appliedCoupon').value = code;
                    removeCouponBtn.style.display = 'inline-block';
                }else{
                    couponMsg.style.color='red',
                    couponMsg.innerText = data.message
                }
            } catch (error) {
                
                console.error("errror in the apply coupon",error);
                 couponMsg.style.color = 'red';
                couponMsg.innerText = 'Something went wrong!';
            }
        })  
        
        //remove 
        removeCouponBtn.addEventListener('click',async()=>{
            discountInput.value = 0;
            document.getElementById('couponCode').value = "";
            

            couponMsg.style.color = 'grey';
            couponMsg.innerText = "Coupon Removed";

            removeCouponBtn.style.display = 'none'
            applyBtn.style.display = 'inline-block'
            discountAmount.innerText = 0
            await fetch('/remove-coupon', { method: 'POST' });
            window.location.reload()
        })
})


        function copyClip(code){
            navigator.clipboard.writeText(code)
            .then(()=>{
                Swal.fire({
                    icon: 'success',
                    title: `Copied ${code}!`,
                    toast: true,
                    position: 'top',
                    background: '#e8ffe8',
                    color: '#0f7b0f',
                    timer: 1800,
                    timerProgressBar: true,
                    showConfirmButton: false,
                    background:'#e8ffe8'
            });

            })
            .catch(err=>{
                console.log("errror in the checkout copy clip",err)
                Swal.fire({
                    icon:'error',
                    title:'Failed to Copy',
                    background:'#e8ffe8',
                    timer:1000,
                    timerProgressBar:true
                })
            })

        }
      
    </script>
</body>
<%- include("../../views/partials/user/supportfooter") %>