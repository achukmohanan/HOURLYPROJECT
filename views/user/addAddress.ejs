 <%- include("../../views/partials/user/supportheader") %>
    <title>Create User Address - HOURLY</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <style>
      
      @media (max-width: 768px) {
        .nav-links {
          display: none;
        }
      }
    
    </style>
  </head>
  <body>
    
    <div class="container mt-4">
      <h3 class="mt-3" style="color: #046963; margin-bottom: 70px">
        Create User Address
      </h3>

      <form id="addressForm" class="p-3" novalidate>
        <div class="row mb-5">
          
          <div class="form-group2 col-md-4  ">
            <label   class="form-label  d-block"><i class="fas fa-tag me-1"></i>Address Type:</label>
            
            
            <div class="form-check form-check-inline">
            <input
              type="radio"
              class="form-check-input"
              
              name="addressType"
              id="home"
              value="Home"
              required
            />
            <label class="form-check-label" for="home">Home</label>
            </div>

             <div class="form-check form-check-inline">
              <input
                class="form-check-input"
                type="radio"
                name="addressType"
                id="work"
                value="Work"
              />
              <label class="form-check-label" for="work">Work</label>
            </div>

            <div class="form-check form-check-inline">
              <input
                class="form-check-input"
                type="radio"
                name="addressType"
                id="other"
                value="Other"
              />
              <label class="form-check-label" for="other">Other</label>
            </div>

                    <input
                  type="text"
                  class="form-control mt-2 d-none"
                  id="customAddressType"
                  name="customAddressType"
                  placeholder="Enter address type (e.g., Hostel, Parents House)"
                />
          </div>
          <div class="form-group2 col-md-4 " >
            <label for="name" class="form-label"><i class="fas fa-user me-1"></i>Name:</label>
            <input
              type="text"
              class="form-control border-3"
              id="name"
              name="name"
              required
            />
          </div>

          <div class="form-group2 col-md-4">
            <label for="pincode" class="form-label"><i class="fas fa-mail-bulk me-1"></i>Pincode:</label>
            <input
              type="number"
              class="form-control border-3"
              id="pincode"
              name="pincode"
              required
            />
          </div>
        </div>
        <div class="row mb-3">
          <div class="form-group2 col-md-4">
            <label for="landMark" class="form-label"><i class="fas fa-map-marker-alt me-1"></i>Landmark:</label>
            <input
              type="text"
              class="form-control border-3"
              id="landMark"
              name="landMark"
              required
            />
          </div>
          <div class="form-group2 col-md-4">
            <label for="state" class="form-label"> <i class="fas fa-map me-1"></i>State:</label>
            <input
              type="text"
              class="form-control border-3"
              id="state"
              name="state"
              readonly
            />
          </div>
          <div class="form-group2 col-md-4">
            <label for="city" class="form-label"><i class="fas fa-city me-1"></i>City:</label>
            <input
              type="text"
              class="form-control border-3"
              id="city"
              name="city"
              readonly
            />
          </div>
        </div>
        <div class="row mb-3">
          <div class="form-group2 col-md-4">
            <label for="phone" class="form-label"><i class="fas fa-phone me-1"></i>Phone:</label>
            <input
              type="tel"
              class="form-control border-3"
              id="phone"
              name="phone"
              required
            />
          </div>
          <div class="form-group2 col-md-4">
            <label for="altPhone" class="form-label"><i class="fas fa-phone-alt me-1"></i>Alternate Phone:</label>
            <input
              type="tel"
              class="form-control border-3"
              id="altPhone"
              name="altPhone"
              required
            />
          </div>
        </div>
        <button type="submit" id="submitButton" class="btn btn-primary">
          Submit
        </button>
      </form>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>

       const radios = document.querySelectorAll('input[name="addressType"]');
       const customInput = document.getElementById("customAddressType");

  radios.forEach(radio => {
    radio.addEventListener("change", () => {
      if (radio.value === "Other") {
        customInput.classList.remove("d-none");
        customInput.required = true;
      } else {
        customInput.classList.add("d-none");
        customInput.required = false;
        customInput.value = "";
      }
    });
  });
    
    document.getElementById('pincode').addEventListener('change',fetchLocationFromPincode)

    async function fetchLocationFromPincode() {
     
      const pincode = document.getElementById('pincode').value.trim();

      if(!/^\d{6}$/.test(pincode)){
         showError("pincode", "Please enter a valid 6-digit pincode");
        return;
      }
      try {
        const res = await fetch(`https://api.postalpincode.in/pincode/${pincode}`);
       
        const data = await res.json();
        console.log("data is",data)
       if(data[0].Status === 'Success'){
        const postOffice = data[0].PostOffice[0];

        document.getElementById('city').value = postOffice.District;
        document.getElementById('state').value = postOffice.State
       }else{
         Swal.fire({
            icon: "error",
            title: "Not Found",
            text: "No location found for this pincode",
          });

            document.getElementById("city").value = "";
            document.getElementById("state").value = "";
       }
      } catch (error) {
        console.error("errror in the fetch api of pincode",error)
         Swal.fire({
          icon: "error",
          title: "Error", 
          text: "Unable to fetch location details",
        });
      }
    }
    
    document
        .getElementById("addressForm")
        .addEventListener("submit", async function (event) {
          event.preventDefault();
          if (!validateForm()) {
            return;
          }
         const selectedAddressType = document.querySelector('input[name="addressType"]:checked')

         const addressType =selectedAddressType.value === "Other" ? document.getElementById("customAddressType").value.trim() : selectedAddressType.value;
          const name = document.getElementById("name").value;
          const city = document.getElementById("city").value;
          const landMark = document.getElementById("landMark").value;
          const state = document.getElementById("state").value;
          const pincode = document.getElementById("pincode").value;
          const phone = document.getElementById("phone").value;
          const altPhone = document.getElementById("altPhone").value;

          const data = await fetch("/addAddress", {
            method: "post",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              addressType,
              name,
              city,
              landMark,
              state,
              pincode,
              phone,
              altPhone,
            }),
          });

          if (data.ok) {
            const response = await data.json();
            Swal.fire({
              icon: "success",
              title: "Success",
              text: response.message,
            }).then(() => {
              window.location.href = "/account";
            });
          } else {
            Swal.fire({
              icon: "error",
              title: "Oops...",
              text: "Something went wrong!",
            });
          }
        });

        //pincode
   
    

      function validateForm() {
        let isValid = true;
         clearAllErrors()
   
       const selectedAddressType = document.querySelector('input[name="addressType"]:checked');

       if (!selectedAddressType) {
          showError("home", "Address type is required");
          isValid = false;
        } else if (
          selectedAddressType.value === "Other" &&
          !document.getElementById("customAddressType").value.trim()
        ) {
          showError("customAddressType", "Please enter address type");
          isValid = false;
        }

        const name = document.getElementById("name").value.trim();
        const city = document.getElementById("city").value.trim();
        const landMark = document.getElementById("landMark").value.trim();
        const state = document.getElementById("state").value.trim();
        const pincode = document.getElementById("pincode").value.trim();
        const phone = document.getElementById("phone").value.trim();
        const altPhone = document.getElementById("altPhone").value.trim();

        const namePattern = /^[A-Za-z\s]+$/;
        const pincodePattern = /^\d{6}$/;
        const phonePattern = /^\d{10}$/;

       
        if (!name) {
          showError("name", "Name is required");
          isValid = false;
        }else if (!namePattern.test(name)) {
          showError("name", "Only alphabets and spaces allowed");
          isValid = false;
        }

        if (!landMark) {
        showError("landMark", "Landmark is required");
        isValid = false;
      }

      if (!pincode) {
        showError("pincode", "Pincode is required");
        isValid = false;
      } else if (!pincodePattern.test(pincode)) {
        showError("pincode", "Pincode must be 6 digits");
        isValid = false;
      }

       if (!city) {
        showError("city", "City is required");
        isValid = false;
      } else if (!namePattern.test(city)) {
        showError("city", "City must contain only letters");
        isValid = false;
      }

      if (!state) {
        showError("state", "State is required");
        isValid = false;
      } else if (!namePattern.test(state)) {
        showError("state", "State must contain only letters");
        isValid = false;
      }

      if (!phone) {
        showError("phone", "Phone number is required");
        isValid = false;
      } else if (!phonePattern.test(phone)) {
        showError("phone", "Phone must be 10 digits");
        isValid = false;
      }

      if (!altPhone) {
          showError("altPhone", "Alternate phone is required");
          isValid = false;
        } else if (!phonePattern.test(altPhone)) {
          showError("altPhone", "Alternate phone must be 10 digits");
          isValid = false;
        }

        if (phone && altPhone && phone === altPhone) {
        showError("altPhone", "Phone numbers must be different");
        isValid = false;
      }
        return isValid;
      }

      function showError(field, message) {
         clearError(field);
          const input = document.getElementById(field);
          const errorDiv = document.createElement("div");

          errorDiv.className = "text-danger mt-1";
          errorDiv.id = field + "-error";
          errorDiv.innerText = message;
          input.parentNode.appendChild(errorDiv);
      }

      function clearError(field) {
      const error = document.getElementById(field + "-error");
      if (error) error.remove();
      }

     function clearAllErrors() {
      document.querySelectorAll(".text-danger").forEach(el => el.remove());
    }
    </script>
  </body>
<%- include("../../views/partials/user/supportfooter") %>
