<section class="py-0 bg-dark" id="header">
  
  <div class="bg-holder" style="background-image:url('https://res.cloudinary.com/dbl2eazti/image/upload/v1761586152/asset-439241182516187140_tzbwy4.png'); background-position: center; background-size: cover; background-repeat: no-repeat; width: 100%;">
  </div>
  <!--/.bg-holder-->

  <div class="container">
    <div class="row align-items-center min-vh-75 min-vh-xl-100">
      <div class="col-md-8 col-lg-6 text-md-start text-center">
        <h1 class="display-1 lh-sm text-uppercase " style="background: linear-gradient(180deg, #ffffff 40%, #c10e0e 50%, #ffffff 40%);
         -webkit-background-clip: text;
         -webkit-text-fill-color: transparent;
         font-weight: 700;
         text-shadow: 2px 2px 6px rgba(0, 0, 0, 0.4);">Where  <br class="d-none d-xxl-block" />Time Meets Style...</h1>
        <!-- <div class="pt-4"><a class="btn btn-sm btn-outline-primary me-3" href="#">DESIGN &amp; ORDER</a><a class="btn btn-sm btn-outline-primary" href="#">REQUEST VIRTUAL</a></div> -->
      </div>
    </div>
  </div>
</section>
     <section class="bg py-8 pt-0" id="store">      
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-10">
        <h3 class="p-4 text-dark d-flex justify-content-center m-3">TRENDING BRANDS</h3>

        <div class="row g-5 px-3 mt-2">
          <% if (brand) { %>
            <% for (let i = 0; i < brand.length; i++) { %>
              <div class="col-6 col-sm-4 col-md-3 col-lg-2 d-flex justify-content-center ">
                <a href="/shop?brand=<%=brand[i].brandName %>">
                <div class="image-container text-center border border-2 p-3 ">
                  <img class="image-containerhome " src="<%= brand[i].brandImage %>" alt="">
                  <h6 class="text-light mt-2 "><%= brand[i].brandName %></h6>
                </div>  
                </a>
              </div>
              
            <% } %>
          <% } %>
        </div>

      </div>
    </div>
  </div>
</section>



<section class="py-6 bg-opacity-50 bg-light">
  <div class="container">
    <!-- <div class=""> -->
      <div class="col-12 text-center mb-5">
        <h5 class="fs-3 fs-lg-5 lh-sm mb-3 text-dark text-uppercase">Our Products</h5>
        <p class="text-dark">Discover our latest collection of premium timepieces</p>
      </div>
    <!-- </div> -->
    
    <div class="row   ">
      <% if(products && products.length > 0) { %>
        <% for(let i=0; i<products.length; i++) {   %>
          <div class="col-lg-3 col-md-4 col-sm-6 col-12 homeproduct g-3   ">
            <div class="product-cart-wrap h-100">
              
              <div class="product-img-action-wrap">
                
                <div class="product-img">
                  

                  <a href="/productDetails?id=<%=products[i]._id %>">
                 <% if(products[i].productOffer){%>
                    <div class="offer-badge1 "><%= products[i].productOffer %>% OFF</div>
                   <% } %>
                    <img class="default-img img-fluid rounded-3 shadow-lg" 
                         src="<%= products[i].productImage[0]%>" 
                         alt="<%=products[i].productName %>"
                         loading="lazy">
                  </a> 
                    <button class="wishlist1-btn btn" onclick="addToWishlist('<%= products[i]._id%>')">❤️</button>
                </div>
              
               
              </div>
              
              <div class="product-content-wrap">
                <div class="product-info">
                  
                  <h5 class="product-name text-dark text-center"><%=products[i].productName %></h5>
                  <div class="product-price">
                    <h5 class="price text-dark d-flex justify-content-center" >₹  <%=products[i].salePrice.toLocaleString('en-IN') %></h5>
                    
                    <% if(products[i].regularPrice && products[i].regularPrice > products[i].salePrice ) { %>
                      <span class="old-price text-muted text-decoration-line-through d-flex justify-content-center">
                       ₹  <%=products[i].regularPrice.toLocaleString('en-IN') %>
                      </span>
                    <% } %>
                  </div>
                </div>
                
                <div class="product-actions mt-3  d-flex justify-content-center">
                  
                    <button class="btn btn-primary addtocart" data-productId="<%= products[i]._id %>" type="button">
                    <i class="bi bi-cart-plus  "></i> Cart          
                  </button>
                  <button class="btn btn-primary buy mx-1" type="button">
                    <a href="/productDetails?id=<%=products[i]._id %> " class="text-light"><i class="bi bi-lightning-charge-fill"></i>BUY</a>
                  </button>
                </div>  
                
              </div>
            </div>
          </div>
        <% } %>
      <% } else { %>
        <div class="col-12">
          <div class="text-center py-5">
            <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">No products available</h4>
            <p class="text-muted">Check back soon for new arrivals!</p>
          </div>
        </div>
      <% } %>
    </div>
    
    <!-- View All Products Button -->
    <% if(products && products.length > 0) { %>
      <div class="row mt-5">
        <div class="col-12 text-center">
          <a href="/shop" class="btn btn-outline-primary btn-lg">
            View All Products <i class="fas fa-arrow-right ms-2"></i>
          </a>
        </div>
      </div>
    <% } %>
  </div>
</section>





