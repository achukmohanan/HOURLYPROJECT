<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Password</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    <!-- Custom CSS -->
    <style>
        body {
             background: linear-gradient(135deg, #2c3e50 40%, #34495e 50%);
        }
        .content-main {
            min-height: calc(100vh - 0px);
            display: flex;
            align-items: center;
        }
        .card-login {
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        .left-section {
            flex: 1 1 300px;
            padding: 30px;
        }
        .right-section {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            flex: 1 1 300px;
            padding: 30px;
        }
        .password-wrapper {
            position: relative;
            width: 100%;
        }
        .password-input {
        position: relative;
        }
          .password-input input {
        width: 100%;
        padding-right: 40px;
         }
      .toggle-eye {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        font-size: 18px;
        user-select: none;
         opacity: 0.6;
    }
    .toggle-eye:hover {
  opacity: 1;
}
    .password-error {
    font-size: 13px;
    margin-top: 4px;
}
        @media (max-width: 768px) {
            .left-section, .right-section {
                flex: 1 1 100%;
                padding: 20px;
            }
        }
  .resetdiv{
    background: #f4f4f6
    ;
  }
  .white-space{
    white-space: nowrap;
  }
.loader-overlay {
    position: fixed;
    inset: 0;
    background: rgba(102, 99, 99, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
}

.hidden {
    display: none;
}

.loader {
    text-align: center;
}

.text{
    font-size: 42px;
  font-weight: 600;
  font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
  letter-spacing: 2px;
  background: linear-gradient(
    90deg,
    #000000 40%,
    #f5c16c 50%,
    #000000 75%
  );
  background-size: 200% auto;
  color: transparent;
  background-clip: text;
  -webkit-background-clip: text;
  animation: shimmer 1.5s infinite linear;
}
.password-error {
    font-size: 13px;
    margin-top: 4px;
}

@keyframes shimmer{
      0% {
    background-position: 200% center;
  }
    100% {
    background-position: -200% center;
  }
}
    </style>
</head>
<body>
    <!-- Main Content -->
    <section class="content-main mt-80 mb-80">
        <div class="card mx-auto card-login" style="max-width: 800px;">
            <div class="card-body p-5 ">
                <div class="row g-0">
                    <!-- Left Section - Form -->
                    <div class="col-md-6 resetdiv border border-2 rounded-2" >
                        <div class="left-section">
                            <h4 class="card-title mb-4 text-center fw-bold white-space">Change Password </h4>
                            <form  id="passwordchange" novalidate>
                                <div class="mb-3  password-wrapper">
                                    <div class="password-input">
                                    <input class="form-control" name="newPass1" id="newPass1" placeholder="Enter new password" type="password" required style="border: 1px solid #ced4da;">
                                    <span class="toggle-eye"  onclick="togglePassword('newPass1',this)">👁️</span>
                                    </div>
                                    <div id="newPass1Error" class="text-danger  password-error" style="bottom: -20px; left: 0;"></div>
                                </div>
                                
                                <div class="mb-3  password-wrapper">
                                      <div class="password-input"> 
                                    <input class="form-control" name="newPass2" id="newPass2" placeholder="Re-enter new password" type="password" required style="border: 1px solid #ced4da;">
                                    <span class="toggle-eye" onclick="togglePassword('newPass2',this)" >👁️</span>
                                    </div>  
                                    <div id="newPass2Error" class="text-danger password-error" style="bottom: -20px; left: 0;"></div>
                                </div>
                               
                                <div class="mb-4">
                                    <button type="submit" class="btn btn-primary w-100">Change Password</button>
                                </div>
                                
                            </form>
                        <div id="global-spinner" class="loader-overlay hidden">
            <div class="loader">
                <h1 class="text" >HOURLY WATCHES</h1>
            </div>
        </div>
                            <p class="text-center mt-4">Don't have an account? <a href="/signup">Sign up</a></p>
                        </div>
                    </div>
                    
                    <!-- Right Section - Image -->
                    <div class="col-md-6">
                        <div class="right-section">
                            <div class="watch ">
                                <img src="https://res.cloudinary.com/dbl2eazti/image/upload/v1761223625/HourlyYours_axzt7h.png" style="max-width: 170px;" alt="Hourly Yours Logo" class="rounded-2">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <script src="/assets/js/globalSnippper.js"></script>
    <!-- Bootstrap JS and Popper.js -->
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js" integrity="sha384-oBqDVmMz9ATKxIep9tiCxS/Z9fNfEXiDAYTujMAeBAsjFuCZSmKbSSUnQlmh/jp3" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.min.js" integrity="sha384-fbbOQedDUMZZ5KreZpsbe1LCZSmKbSSUnQlmh/jp3" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Form Validation Script -->
    <script>

        function togglePassword (inputId,icon){
            const input = document.getElementById(inputId);

            if(input.type === 'password'){
                input.type = 'text';
                icon.textContent = '🙈'
            }else{
                input.type = 'password'
                icon.textContent = '👁️'
            }
        }

    document.getElementById('passwordchange').addEventListener('submit',async function(event){
        event.preventDefault();
    
        const isValid = validateForm();
        if(!isValid)return;
   try {
    
     const newPass1 = document.getElementById('newPass1').value;
    const newPass2 = document.getElementById('newPass2').value;  

    const  response = await fetch('/reset-password',{
        method:'POST',
        headers:{
            'Content-Type':'application/json'
        },
        body:JSON.stringify({newPass1,newPass2})
    })  

    const data = await response.json()
console.log("response = :",response.status, data);
    if(response.ok){
        Swal.fire({
            icon:'success',
            title:'Success',
            text:data.message,
            timmer:2000,
            timerProgressBar:true
        }).then(()=>{
            window.location.href = '/login'
        })
    }else{
        Swal.fire({
            icon:'error',
            title:'Oops',
            text:data.message,
            timmer:2000,
            timerProgressBar:true
        })
    }

   } catch (error) {
    Swal.fire({
        icon:'error',
        title:'OOPS',
        text:'Internal Error Happened,Please Try again!',
        showConfirmButton:true
    })

   }
    });
        
     function validateForm() {
    let valid = true;

    const newPass1 = document.getElementById('newPass1');
    const newPass2 = document.getElementById('newPass2');
    const newPass1Error = document.getElementById('newPass1Error');
    const newPass2Error = document.getElementById('newPass2Error');


    newPass1Error.textContent = '';
    newPass2Error.textContent = '';

    const password1 = newPass1.value.trim();
    const password2 = newPass2.value.trim();

    const strongPassword = /^(?=.*[A-Za-z])(?=.*\d)(?=.*[!@#$%^&*]).{8,}$/;

    if (!password1) {
        newPass1Error.textContent = "Password cannot be empty.";
        valid = false;
    } else if (!strongPassword.test(password1)) {
        newPass1Error.textContent =
            "Password must be 8+ chars with letters, numbers & special chars (!@#$%^&*)";
        valid = false;
    }

    if (!password2) {
        newPass2Error.textContent = "Please re-enter your password.";
        valid = false;
    } else if (password1 !== password2) {
        newPass2Error.textContent = "Passwords do not match.";
        valid = false;
    }

    return valid;
}
        


    </script>
</body>
</html> 