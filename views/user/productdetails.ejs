<%- include("../../views/partials/user/supportheader")%>
<style>
    .related-product-card {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 2px 6px rgb(112, 110, 110);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .related-product-card:hover {
        transform: scale(1.03);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    }
    .related-product-card img {
        border-radius: 15px 15px 0 0;
        
    }
    .outofstock{
        color:red;
        font-weight: bold;
        background: #ffe6e6;
        padding: 5px 10px;
        border-radius: 5px;
        
    }
    .offer-badge-product{
    display: inline-block;
    padding: 5px 10px;
    border-radius: 12px;
    background: linear-gradient(45deg, #ff6b6b, #f06595);
    color: #fff;
    font-weight: bold;
    font-size: 0.9rem;
}
</style>

    <main class="main bg">
        <div class="page-header breadcrumb-wrap">
            <div class="container">
                
            </div>
        </div>
        <section class="mt-50 mb-50">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-9">
                        <div class="">
                   <span class="fw-bold fs-3 d-block mb-3" >PRODUCTS DETAILS PAGE</span>
                   
                   <span class="d-block mb-3" > HOME > <%= product.productName %></span>
                </div>
                        
                        <div class="product-detail accordion-detail">
                            <div class="row g-4 align-items-start">

                                <div class="col-md-6 bg-grey">                                
                                        
                                        <!-- images -->
                                        <div class="detail-gallery">
                                    <div class="product-image-slider">
                                        <div class="main-image mb-3 zoom-container border">
                                        <img class="zoom-image img-fluid border-radius-10" src="<%= product.productImage[0] %>" alt="Main Product Image" style="width:100%; object-fit:cover;">
                                        </div>
                                        <div class="slider-nav-thumbnails d-flex gap-2">
                                        <% for(let i = 0; i < product.productImage.length; i++) { %>
                                            <div class="thumb border" style="width:80px; height:80px; overflow:hidden;">
                                            <img src="<%= product.productImage[i] %>" class="img-fluid" style="object-fit:cover; width:100%; height:100%;" alt="Thumbnail">
                                            </div>
                                        <% } %>
                                        </div>
                                    </div>
                                    </div>
                                    </div>
                               
                                <div class="col-md-6 ">
                                    <div class="detail-info">
                                            <h2 class="title-detail mb-2"><%=product.productName %></h2>

                                            <div class="product-detail-rating d-flex justify-content-between align-items-center mb-2">
                                                <div class="pro-details-brand">
                                                <span class="text-dark"><strong> Brand: </strong><%=product.brand %></span>
                                                <div class="text-muted small">(25 reviews)</div>
                                            </div>
                                                
                                            </div>

                                            <div class="product-price mb-2">
                                                <span class="text-brand fs-4 fw-bold">₹   <%=product.salePrice.toLocaleString('en-IN') %></span>
                                                <del class="text-muted ms-3"><%=product.regularPrice.toLocaleString('en-IN') %></del>
                                                <span class="offer-badge-product">
                                                <% if(productOffers){ %>
                                                   Product  <%= productOffers %> % Offer
                                                <% } else if(categoryOffers) { %>
                                                   Category <%= categoryOffers %>% Offer
                                                <% } %>
                                                </span>
                                            </div>

                                            <p class="mb-3"><%=product.description %></p>

                                            <ul class="list-unstyled small mb-3">
                                                <li><i class="fi-rs-crown me-2"></i>1 Year Brand Warranty</li>
                                                <li><i class="fi-rs-refresh me-2"></i>30 Day Return Policy</li>
                                                <li><i class="fi-rs-credit-card me-2"></i>Cash on Delivery available</li>
                                            </ul>
                                                <span class="mb-1 text-dark">Category: <%=category.name%></span>
                                            <div class="d-flex align-items-center mb-3">
                                                <!-- <div class="me-3">Qty:</div> -->
                                                <!-- <div class="detail-qty border rounded d-inline-flex align-items-center"> -->
                                                <a href="#" class="qty-down"><i class="fi-rs-angle-small-down"></i></a>
                                                <!-- <span class="qty-val px-3" id="quantity">1</span> -->
                                                <a href="#" class="qty-up"><i class="fi-rs-angle-small-up"></i></a>
                                                </div>
                                            </div>

                                            <div class="product-extra-link2 d-flex gap-3">
                                                <% if(user){%>
                                                <%if(quantity>0 ){%>
                                                <button type="button" class="btn btn-primary add-to-cart" data-productId ="<%=product._id %>" >Add to cart</button>
                                                <% } else { %>
                                                    <span class="outofstock" >Out of Stock</span>
                                                <% } %>
                                                <button type="button" class="btn btn-secondary" onclick="addToWishlist('<%=product._id %>')">Add to Wishlist</button>
                                                <%} else {%>
                                                   <a href="/login" class="btn btn-primary text-light"> Buy Now </a>
                                                    <%}%>
                                            </div>
                                            
                                            <ul class="product-meta font-xs mt-4">
                                                <li class="mb-1">Coupon number <a href="#" class="text-dark ">FWM15VKT</a></li>
                                                
                                                <li class="mb-1">Availability :<span class="<%= quantity <=3 ? 'text-danger':'text-success' %> ms-2"><strong><%=quantity %> in stock</strong></span></li>
                                            </ul>
                                      </div>
                                </div>
                            </div>
                        </div>    
                </div>
            </div>
        </section>
      <div class="p-5"></div>
        <section> 
              <hr class="color-light" >
            <h3 class="text-center mb-3 p-3 " >Related Products</h3>
            <hr>
             <p class="d-flex justify-content-center p-5">"Explore More Like This"</p>
        <div class="row m-3">
            <% if (relatedProducts.length === 0) { %>
                <p class="text-center">No related products found.</p>
            <% } %>
            
            <% relatedProducts.forEach(p => { %>
                <div class="col-md-3 mb-3">
                    <div class="card related-product-card  h-100">
                        <img src="  <%= p.productImage[0] %>" class="card-img-top border-radius-10" style="height:250px; object-fit:cover;">
                         <span class="wishlist1-btn btn" onclick="addToWishlist('<%=product._id %>')">❤️</span>
                        <div class="card-body text-center">
                            <h5 class="card-title"><%= p.productName %></h5>

                            <p class="card-text text-muted">SalePrice : ₹<%= p.salePrice.toLocaleString('en-IN') %></p>
                            <del class="card-text text-muted">Price : ₹<%= p.regularPrice.toLocaleString('en-IN') %></del>

                            <p class="card-text text-muted" >Brand : <%=p.brand %></p>
                            <p class="card-text text-muted" >Color : <%=p.color %></p>
                            <a href="/productDetails?id=<%= p._id %>" class="btn btn-outline-primary btn-sm">View Product</a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

        </section>

        
    </main>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
 <script>
    document.addEventListener('DOMContentLoaded',function(){
    const addtocart = document.querySelectorAll('.add-to-cart')

    addtocart.forEach(button =>{
    button.addEventListener('click',async function(){
                const  productId = this.getAttribute('data-productId') 

                try {
                    const response = await fetch('/addtocart',{
                        method:'POST',
                        headers:{
                            'Content-Type':'application/json'
                        },
                        body:JSON.stringify({productId})
                    })
                   
                    const result = await response.json();
                     
                     if(result.success){
                        Swal.fire({
                        icon:'success',
                        title:'Added to Cart',
                        text:result.message,
                        showCancelmButton:true,
                        confirmButtonText:'View Cart',
                        cancelButtonText:'Continue Shopping'
                        }).then((result)=>{
                            if(result.isConfirmed){
                                window.location.href = '/cart'
                            }
                        })
                     }else{
                        Swal.fire({
                        icon:'error',
                        title:'Oops',
                        text:result.message || "Something Went Wrong",
                        showConfirmButton:true
                        })
                    }
                   
                        } catch (error) {
                       
                            Swal.fire({
                                icon:'error',
                                title:"ERROR",
                                text:result.message ||"ERROR HAPPPEND",
                                showConfirmButton:true
                            })
                }

    })
})
});


async function addToWishlist(productId) {
    try {
      const response = await fetch('/add-to-wishlist',{
        method:'POST',
        headers:{
          'Content-Type':'application/json'
        },
        body:JSON.stringify({productId})
      })

      const result =await response.json();

      if(result.success){
        
        Swal.fire({
          icon:'success',
          title:"Success",
          text:result.message,
        })
      }else{
        Swal.fire({
          icon:'error',
          title:'ERROR',
          text:result.message,
          showConfirmButton:true
        })
      }
    } catch (error) {
      console.log("error in frontend addtoWishlist",error)
      Swal('OOPS','something Went Wrong','error')
    }

}


document.addEventListener("DOMContentLoaded", function () {
    const zoomContainer = document.querySelector('.zoom-container');
    const zoomImage = document.querySelector('.zoom-image');
    const thumbnails = document.querySelectorAll(".slider-nav-thumbnails img");

    // Zoom follow mouse pointer
    zoomContainer.addEventListener('mousemove', function (e) {
        const rect = zoomContainer.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        zoomImage.style.transformOrigin = `${x}% ${y}%`;
    });

    zoomContainer.addEventListener('mouseleave', function () {
        zoomImage.style.transformOrigin = 'center center';
    });

    // Thumbnail click → change main image
    thumbnails.forEach(thumbnail => {
        thumbnail.addEventListener("click", function () {
            zoomImage.src = this.src;
            thumbnails.forEach(t => t.classList.remove("active-thumb"));
            this.classList.add("active-thumb");
        });
    });
});
</script>
<%- include("../../views/partials/user/supportfooter") %>





