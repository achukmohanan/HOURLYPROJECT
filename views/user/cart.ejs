 <%- include("../../views/partials/user/supportheader") %>
    <title>HOURLY | cart</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            background-color: #f5f5f5;
            color: #333;
        }

      
        /* Main Content */
        .main-content {
            max-width: 1200px;
            margin: 70px auto;
            padding: 40px 20px;
        }

        .breadcrumb {
            margin-bottom: 40px;
            font-size: 14px;
            color: #666;
        }

        .breadcrumb a {
            text-decoration: none;
            color: #666;
        }

        .page-title {
            font-size: 32px;
            font-weight: bold;
            margin-bottom: 40px;
            color: #333;
        }

        .cart-container {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 60px;
        }

        /* Cart Items */
        .cart-section h3 {
            font-size: 18px;
            font-weight: normal;
            margin-bottom: 30px;
            color: #333;
        }

        .cart-item {
            display: flex;
            align-items: center;
            padding: 20px 0;
            border-bottom: 1px solid #eee;
        }

        .item-image {
            width: 80px;
            height: 80px;
            background-color: #f0f0f0;
            border-radius: 8px;
            margin-right: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .item-image img {
            width: 60px;
            height: 60px;
            object-fit: contain;
        }

        .item-details {
            flex: 1;
        }

        .item-name {
            font-size: 16px;
            font-weight: normal;
            margin-bottom: 5px;
            color: #333;
        }

        .item-subtitle {
            font-size: 12px;
            color: #999;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .item-price {
            font-size: 16px;
            color: #333;
            margin-right: 20px;
            min-width: 100px;
        }

        .quantity-controls {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-right: 20px;
        }

        .quantity-btn {
            width: 30px;
            height: 30px;
            border: 1px solid #ddd;
            background: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .quantity-btn:hover {
            background: #f5f5f5;
        }

        .quantity {
            width: 40px;
            text-align: center;
            font-size: 14px;
        }

        .remove-btn {
            background: none;
            border: none;
            font-size: 18px;
            cursor: pointer;
            color: #999;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .remove-btn:hover {
            color: #666;
        }

        /* Order Summary */

        .summary-section{
            background-color: #f6f6f6;
            border-radius: 10px;
        }
        
        .summary-section h3 {
            font-size: 18px;
            font-weight: normal;
            margin-bottom: 30px;
            color: #363434;
            
        }

        .summary-line {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
            font-size: 14px;
        }

        .summary-line.total {
            font-size: 16px;
            font-weight: bold;
            padding-top: 15px;
            border-top: 1px solid #eee;
            margin-top: 20px;
        }

        .checkout-btn {
            width: 100%;
            background-color: #333;
            color: white;
            border: none;
            padding: 15px;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            margin-top: 20px;
        }

        .checkout-btn:hover {
            background-color: #555;
        }

        .continue-shopping {
            text-align: center;
            margin-top: 15px;
        }

        .continue-shopping a {
            color: #666;
            text-decoration: none;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .no-underline {
  text-decoration: none;
}
.body-fade-out {
  opacity: 0;
  transition: opacity 0.5s ease;
}
.breadcrumb {
  font-size: 1rem;
  color: #555;
}

.breadcrumb-item {
  color: #888;
}

.breadcrumb-item.active {
  font-weight: bold;
  color: #000;
}

       
    </style>
</head>
<body>
   

    <!-- Main Content -->
    <main class="main-content">
        <h3 class="text-muted" >Hi <%=user.name %></h3>
        <h1 class="page-title">Your Shopping Cart</h1>
        <div class="breadcrumb">
            <span class="breadcrumb-item active">Cart</span> 
            <span class="breadcrumb-item">Shipping </span> 
            <span class="breadcrumb-item">Payment</span>
        </div>


        <div class="cart-container">
            <!-- Cart Items -->
            <div class="cart-section"> 
                <%if(cart && cart.items.length > 0) {%> 
                    <% cart.items.forEach(item=>{%>
                <div class="cart-item">
                    <div class="item-image">
                        <div class="watch-classic">
                           <img src=" <%= item.productId.productImage[0] %>" alt=""></div>
                    </div>
                    
                    <div class="item-details">
                        <div class="item-name"><%= item.productId.productName %></div>
                        <div class="item-subtitle"><%= item.productId.description.split(' ').slice(0,10).join(' ') + '...'  %> </div>  
                        <div class="text-muted fs-6"><%=item.productId.color %></div>
                    </div>
                  
                    <div class="quantity-controls">    
                        <button class="quantity-btn" onclick="updateQuantity('<%= item.productId._id %>', -1)">-</button>
                        <span class="quantity" id="qty-<%= item.productId._id %>"><%=item.quantity %></span>
                        <button class="quantity-btn" onclick="updateQuantity('<%= item.productId._id %>', 1)">+</button>   
                    </div>
                    <div class="price ">
                        <div class="fw-bold">
                      ₹<%= (item.productId.salePrice * item.quantity).toLocaleString('en-IN')  %>
                    </div>
                    <div class="text-muted text-decoration-line-through">
                        ₹<%= item.productId.regularPrice.toLocaleString('en-IN')%>
                    </div>
                    </div>
                    
                    <button class="deletebtn remove-btn" data-productId="<%= item.productId._id %>" type="button" ><i class="bi bi-trash text-danger"></i></button>
                </div>
                
                   <% })%>
            <%}else{%>
                <div class="d-flex  justify-content-center border p-5">
                    <p>YOUR CART IS EMPTY!</p>
                </div>
               
            <%}%>
             </div>
               

            <!-- Order Summary -->
            <div class="summary-section  p-3">
                <h3 class="text-dark fw-bold" >Order Summary</h3>
                 <% cart.items.forEach(item=>{%>
                <div class="summary-line">
                    <span>Product :<%= item.productId.productName %></span>
                    <span id="price-<%= item.productId._id %>"> ₹ <%= item.productId.salePrice * item.quantity  %></span>
                </div>
                <%})%>
                <div class="summary-line">
                    <span>Shipping</span>
                    <span style="color: #0bdb15;">Free</span>
                </div>
                <!-- <div class="summary-line">
                    <span>Tax</span>
                    <span id="tax">Rs. 50,000</span>
                </div> -->
                <hr>
                <div class="summary-line ">
                    <span class="fw-bold">Total</span>
                    <span  id="total"> ₹ <%= totalPrice.toLocaleString('en-IN') %></span>
                </div>
                
                <a href="/checkout" class="btn checkout-btn">CHECKOUT</a>
                
                <div class="continue-shopping">
                    <a href="/shop">Continue Shopping</a>
                </div>
            </div>
        </div>
    </main>

    
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        
        document.addEventListener('DOMContentLoaded',function(){
            const deletebutton = document.querySelectorAll('.deletebtn')

            deletebutton.forEach(button =>{

                button.addEventListener('click',async function(){
                    const productId = this.getAttribute('data-productId')

                    
                const result = await Swal.fire({
                        icon:'warning',
                        title:"You want to delete this item from cart ?",
                        showConfirmButton:true,
                        confirmButtonText:'Yes,delete it',
                        showCancelButton:true,
                        cancelButtonColor:'#ff0000'
                    })

                    if(result.isConfirmed){
                        try {
                         const response= await fetch('/delete-cart-item',{
                            method:'DELETE',
                            headers:{
                                'Content-Type':'application/json'
                            },
                            body:JSON.stringify({productId})
                         });
                         
                         const data = await  response.json()

                         if(data.success){
                            Swal.fire({
                                icon:'success',
                                title:"Removed",
                                text:data.message
                            }).then(()=>{
                                window.location.reload();
                            })
                         }else{
                            Swal.fire({
                                icon:'error',
                                title:"Failed",
                                text:data.message,
                                showConfirmButton:true
                            })
                         }

                        } catch (error) {
                            console.log("error in frontend ",error);
                            Swal.fire({
                                icon:'error',
                                title:'Oops',
                                text: "Internal Server Error",
                                showConfirmButton:true
                            })
                        }

                    }
                   
                })
            })
      
})

     async function updateQuantity(productId,change){
        try {
            const response = await fetch('/update-quantity-cart',{
                method:'PATCH',
                headers:{
                    'Content-Type':'application/json'
                },
                body:JSON.stringify({productId,change})
            })

            const result = await response.json();
           
            if(result.success){
                const qty = document.getElementById(`qty-${productId}`);
                qty.textContent = result.newQuantity;
                
                const price = document.getElementById(`price-${productId}`)
                if(price){
                    price.textContent = `Rs: ${result.updatePrice.toLocaleString('en-IN')}`
                }  
                const totalPrice = document.getElementById('total') 
                if(totalPrice){ 
                    totalPrice.textContent = `Rs . ${result.total.toLocaleString('en-IN')}`
                }
              
                setTimeout(()=>{
                     document.body.classList.add('body-fade-out');
                     setTimeout(()=>{
                    window.location.reload()
                },100)

                },200)

            }else{
                Swal.fire({
                    icon:'warning',
                    text:result.message ,
                    showConfirmButton:"true"

                })
                .then(()=>{
                    window.location.reload()
                })
            }
             
           

        } catch (error) {
            console.log("error in frontend of update quantity in cart");
            Swal.fire({
                icon:'error',
                title:"Oops",
                text: "Internal Server Error"
            })  
            
        }
     }

      
     
     
     // Add smooth animations
        document.addEventListener('DOMContentLoaded', function() {
            const cartItems = document.querySelectorAll('.cart-item');
            cartItems.forEach((item, index) => {
                item.style.opacity = '0';
                item.style.transform = 'translateY(20px)';
                setTimeout(() => {
                    item.style.transition = 'all 0.5s ease';
                    item.style.opacity = '1';
                    item.style.transform = 'translateY(0)';
                }, index * 100);
            });
        });
    </script>
</body>
