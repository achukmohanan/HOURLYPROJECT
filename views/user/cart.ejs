<%- include("../../views/partials/user/supportheader") %>
    <title>HOURLY | cart</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            background-color: #f5f5f5;
            color: #333;
            overflow-x: hidden;
        }

        /* Main Content */
        .main-content {
            max-width: 1200px;
            margin: 70px auto;
            padding: 40px 20px;
        }

        .breadcrumb {
            margin-bottom: 40px;
            font-size: 14px;
            color: #666;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .breadcrumb a {
            text-decoration: none;
            color: #666;
        }

        .breadcrumb-item {
            color: #888;
            position: relative;
        }

        .breadcrumb-item:not(:last-child)::after {
            content: "›";
            margin-left: 10px;
            color: #ccc;
        }

        .breadcrumb-item.active {
            font-weight: bold;
            color: #000;
        }

        .page-title {
            font-size: 32px;
            font-weight: bold;
            margin-bottom: 40px;
            color: #333;
        }

        .cart-container {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 60px;
        }

        /* Cart Items */
        .cart-section h3 {
            font-size: 18px;
            font-weight: normal;
            margin-bottom: 30px;
            color: #333;
        }

        .cart-item {
            display: flex;
            align-items: center;
            padding: 20px 0;
            border-bottom: 1px solid #eee;
            gap: 15px;
        }

        .item-image {
            width: 80px;
            height: 80px;
            background-color: #f0f0f0;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            flex-shrink: 0;
        }

        .item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .item-details {
            flex: 1;
            min-width: 0;
        }

        .item-name {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 5px;
            color: #333;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

        .item-subtitle {
            font-size: 12px;
            color: #999;
            margin-bottom: 5px;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

        .item-color {
            font-size: 12px;
            color: #666;
        }

        .item-price {
            font-size: 16px;
            color: #333;
            min-width: 100px;
        }

        .price {
            text-align: right;
        }

        .quantity-controls {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .quantity-btn {
            width: 30px;
            height: 30px;
            border: 1px solid #ddd;
            background: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            border-radius: 4px;
            transition: all 0.2s;
        }

        .quantity-btn:hover {
            background: #f5f5f5;
            border-color: #999;
        }

        .quantity-btn:active {
            transform: scale(0.95);
        }

        .quantity {
            width: 40px;
            text-align: center;
            font-size: 14px;
            font-weight: 600;
        }

        .remove-btn {
            background: none;
            border: none;
            font-size: 18px;
            cursor: pointer;
            color: #999;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: all 0.2s;
        }

        .remove-btn:hover {
            color: #dc3545;
            transform: scale(1.1);
        }

        /* Order Summary */
        .summary-section {
            background-color: #f6f6f6;
            border-radius: 10px;
            padding: 20px;
            position: sticky;
            top: 90px;
            height: fit-content;
        }
        
        .summary-section h3 {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 30px;
            color: #363434;
        }

        .summary-line {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
            font-size: 14px;
            gap: 10px;
        }

        .summary-line span:first-child {
            flex: 1;
            word-break: break-word;
        }

        .summary-line span:last-child {
            font-weight: 600;
            white-space: nowrap;
        }

        .summary-line.total {
            font-size: 16px;
            font-weight: bold;
            padding-top: 15px;
            border-top: 1px solid #ddd;
            margin-top: 20px;
        }

        .checkout-btn {
            width: 100%;
            background-color: #333;
            color: white;
            border: none;
            padding: 15px;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            margin-top: 20px;
            border-radius: 5px;
            transition: all 0.3s;
        }

        .checkout-btn:hover {
            background-color: #555;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

        .checkout-btn.disabled {
            background-color: #ccc;
            cursor: not-allowed;
            pointer-events: none;
            opacity: 0.6;
        }

        .continue-shopping {
            text-align: center;
            margin-top: 15px;
        }

        .continue-shopping a {
            color: #666;
            text-decoration: none;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: color 0.2s;
        }

        .continue-shopping a:hover {
            color: #333;
        }

        .no-underline {
            text-decoration: none;
        }

        

        .empty-cart {
            text-align: center;
            padding: 60px 20px;
            background: white;
            border-radius: 10px;
        }

        .empty-cart p {
            font-size: 18px;
            color: #999;
            margin-bottom: 20px;
        }

        /* Tablet Responsive (992px and below) */
        @media (max-width: 992px) {
            .main-content {
                margin: 60px auto;
                padding: 30px 15px;
            }

            .cart-container {
                gap: 40px;
            }

            .page-title {
                font-size: 28px;
                margin-bottom: 30px;
            }
        }

        /* Mobile Responsive (768px and below) */
        @media (max-width: 768px) {
            .main-content {
                margin: 50px auto 20px;
                padding: 20px 12px;
            }

            .page-title {
                font-size: 24px;
                margin-bottom: 20px;
            }

            .breadcrumb {
                font-size: 12px;
                margin-bottom: 20px;
            }

            .cart-container {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .summary-section {
                position: static;
                order: 2;
                margin-top: 20px;
            }

            .cart-section {
                order: 1;
            }

            .cart-item {
                flex-wrap: wrap;
                padding: 15px 0;
                gap: 12px;
            }

            .item-image {
                width: 70px;
                height: 70px;
            }

            .item-details {
                flex: 1;
                min-width: 150px;
            }

            .item-name {
                font-size: 14px;
            }

            .item-subtitle {
                font-size: 11px;
            }

            .price {
                width: 100%;
                text-align: left;
                margin-top: 5px;
                order: 4;
            }

            .quantity-controls {
                order: 3;
                margin-left: auto;
            }

            .remove-btn {
                order: 5;
                margin-left: auto;
            }

            .summary-line {
                font-size: 13px;
            }
        }

        /* Small Mobile (576px and below) */
        @media (max-width: 576px) {
            .main-content {
                padding: 15px 10px;
            }

            .page-title {
                font-size: 20px;
                margin-bottom: 15px;
            }

            .breadcrumb {
                font-size: 11px;
                margin-bottom: 15px;
                gap: 5px;
            }

            .breadcrumb-item:not(:last-child)::after {
                margin-left: 5px;
            }

            .cart-item {
                padding: 12px 0;
                gap: 10px;
            }

            .item-image {
                width: 60px;
                height: 60px;
            }

            .item-details {
                min-width: 120px;
            }

            .item-name {
                font-size: 13px;
                -webkit-line-clamp: 1;
            }

            .item-subtitle {
                font-size: 10px;
                -webkit-line-clamp: 1;
            }

            .item-color {
                font-size: 10px;
            }

            .price {
                font-size: 14px;
            }

            .price .fw-bold {
                font-size: 15px;
            }

            .price .text-muted {
                font-size: 11px;
            }

            .quantity-controls {
                gap: 8px;
            }

            .quantity-btn {
                width: 28px;
                height: 28px;
                font-size: 14px;
            }

            .quantity {
                width: 35px;
                font-size: 13px;
            }

            .remove-btn {
                font-size: 16px;
            }

            .summary-section {
                padding: 15px;
            }

            .summary-section h3 {
                font-size: 16px;
                margin-bottom: 20px;
            }

            .summary-line {
                font-size: 12px;
                margin-bottom: 12px;
            }

            .summary-line.total {
                font-size: 14px;
            }

            .checkout-btn {
                padding: 12px;
                font-size: 13px;
            }

            .continue-shopping a {
                font-size: 11px;
            }

            .empty-cart {
                padding: 40px 15px;
            }

            .empty-cart p {
                font-size: 16px;
            }
        }

        /* Extra Small Mobile (420px and below) */
        @media (max-width: 420px) {
            .main-content {
                padding: 12px 8px;
            }

            .page-title {
                font-size: 18px;
            }

            .cart-item {
                padding: 10px 0;
            }

            .item-image {
                width: 55px;
                height: 55px;
            }

            .item-details {
                min-width: 100px;
            }

            .item-name {
                font-size: 12px;
            }

            .item-subtitle {
                font-size: 9px;
            }

            .price {
                font-size: 13px;
            }

            .price .fw-bold {
                font-size: 14px;
            }

            .quantity-btn {
                width: 26px;
                height: 26px;
                font-size: 13px;
            }

            .quantity {
                width: 30px;
                font-size: 12px;
            }

            .summary-section {
                padding: 12px;
            }

            .summary-section h3 {
                font-size: 15px;
            }

            .summary-line {
                font-size: 11px;
            }

            .checkout-btn {
                padding: 10px;
                font-size: 12px;
            }
        }

        /* Very Small Screens (360px and below) */
        @media (max-width: 360px) {
            .main-content {
                padding: 10px 5px;
            }

            .page-title {
                font-size: 16px;
            }

            .item-image {
                width: 50px;
                height: 50px;
            }

            .item-name {
                font-size: 11px;
            }

            .cart-item {
                gap: 8px;
            }

            .quantity-controls {
                gap: 6px;
            }

            .quantity-btn {
                width: 24px;
                height: 24px;
                font-size: 12px;
            }

            .quantity {
                width: 28px;
                font-size: 11px;
            }
        }
    </style>
</head>
<body>
    <!-- Main Content -->
    <main class="main-content">
        <h3 class="text-muted">Hi <%= user.name %></h3>
        <h1 class="page-title">Your Shopping Cart</h1>
        <div class="breadcrumb">
            <span class="breadcrumb-item active">Cart</span> 
            <span class="breadcrumb-item">Checkout</span> 
            <span class="breadcrumb-item">Payment</span>
        </div>
         <span class="text-mute ">"You can add up to 5 units of each product per order." </span>
        <div class="cart-container">
            <!-- Cart Items -->
            <div class="cart-section"> 
                <% if(cart && cart.items.length > 0) { %> 
                    <% cart.items.forEach(item => { %>
                        <div class="cart-item">
                            <div class="item-image">
                                <img src="<%= item.productId.productImage[0] %>" alt="<%= item.productId.productName %>">
                            </div>
                            
                            <div class="item-details">
                                <div class="item-name"><%= item.productId.productName %></div>
                                <div class="item-subtitle"><%= item.productId.description.split(' ').slice(0,10).join(' ') + '...' %></div>  
                                <div class="item-color text-muted"><%= item.productId.color %></div>
                            </div>
                          
                            <div class="quantity-controls">    
                                <button class="quantity-btn" onclick="updateQuantity('<%= item.productId._id %>', -1)">-</button>
                                <span class="quantity" id="qty-<%= item.productId._id %>"><%= item.quantity %></span>
                                <button class="quantity-btn" onclick="updateQuantity('<%= item.productId._id %>', 1)">+</button>   
                            </div>

                            <div class="price">
                                <div class="fw-bold">
                                    ₹<%= (item.productId.salePrice * item.quantity).toLocaleString('en-IN') %>
                                </div>
                                <div class="text-muted text-decoration-line-through">
                                    ₹<%= item.productId.regularPrice.toLocaleString('en-IN') %>
                                </div>
                            </div>
                            
                            <button class="deletebtn remove-btn" data-productId="<%= item.productId._id %>" type="button">
                                <i class="bi bi-trash text-danger"></i>
                            </button>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="empty-cart">
                        <p>YOUR CART IS EMPTY!</p>
                        <a href="/shop" class="btn btn-dark">Continue Shopping</a>
                    </div>
                <% } %>
            </div>

            <!-- Order Summary -->
            <div class="summary-section">
                <h3 class="text-dark fw-bold">Order Summary</h3>
                <% if(cart && cart.items && cart.items.length > 0) { %>
                    <% cart.items.forEach(item => { %>    
                        <div class="summary-line">
                            <span><%= item.productId.productName %></span>
                            <span id="price-<%= item.productId._id %>">₹<%= item.productId.salePrice * item.quantity %></span>
                        </div>
                    <% }) %>
                  
                    <p class="text-muted" style="font-size: 10px;">*including all taxes and offer</p> 
                    <div class="summary-line">
                        <span>Shipping</span>
                        <span style="color: #0bdb15;">Free</span>
                    </div>
                    <hr>
                    <div class="summary-line">
                        <span class="fw-bold">Offer Price</span>
                        <span id="total">₹<%= totalPrice.toLocaleString('en-IN') %></span>
                    </div>
                <% } else { %>
                    <p class="text-center text-muted">No Products Selected</p>
                <% } %>

                <% let iscartEmpty = !cart || !cart.items || cart.items.length === 0 %>
                <% if(iscartEmpty) { %>
                    <button class="btn checkout-btn disabled">
                        <i class="fas fa-times-circle" style="color:red; margin-right:5px;"></i>
                        CHECKOUT
                    </button>
                <% } else { %>
                    <a href="/checkout" class="btn checkout-btn no-underline">CHECKOUT</a>
                <% } %>

                <div class="continue-shopping">
                    <a href="/shop">Continue Shopping</a>
                </div>
            </div>
        </div>
    </main>
  
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const deletebutton = document.querySelectorAll('.deletebtn');

        deletebutton.forEach(button => {
            button.addEventListener('click', async function() {
                const productId = this.getAttribute('data-productId');
                
                const result = await Swal.fire({
                    icon: 'warning',
                    title: "You want to delete this item from cart?",
                    showConfirmButton: true,
                    confirmButtonText: 'Yes, delete it',
                    showCancelButton: true,
                    cancelButtonColor: '#ff0000'
                });

                if(result.isConfirmed) {
                    try {
                        const response = await fetch('/delete-cart-item', {
                            method: 'DELETE',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({productId})
                        });
                        
                        const data = await response.json();

                        if(data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: "Removed",
                                text: data.message
                            }).then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: "Failed",
                                text: data.message,
                                showConfirmButton: true
                            });
                        }
                    } catch (error) {
                        console.log("error in frontend", error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Oops',
                            text: "Internal Server Error",
                            showConfirmButton: true
                        });
                    }
                }
            });
        });
    });

    async function updateQuantity(productId, change) {
        try {
            const response = await fetch('/update-quantity-cart', {
                method: 'PATCH',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({productId, change})
            });

            const result = await response.json();
           
            if(result.success) {
                const qty = document.getElementById(`qty-${productId}`);
                qty.textContent = result.newQuantity;
                
                const price = document.getElementById(`price-${productId}`);
                if(price) {
                    price.textContent = `₹${result.updatePrice.toLocaleString('en-IN')}`;
                }  

                const totalPrice = document.getElementById('total');
                if(totalPrice) { 
                    totalPrice.textContent = `₹${result.total.toLocaleString('en-IN')}`;
                }
            
            } else {
                Swal.fire({
                    icon: 'warning',
                    text: result.message,
                    showConfirmButton: true
                }).then(() => {
                    window.location.reload();
                });
            }
        } catch (error) {
            console.log("error in frontend of update quantity in cart");
            Swal.fire({
                icon: 'error',
                title: "Oops",
                text: "Internal Server Error"
            });  
        }
    }

    // Add smooth animations

</script>
</body>
<%- include("../../views/partials/user/supportfooter") %>