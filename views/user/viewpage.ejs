<%- include("../../views/partials/user/header") %>
<section class="py-6 bg-light">
  <div class="container">
    <div class="row">
      <div class="col-12 text-center mb-5">
        <h5 class="fs-3 fs-lg-5 lh-sm mb-3 text-uppercase">Our Products</h5>
        <p class="text-muted">Discover our latest collection of premium timepieces</p>
      </div>
    </div>
    
    <div class="row product__filter g-4">
      <% if(products && products.length > 0) { %>
        <% for(let i=0; i<products.length; i++) { %>
          <div class="col-lg-3 col-md-4 col-sm-6 col-12">
            <div class="product-cart-wrap h-100">
              <div class="product-img-action-wrap">
                <div class="product-img">
                  <a href="/productDetails?id=<%=products[i]._id %>">
                    <img class="default-img img-fluid" 
                         src="/uploads/reimage/<%= products[i].productImage[0]%>" 
                         alt="<%=products[i].productName %>"
                         loading="lazy">
                  </a>
                </div>
                <a href="/addToWishlist?id=<%=products[i]._id%>" 
                   class="wishlist-btn" 
                   title="Add to Wishlist">
                  <i class="fas fa-heart"></i>
                </a>
              </div>
              
              <div class="product-content-wrap">
                <div class="product-info">
                  <h6 class="product-name text-dark"><%=products[i].productName %></h6>
                  <div class="product-price">
                    <h5 class="price text-dark" >$<%=products[i].salePrice %></h5>
                    <% if(products[i].regularPrice && products[i].regularPrice > products[i].salePrice) { %>
                      <span class="old-price text-muted text-decoration-line-through">
                        $<%=products[i].regularPrice %>
                      </span>
                    <% } %>
                  </div>
                </div>
                
                <div class="product-actions mt-3">
                  <a href="/addToCart?id=<%=products[i]._id %>" 
                     class="btn btn-primary btn-add-cart">
                    <i class="fas fa-shopping-cart me-2"></i>Add to Cart
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      <% } else { %>
        <div class="col-12">
          <div class="text-center py-5">
            <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">No products available</h4>
            <p class="text-muted">Check back soon for new arrivals!</p>
          </div>
        </div>
      <% } %>
    </div>
    
    <!-- View All Products Button -->
    <% if(products && products.length > 0) { %>
      <div class="row mt-5">
        <div class="col-12 text-center">
          <a href="/productsDetails" class="btn btn-outline-primary btn-lg">
            View All Products <i class="fas fa-arrow-right ms-2"></i>
          </a>
        </div>
      </div>
    <% } %>
  </div>
</section>