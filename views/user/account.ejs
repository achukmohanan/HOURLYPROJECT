    <script>
       
// Enhanced JavaScript for Responsive User Profile

document.addEventListener('DOMContentLoaded', () => {
    // Initialize tab from URL parameter
    initializeTabFromURL();
    
    // Setup all event listeners
    setupTabNavigation();
    setupMobileSidebar();
    setupAddressDeletion();
    setupPasswordChange();
    setupWalletTopUp();
    setupClipboardCopy();
});

// Initialize tab based on URL parameter
function initializeTabFromURL() {
    const urlParams = new URLSearchParams(window.location.search);
    const tab = urlParams.get('tab');
    
    if (tab) {
        // Remove active class from all links and panes
        document.querySelectorAll('.sidebar-link').forEach(l => l.classList.remove('active'));
        document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('show', 'active'));
        
        // Activate target tab
        const targetLink = document.querySelector(`.sidebar-link[data-tab="${tab}"]`);
        const targetPane = document.getElementById(tab);
        
        if (targetLink && targetPane) {
            targetLink.classList.add('active');
            targetPane.classList.add('show', 'active');
        }
    }
}

// Setup tab navigation
function setupTabNavigation() {
    document.querySelectorAll('.sidebar-link').forEach(link => {
        link.addEventListener('click', (e) => {
            e.preventDefault();
            
            const targetTab = link.getAttribute('data-tab');
            
            // Skip if it's a logout link or doesn't have data-tab
            if (!targetTab) return;
            
            // Update active states
            document.querySelectorAll('.sidebar-link').forEach(l => l.classList.remove('active'));
            link.classList.add('active');
            
            // Switch tab panes
            document.querySelectorAll('.tab-pane').forEach(pane => {
                pane.classList.remove('show', 'active');
            });
            
            const targetPane = document.getElementById(targetTab);
            if (targetPane) {
                targetPane.classList.add('show', 'active');
            }
            
            // Close mobile sidebar after selection
            if (window.innerWidth <= 768) {
                closeMobileSidebar();
            }
            
            // Update URL without reload
            const newUrl = new URL(window.location);
            newUrl.searchParams.set('tab', targetTab);
            window.history.pushState({}, '', newUrl);
        });
    });
}

// Setup mobile sidebar toggle
function setupMobileSidebar() {
    const sidebarToggle = document.getElementById('sidebarToggle');
    const sidebar = document.getElementById('sidebarMenu');
    
    if (sidebarToggle && sidebar) {
        sidebarToggle.addEventListener('click', (e) => {
            e.stopPropagation();
            sidebar.classList.toggle('show');
        });
        
        // Close sidebar when clicking outside on mobile
        document.addEventListener('click', (e) => {
            if (window.innerWidth <= 768) {
                const isClickInsideSidebar = sidebar.contains(e.target);
                const isClickOnToggle = sidebarToggle.contains(e.target);
                
                if (!isClickInsideSidebar && !isClickOnToggle && sidebar.classList.contains('show')) {
                    closeMobileSidebar();
                }
            }
        });
        
        // Close sidebar on window resize to desktop
        window.addEventListener('resize', () => {
            if (window.innerWidth > 768) {
                sidebar.classList.remove('show');
            }
        });
    }
}

// Close mobile sidebar
function closeMobileSidebar() {
    const sidebar = document.getElementById('sidebarMenu');
    if (sidebar) {
        sidebar.classList.remove('show');
    }
}

// Setup address deletion
function setupAddressDeletion() {
    const deleteButtons = document.querySelectorAll('.delete-btn');
    
    deleteButtons.forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            
            const addressId = this.getAttribute('data-id');
            
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you really want to delete this address?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    deleteAddress(addressId);
                }
            });
        });
    });
}

// Delete address function
function deleteAddress(addressId) {
    fetch(`/deleteAddress?id=${addressId}`, {
        method: 'GET'
    })
    .then(response => response.json())
    .then(data => {
        if (data.message === "Address Delected Successfully" || data.success) {
            Swal.fire({
                icon: 'success',
                title: 'Deleted!',
                text: 'Your address has been deleted.',
                confirmButtonColor: '#667eea'
            }).then(() => {
                window.location.reload();
            });
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: data.message || "Something went wrong"
            });
        }
    })
    .catch(error => {
        console.error("Error deleting address:", error);
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'Server error occurred.'
        });
    });
}

// Setup password change
function setupPasswordChange() {
    const changePasswordForm = document.getElementById('changePassword');
    
    if (changePasswordForm) {
        changePasswordForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            try {
                const currentPassword = document.getElementById('currentPassword').value.trim();
                const newPassword = document.getElementById('newPassword').value.trim();
                const confirmPassword = document.getElementById('confirmPassword').value.trim();
                
                // Validate passwords match
                if (newPassword !== confirmPassword) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops',
                        text: 'Passwords do not match',
                        confirmButtonColor: '#667eea'
                    });
                    return;
                }
                
                // Validate password strength
                if (newPassword.length < 8) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Weak Password',
                        text: 'Password must be at least 8 characters long',
                        confirmButtonColor: '#667eea'
                    });
                    return;
                }
                
                const response = await fetch('/changePassword', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ currentPassword, newPassword, confirmPassword })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: data.message,
                        confirmButtonColor: '#667eea'
                    }).then(() => {
                        changePasswordForm.reset();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops',
                        text: data.message,
                        confirmButtonColor: '#667eea'
                    });
                }
            } catch (error) {
                console.error("Error changing password:", error);
                Swal.fire({
                    icon: 'error',
                    title: 'ERROR',
                    text: 'Something went wrong. Please try again.',
                    confirmButtonColor: '#667eea'
                });
            }
        });
    }
}

// Setup wallet top-up
function setupWalletTopUp() {
    const walletButton = document.getElementById('walletButton');
    
    if (walletButton) {
        walletButton.addEventListener('click', async () => {
            const { value: amount } = await Swal.fire({
                title: 'ADD MONEY TO WALLET',
                input: 'number',
                inputLabel: 'Enter amount in ₹',
                inputPlaceholder: 'e.g., 500',
                showCancelButton: true,
                confirmButtonText: 'ADD',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#667eea',
                inputValidator: (value) => {
                    if (!value || value <= 0) {
                        return 'Please enter a valid amount';
                    }
                    if (value > 100000) {
                        return 'Maximum amount is ₹1,00,000';
                    }
                }
            });
            
            if (amount) {
                await processWalletTopUp(amount);
            }
        });
    }
}

// Process wallet top-up
async function processWalletTopUp(amount) {
    const userId = document.body.getAttribute('data-user-id') || '';
    
    try {
        const response = await fetch('/wallet-top-up', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ userId, amount })
        });
        
        const data = await response.json();
        
        if (!data.orderId) {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Something went wrong. Please try again.',
                confirmButtonColor: '#667eea'
            });
            return;
        }
        
        // Razorpay options
        const options = {
            'key': data.key,
            'amount': data.amount,
            'currency': 'INR',
            'name': 'HOURLY WATCHES',
            'description': 'Add to Wallet',
            'order_id': data.orderId,
            'handler': function(response) {
                verifyWalletTopUp(response, amount, userId);
            },
            'modal': {
                'ondismiss': function() {
                    Swal.fire({
                        icon: 'info',
                        title: 'Payment Cancelled',
                        text: 'You cancelled the payment process',
                        confirmButtonColor: '#667eea'
                    });
                }
            },
            'theme': {
                'color': '#667eea'
            }
        };
        
        const rzp = new Razorpay(options);
        rzp.open();
        
    } catch (error) {
        console.error("Error in wallet top-up:", error);
        Swal.fire({
            icon: 'error',
            title: 'ERROR',
            text: 'Something went wrong',
            confirmButtonColor: '#667eea'
        });
    }
}

// Verify wallet top-up
function verifyWalletTopUp(response, amount, userId) {
    fetch('/verify-wallet-topup', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ ...response, amount, userId })
    })
    .then(res => {
        if (!res.ok) {
            throw new Error("Network response was not ok");
        }
        return res.json();
    })
    .then(result => {
        if (result.success) {
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: 'Money added to wallet successfully!',
                confirmButtonColor: '#667eea'
            }).then(() => {
                window.location.reload();
            });
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Failed',
                text: 'Payment verification failed',
                confirmButtonColor: '#667eea'
            });
        }
    })
    .catch(err => {
        console.error("Error in verify-wallet-topup:", err);
        Swal.fire({
            icon: 'error',
            title: 'ERROR',
            text: 'Something went wrong in verification',
            confirmButtonColor: '#667eea'
        });
    });
}

// Setup clipboard copy functions
function setupClipboardCopy() {
    // These functions are called from inline onclick handlers in your HTML
    window.copyToClipboard = function() {
        const referralCode = document.getElementById('clipboardCopy')?.innerText;
        
        if (!referralCode) {
            showToast('Error: Referral code not found');
            return;
        }
        
        navigator.clipboard.writeText(referralCode)
            .then(() => {
                showToast('Referral Code Copied: ' + referralCode);
            })
            .catch(err => {
                console.error("Failed to copy referral code:", err);
                Swal.fire({
                    icon: 'error',
                    title: 'Failed to Copy',
                    text: 'Unable to copy to clipboard',
                    confirmButtonColor: '#667eea'
                });
            });
    };
    
    window.copyToCoupon = function() {
        // Get the coupon code from the clicked button's parent element
        const button = event.target;
        const couponCard = button.closest('.coupon-card');
        const copyElement = couponCard ? couponCard.querySelector('#copyCoupon, [id^="copyCoupon"]') : null;
        const couponCode = copyElement ? copyElement.innerText : document.getElementById('copyCoupon')?.innerText;
        
        if (!couponCode) {
            showToast('Error: Coupon code not found');
            return;
        }
        
        navigator.clipboard.writeText(couponCode)
            .then(() => {
                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: `Successfully copied: ${couponCode}`,
                    timer: 2000,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                });
            })
            .catch(err => {
                console.error("Failed to copy coupon:", err);
                Swal.fire({
                    icon: 'error',
                    title: 'Failed to Copy',
                    text: 'Unable to copy to clipboard',
                    confirmButtonColor: '#667eea'
                });
            });
    };
}

// Show toast notification
function showToast(message) {
    const toast = document.getElementById('toast');
    
    if (!toast) {
        console.warn('Toast element not found');
        return;
    }
    
    toast.innerText = message;
    toast.className = 'show';
    
    setTimeout(() => {
        toast.className = toast.className.replace('show', '');
    }, 3000);
}

// Prevent form submission on enter (except for textareas)
document.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && e.target.tagName !== 'TEXTAREA' && e.target.type !== 'submit') {
        const form = e.target.closest('form');
        if (form) {
            e.preventDefault();
        }
    }
});

// Handle responsive images - lazy loading
if ('IntersectionObserver' in window) {
    const imageObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                const img = entry.target;
                if (img.dataset.src) {
                    img.src = img.dataset.src;
                    img.removeAttribute('data-src');
                    observer.unobserve(img);
                }
            }
        });
    });
    
    document.querySelectorAll('img[data-src]').forEach(img => {
        imageObserver.observe(img);
    });
}

// Smooth scroll for anchor links
document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
        const href = this.getAttribute('href');
        if (href !== '#' && href.length > 1) {
            e.preventDefault();
            const target = document.querySelector(href);
            if (target) {
                target.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            }
        }
    });
});

// Add loading state to buttons
function addButtonLoadingState(button, isLoading = true) {
    if (isLoading) {
        button.disabled = true;
        button.dataset.originalText = button.innerText;
        button.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Loading...';
    } else {
        button.disabled = false;
        button.innerHTML = button.dataset.originalText || button.innerText;
    }
}

// Handle network errors gracefully
window.addEventListener('online', () => {
    showToast('Connection restored');
});

window.addEventListener('offline', () => {
    showToast('No internet connection');
});

// Debounce function for performance
function debounce(func, wait) {
    let timeout;
    return function executedFunction(...args) {
        const later = () => {
            clearTimeout(timeout);
            func(...args);
        };
        clearTimeout(timeout);
        timeout = setTimeout(later, wait);
    };
}

// Add resize handler with debounce
const handleResize = debounce(() => {
    // Add any resize-specific logic here
    if (window.innerWidth > 768) {
        closeMobileSidebar();
    }
}, 250);

window.addEventListener('resize', handleResize);

// Prevent double submission of forms
document.querySelectorAll('form').forEach(form => {
    form.addEventListener('submit', function() {
        const submitBtn = this.querySelector('button[type="submit"]');
        if (submitBtn && !submitBtn.disabled) {
            addButtonLoadingState(submitBtn, true);
            setTimeout(() => {
                addButtonLoadingState(submitBtn, false);
            }, 5000); // Reset after 5 seconds as fallback
        }
    });
});

// Add touch feedback for mobile
if ('ontouchstart' in window) {
    document.querySelectorAll('.btn, .btn-small, .sidebar-link, .card').forEach(element => {
        element.addEventListener('touchstart', function() {
            this.style.opacity = '0.8';
        });
        element.addEventListener('touchend', function() {
            this.style.opacity = '1';
        });
    });
}

    </script>
   
