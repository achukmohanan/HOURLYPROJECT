<%- include("../../views/partials/user/supportheader") %>
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <title>HOURLY WATCHES | CART</title>
    
    <style>
        /* Base styles for better responsiveness */
        * {
            box-sizing: border-box;
        }

        body {
            overflow-x: hidden;
        }

        .main-content {
            width: 100%;
            padding: 0 15px;
        }

        .container {
            max-width: 100%;
            padding: 0 15px;
        }

        /* Account Section Base Styles */
        .account-section {
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            overflow: hidden;
            margin: 20px 0;
        }

        /* Profile Header */
        .account-header {
            padding: 20px;
            text-align: center;
        }

        .img-div1, .class-img {
            margin-bottom: 15px;
        }

        .img-div1 img, .class-img img {
            border: 3px solid #ddd;
            transition: transform 0.3s;
        }

        .img-div1 img:hover, .class-img img:hover {
            transform: scale(1.05);
        }

        /* Account Content Layout */
        .account-content {
            display: flex;
            min-height: 500px;
        }

        /* Sidebar Styles */
        .sidebar {
            width: 280px;
            background: #f8f9fa;
            padding: 20px 0;
            transition: transform 0.3s ease;
        }

        .sidebar-menu {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .sidebar-menu li {
            margin-bottom: 5px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            padding: 15px 20px;
            color: #333;
            text-decoration: none;
            transition: all 0.3s;
            border-left: 4px solid transparent;
        }

        .sidebar-link:hover {
            background: #e9ecef;
            color: #667eea;
            border-left-color: #667eea;
        }

        .sidebar-link.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-left-color: #764ba2;
        }

        .sidebar-link .icon {
            margin-right: 12px;
            font-size: 18px;
        }

        /* Mobile Sidebar Toggle */
        .mobile-sidebar-toggle {
            display: none;
            background: #f8f9fa;
            padding: 15px 20px;
            border-radius: 10px;
            margin: 15px;
            cursor: pointer;
            align-items: center;
            justify-content: space-between;
        }

        .hambugar-menu {
            width: 30px;
            height: 24px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            cursor: pointer;
            transition: transform 0.3s;
        }

        .hambugar-menu span {
            display: block;
            height: 3px;
            background: #333;
            border-radius: 3px;
            transition: 0.3s;
        }

        .hambugar-menu:hover {
            transform: scale(1.1);
        }

        /* Tab Content */
        .tab-content {
            flex: 1;
            padding: 30px;
            overflow-y: auto;
        }

        .tab-pane {
            display: none;
        }

        .tab-pane.show.active {
            display: block;
            animation: fadeIn 0.5s;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Form Groups */
        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .form-group input {
            width: 100%;
            padding: 12px;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            font-size: 14px;
            transition: border-color 0.3s;
        }

        .form-group input:focus {
            outline: none;
            border-color: #667eea;
        }

        /* Address Card Improvements */
        .address-card {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 20px;
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .address-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .btn-small {
            display: inline-block;
            padding: 8px 16px;
            margin-right: 10px;
            margin-bottom: 5px;
            background: #667eea;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            font-size: 14px;
            transition: background 0.3s;
            border: none;
        }

        .btn-small:hover {
            background: #764ba2;
            color: white;
        }

        .btn-small.delete-btn {
            background: #dc3545;
        }

        .btn-small.delete-btn:hover {
            background: #c82333;
        }

        /* Button Improvements */
        .save-btn, .btn-primary {
            padding: 12px 25px;
            border-radius: 8px;
            font-size: 16px;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .save-btn:hover, .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        /* Table Improvements */
        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border-radius: 10px;
            overflow: hidden;
            margin-top: 20px;
        }

        table th {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 12px;
            text-align: left;
            font-weight: 600;
            font-size: 14px;
        }

        table td {
            padding: 12px;
            border-bottom: 1px solid #e9ecef;
            font-size: 14px;
        }

        table td img {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 6px;
        }

        /* Mobile Card Style for Transaction Table */
        .transaction-card {
            display: none;
            background: white;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 15px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .transaction-card .transaction-header {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
            padding-bottom: 12px;
            border-bottom: 2px solid #e9ecef;
        }

        .transaction-card .transaction-header img {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border-radius: 8px;
            margin-right: 12px;
        }

        .transaction-card .transaction-header .product-name {
            flex: 1;
            font-weight: 600;
            font-size: 14px;
            color: #333;
        }

        .transaction-card .transaction-detail {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            font-size: 13px;
        }

        .transaction-card .transaction-detail .label {
            color: #666;
            font-weight: 500;
        }

        .transaction-card .transaction-detail .value {
            color: #333;
            font-weight: 600;
            text-align: right;
        }

        .transaction-card .transaction-type {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .transaction-card .transaction-type.credit {
            background: #d4edda;
            color: #155724;
        }

        .transaction-card .transaction-type.debit {
            background: #f8d7da;
            color: #721c24;
        }

        /* Coupon Card Improvements */
        .coupon-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .coupon-card button {
            background: white;
            color: #667eea;
            border: none;
            padding: 6px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 16px;
            transition: transform 0.2s;
        }

        .coupon-card button:hover {
            transform: scale(1.1);
        }

        /* Referral Section */
        .Referal {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 25px;
            border-radius: 12px;
            color: white;
            margin-bottom: 20px;
        }

        .innerReferal {
            background: rgba(255,255,255,0.2);
            padding: 15px;
            border-radius: 8px;
            margin-top: 10px;
        }

        #clipboardCopy, #copyCoupon {
            background: white;
            color: #667eea;
            padding: 8px 12px;
            border-radius: 6px;
            font-weight: bold;
            margin: 0 10px;
        }

        /* Toast Notification */
        #toast {
            visibility: hidden;
            min-width: 250px;
            background-color: #333;
            color: white;
            text-align: center;
            border-radius: 8px;
            padding: 16px;
            position: fixed;
            z-index: 1000;
            bottom: 30px;
            right: 30px;
            font-size: 14px;
        }

        #toast.show {
            visibility: visible;
            animation: fadein 0.5s, fadeout 0.5s 2.5s;
        }

        @keyframes fadein {
            from { bottom: 0; opacity: 0; }
            to { bottom: 30px; opacity: 1; }
        }

        @keyframes fadeout {
            from { bottom: 30px; opacity: 1; }
            to { bottom: 0; opacity: 0; }
        }

        /* Pagination Styles */
        nav1 ul {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
            padding: 20px 0;
        }

        nav1 ul li {
            list-style: none;
        }

        nav1 ul li a, nav1 ul li strong {
            display: inline-block;
            padding: 8px 12px;
            background: #667eea;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            transition: background 0.3s;
        }

        nav1 ul li a:hover {
            background: #764ba2;
        }

        /* Card Improvements */
        .card {
            border-radius: 12px;
            transition: transform 0.3s, box-shadow 0.3s;
            overflow: hidden;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }

        .card .img-fluid {
            height: 200px;
            object-fit: cover;
        }

        /* ==================== MOBILE RESPONSIVE STYLES ==================== */

        /* Tablet View (768px - 991px) */
        @media (max-width: 991px) {
            .tab-content {
                padding: 25px 20px;
            }
            
            .sidebar {
                width: 250px;
            }
            
            table {
                font-size: 13px;
            }
            
            table th, table td {
                padding: 10px 8px;
            }
        }

        /* Mobile View (max-width: 768px) */
        @media (max-width: 768px) {
            /* Show mobile toggle */
            .mobile-sidebar-toggle {
                display: flex !important;
            }
            
            /* Account Content Stack */
            .account-content {
                flex-direction: column;
                position: relative;
            }
            
            /* Sidebar Mobile */
            .sidebar {
                position: fixed;
                left: -280px;
                top: 0;
                height: 100vh;
                z-index: 1000;
                width: 280px;
                box-shadow: 2px 0 10px rgba(0,0,0,0.1);
                overflow-y: auto;
            }
            
            .sidebar.show {
                transform: translateX(280px);
            }
            
            /* Overlay when sidebar is open */
            .sidebar.show::before {
                content: '';
                position: fixed;
                top: 0;
                left: 280px;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.5);
                z-index: -1;
            }
            
            /* Tab Content Mobile */
            .tab-content {
                padding: 20px 15px;
                width: 100%;
            }
            
            .tab-content h2 {
                font-size: 24px;
                margin-bottom: 15px;
            }
            
            /* Form Groups Mobile */
            .form-group1 {
                margin-bottom: 15px;
            }
            
            /* Buttons Full Width on Mobile */
            .btn, .save-btn {
                width: 100%;
                margin: 5px 0 !important;
                padding: 12px;
            }
            
            .btn-small {
                display: inline-block;
                width: auto;
                margin: 5px 5px 5px 0;
            }
            
            /* Address Cards Mobile */
            .address-card {
                padding: 15px;
                margin-bottom: 15px;
            }
            
            /* Order Cards Mobile */
            .card .img-fluid {
                height: 180px;
            }
            
            /* Transaction Table Mobile - Switch to Card View */
            .table-responsive table {
                display: none;
            }
            
            .transaction-card {
                display: block !important;
            }
            
            /* Coupon Cards Mobile */
            .coupon-card {
                padding: 15px;
                margin-bottom: 10px;
            }
            
            /* Referral Section Mobile */
            .Referal {
                padding: 20px 15px;
            }
            
            .innerReferal {
                padding: 12px;
            }
            
            #clipboardCopy, #copyCoupon {
                padding: 6px 10px;
                margin: 5px;
                display: inline-block;
            }
            
            /* Pagination Mobile */
            nav1 ul {
                gap: 5px;
                padding: 15px 0;
            }
            
            nav1 ul li a, nav1 ul li strong {
                padding: 6px 10px;
                font-size: 12px;
            }
            
            /* Toast Mobile */
            #toast {
                min-width: 200px;
                right: 15px;
                left: 15px;
                bottom: 20px;
            }
            
            /* Profile Header Mobile */
            .account-header {
                padding: 15px;
            }
            
            .img-div1 img, .class-img img {
                width: 80px !important;
                height: 80px !important;
            }
        }

        /* Extra Small Mobile (max-width: 576px) */
        @media (max-width: 576px) {
            .main-content {
                padding: 0 10px;
            }
            
            .tab-content {
                padding: 15px 10px;
            }
            
            .tab-content h2 {
                font-size: 20px;
            }
            
            /* Make all columns full width */
            .col-lg-6, .col-md-6 {
                margin-bottom: 15px;
            }
            
            /* Card adjustments */
            .card .img-fluid {
                height: 150px;
            }
            
            .card-body {
                padding: 15px;
            }
            
            .card-title {
                font-size: 16px;
            }
            
            /* Transaction cards smaller */
            .transaction-card {
                padding: 12px;
            }
            
            .transaction-card .transaction-header img {
                width: 50px;
                height: 50px;
            }
            
            .transaction-card .transaction-detail {
                font-size: 12px;
                padding: 6px 0;
            }
            
            /* Sidebar narrower */
            .sidebar {
                width: 260px;
                left: -260px;
            }
            
            .sidebar.show {
                transform: translateX(260px);
            }
            
            /* Buttons smaller */
            .btn, .save-btn {
                font-size: 14px;
                padding: 10px;
            }
            
            .btn-small {
                font-size: 12px;
                padding: 6px 12px;
            }
            
            /* Form inputs */
            .form-group input {
                font-size: 14px;
                padding: 10px;
            }
            
            /* Coupon cards smaller */
            .coupon-card {
                padding: 12px;
            }
            
            .coupon-card small {
                font-size: 11px;
            }
            
            /* Referral section */
            .Referal h2 {
                font-size: 18px;
            }
            
            .innerReferal h5 {
                font-size: 14px;
            }
            
            #clipboardCopy, #copyCoupon {
                font-size: 12px;
                padding: 5px 8px;
            }
        }

        /* Landscape Mobile */
        @media (max-width: 768px) and (orientation: landscape) {
            .sidebar {
                height: 100vh;
                overflow-y: auto;
            }
            
            .tab-content {
                max-height: calc(100vh - 60px);
                overflow-y: auto;
            }
        }

        /* Print Styles */
        @media print {
            .sidebar, .mobile-sidebar-toggle, .btn, .save-btn, #toast {
                display: none !important;
            }
            
            .tab-content {
                padding: 0;
            }
            
            .account-content {
                flex-direction: column;
            }
        }
    </style>
</head>
<body data-user-id="<%= user._id %>">
 <main class="main-content">
        <div class="container">
            <section class="account-section">
                <% if(user.profileUrl){%>
                <div class="img-div1  d-flex justify-content-center"> 
                   <a href="/edit-profile">
                    <img src="<%=user.profileUrl  %>" alt="Profile Image" class="rounded-circle " width="100">
                   </a> 
                </div>
                <%}else{%>
                    <div class="class-img d-flex justify-content-center">
                        <a href="/edit-profile"> 
                            <img src="/assets/img/gallery/placeholderforimg.jpg" class="img-div" alt="testing profile pic">
                        </a>
                    </div>
                    <%}
                      %>
                      <h6 class="text-muted mx-5" >Hi ,<%= user.name %></h6>
                <div class="account-header d-flex  flex-column align-items-center     m-2"> 
                    <h5 class="text"><%= user.name %></h5>
                    <p><strong>Joined On: </strong><%= new Date(user.createdOn).toLocaleDateString('en-IN')%></p>
                </div>
                <div class="account-content">
                        <!-- mobileview -->
                        <div class="mobile-sidebar-toggle d-md-none d-flex justify-content-between align-items-center mb-3 px-2">
                            <h5 class="mb-0">MENU</h5>
                            <div id="sidebarToggle" class="hambugar-menu">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                        </div>

                    <!-- Sidebar -->
                     
                    <aside class="sidebar" id="sidebarMenu">    
                        <ul class="sidebar-menu">
                            <li>
                                <a href="#" class="sidebar-link active" data-tab="account">
                                    <span class="icon">👤</span>
                                    Account
                                </a>
                            </li>
                            <li>
                                <a href="#" class="sidebar-link" data-tab="address">
                                    <span class="icon">🏠</span>
                                    Address
                                </a>
                            </li>
                            <li>
                                <a href="#" class="sidebar-link" data-tab="orders">
                                    <span class="icon">📋</span>
                                    Orders
                                </a>
                            </li>
                            <li>
                                <a href="#" class="sidebar-link" data-tab="password">
                                    <span class="icon">🔒</span>
                                    Password
                                </a>
                            </li>
                            <li>
                                <a href="#" class="sidebar-link" data-tab="referral">
                                    <span class="icon">👥</span>
                                   Referral 
                                </a>
                            </li>
                            <li>
                                <a href="#" class="sidebar-link" data-tab="coupon">
                                    <span class="icon">✉️</span>
                                   Coupon 
                                </a>
                            </li>
                            <li>
                                <a href="#" class="sidebar-link" data-tab="wallet">
                                    <span class="icon">💳</span>
                                    Wallet
                                </a>
                            </li>
                            <li>
                                <a href="/logout">
                                    <span class="icon">🚪</span>
                                    Logout
                                </a>
                            </li>
                        </ul>
                    </aside>
               <!-- Tab content -->
                    <div class="tab-content">
                        <!-- Account Tab -->
                        <div class="tab-pane show active" id="account">
                            <h2>Account Information</h2>
                            <div class="row">
                                <div class="form-group1 col-lg-6">
                                    <div class="form-group p-2">
                                       <% if(user){%>
                                        <label for="firstName" class="mx-3  "> USERNAME</label>
                                        <label   class="mx-3 text-dark text-muted"  ><%= user.name %></label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group p-2 ">
                                        <label class="mx-3 ">GENDER</label>
                                        <% if(user.gender){%>
                                        <label class="text-muted mx-3"> <%=user.gender %> </label>
                                        <%}else{%>
                                        <label class="text-muted mx-3"> Not Specified </label>
                                        <%}%>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                            <div class="form-group1   col-lg-6">
                                <div class="form-group p-2">
                                <label for="email" class="mx-3  ">EMAIL ADDRESS</label>
                                <label class="mx-3 text-dark text-muted"><%= user.email %></label>
                                </div>
                            </div>
                            <div class="form-group1 col-lg-6">
                                <div class="form-group p-2">
                                <label class="mx-3" >PHONE NUMBER</label>
                                <%if (user.phone){%>
                                <label class="text-muted mx-3" ><%=user.phone %></label>
                                <%}else{%>
                                    <label class="text-muted mx-3" >Not added</label>
                               <% }%>
                            </div>
                            </div>
                            <%}%>
                            </div>
                            <div class="row">
                                <div class="col-md-6 col-12 mb-2">
                                    <a href="/edit-profile" class="btn btn-primary w-100">Edit Profile</a>
                                </div>
                                <div class="col-md-6 col-12">
                                    <a href="/verifyCurrentEmail" class="btn btn-primary w-100">Edit Email</a>
                                </div>
                            </div>
                        </div>

                        <!-- Address Tab -->
                          
                        <div class="tab-pane" id="address">                   
                            <div class="row">                                                 
                              <% if(userAddress  && userAddress.address &&  userAddress.address.length>0 ) { %>
                                    <% userAddress.address.forEach((address) => { %>
                                        <div class="col-lg-6 ">
                                            <div class="address-card p-3">
                                                <div class="card-header">
                                                    <h5><%= address.addressType %></h5>
                                                </div>
                                                <div class="card-body">
                                                    <address>
                                                      <h4>Name:  <%= address.name %><br></h4>
                                                     <h6>City:   <%= address.city %><br></h6>
                                                      <h6>LandMark : <%= address.landMark %><br></h6>
                                                       <h6>State: <%= address.state %><br></h6>
                                                       <p>Pincode: <%= address.pincode %><br></p>
                                                       <p>Phone:  <%= address.phone %><br></p>
                                                       <p> Alt Phone <%= address.altPhone %></p>
                                                     
                                                    </address>
                                                    <div class="d-flex flex-wrap">
                                                        <a href="/editAddress?id=<%= address._id %>" class="btn-small">Edit</a>

                                                        <a href="#" class="btn-small delete-btn" data-id="<%= address._id %>">Delete</a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                       <div class="d-flex justify-content-center">
                                        <i class="fa-solid fa-map-location-dot fa-3x mb-3" style="color: #6c5dd3;"></i>
                                     
                                    <address>No address</address>
                                       </div>               
                                    
                                <% } %>

                            </div>
                            <div class="mt-4 d-flex justify-content-center">
                                <a href="/addAddress" class="btn btn-primary">Add New Address</a>
                            </div>
                        </div>

                        <!-- Orders Tab -->
                         
                    <div class="tab-pane" id="orders">
                        <hr>
                            <h2>Your Orders</h2>
                            <hr>
                            <div class="row">
