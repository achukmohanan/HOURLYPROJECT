                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                        </div>

                    <!-- Sidebar -->
                     
                    <aside class="sidebar" id="sidebarMenu">    
                        <ul class="sidebar-menu">
                            <li>
                                <a href="#" class="sidebar-link active" data-tab="account">
                                    <span class="icon">👤</span>
                                    Account
                                </a>
                            </li>
                            <li>
                                <a href="#" class="sidebar-link" data-tab="address">
                                    <span class="icon">🏠</span>
                                    Address
                                </a>
                            </li>
                            <li>
                                <a href="#" class="sidebar-link" data-tab="orders">
                                    <span class="icon">📋</span>
                                    Orders
                                </a>
                            </li>
                            <li>
                                <a href="#" class="sidebar-link" data-tab="password">
                                    <span class="icon">🔒</span>
                                    Password
                                </a>
                            </li>
                            <li>
                                <!-- <a href="#" class="sidebar-link" data-tab="email">
                                    <span class="icon">✉️</span>
                                    Account Email
                                </a> -->
                            </li>
                            <li>
                                <a href="#" class="sidebar-link" data-tab="wallet">
                                    <span class="icon">💳</span>
                                    Wallet
                                </a>
                            </li>
                            <li>
                                <a href="/logout">
                                    <span class="icon">🚪</span>
                                    Logout
                                </a>
                            </li>
                        </ul>
                    </aside>
               <!-- Tab content -->
                    <div class="tab-content">
                        <!-- Account Tab -->
                        <div class="tab-pane show active" id="account">
                            <h2>Account Information</h2>
                            <div class="row">
                                <div class="form-group1 col-lg-6">
                                    <div class="form-group p-2">
                                       <% if(user){%>
                                        <label for="firstName" class="mx-3  "> USERNAME</label>
                                        <label   class="mx-3 text-dark text-muted"  ><%= user.name %></label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group p-2 ">
                                        <label class="mx-3 ">GENDER</label>
                                        <% if(user.gender){%>
                                        <label class="text-muted mx-3"> <%=user.gender %> </label>
                                        <%}else{%>
                                        <label class="text-muted mx-3"> Not Specified </label>
                                        <%}%>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                            <div class="form-group1   col-lg-6">
                                <div class="form-group p-2">
                                <label for="email" class="mx-3  ">EMAIL ADDRESS</label>
                                <label class="mx-3 text-dark text-muted"><%= user.email %></label>
                                </div>
                            </div>
                            <div class="form-group1 col-lg-6">
                                <div class="form-group p-2">
                                <label class="mx-3" >PHONE NUMBER</label>
                                <%if (user.phone){%>
                                <label class="text-muted mx-3" ><%=user.phone %></label>
                                <%}else{%>
                                    <label class="text-muted mx-3" >Not added</label>
                               <% }%>
                            </div>
                            </div>
                            <%}%>
                            </div>
                            <a href="/edit-profile" class="btn btn-primary"> Edit Profile </a>
                            <a href="/verifyCurrentEmail" class="btn btn-primary mx-5"> Edit Email </a>
                            <!-- <button class="save-btn">Edit Profile</button> -->
                        </div>

                        <!-- Address Tab -->
                          
                        <div class="tab-pane" id="address">                   
                            <div class="row">                                                 
                              <% if(userAddress  && userAddress.address &&  userAddress.address.length>0 ) { %>
                                    <% userAddress.address.forEach((address) => { %>
                                        <div class="col-lg-6 ">
                                            <div class="address-card p-3">
                                                <div class="card-header">
                                                    <h5><%= address.addressType %></h5>
                                                </div>
                                                <div class="card-body">
                                                    <address>
                                                      <h4>Name:  <%= address.name %><br></h4>
                                                     <h6>City:   <%= address.city %><br></h6>
                                                      <h6>LandMark : <%= address.landMark %><br></h6>
                                                       <h6>State: <%= address.state %><br></h6>
                                                       <p>Pincode: <%= address.pincode %><br></p>
                                                       <p>Phone:  <%= address.phone %><br></p>
                                                       <p> Alt Phone <%= address.altPhone %></p>
                                                     
                                                    </address>
                                                    <div class="d-flex">
                                                        <a href="/editAddress?id=<%= address._id %>" class="btn-small">Edit</a>

                                                        <a href="#" class="btn-small delete-btn" data-id="<%= address._id %>">Delete</a>

                                                        <!-- <a href="/deleteAddress?id=<%=address._id %>" class="btn-small" onclick="return confirm('Are you sure you want delete this address')" >Delete</a> -->
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                       <div class="d-flex justify-content-center">
                                        <i class="fa-solid fa-map-location-dot fa-3x mb-3" style="color: #6c5dd3;"></i>
                                     
                                    <address>No address</address>
                                       </div>               
                                    
                                <% } %>

                            </div>
                            <div class="mt-4 d-flex justify-content-center">
                                <a href="/addAddress" class="btn btn-primary">Add New Address</a>
                            </div>
                        </div>

                        <!-- Orders Tab -->
                         
                        <div class="tab-pane" id="orders">
                            <hr>
  <h2>Your Orders</h2>
  <hr>
  <div class="row">
    <% if(orders.length <= 0){ %>
      <p>No Orders</p>
    <% } else { %>
       
      <% orders.forEach(order => { %>
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="card shadow border-0 rounded-3">
            <div class="card-body">
                 
                <img class="img-fluid" src="<%= order.orderedItems[0].product.productImage[0] %>" alt="">
              <!-- Order Id / Product -->
              <h5 class="card-title">
                <%= order.orderedItems[0].product.productName %>
              </h5>

              <!-- Date -->
              <p class="card-text mb-1">
                <strong>Date:</strong> <%= order.createdOn.toLocaleDateString() %>
              </p>

              <!-- Status -->
              <p class="card-text mb-1">
                <strong>Status:</strong> 
                <span class="badge bg-success"><%= order.status %></span>
              </p>

              <!-- Total -->
              <p class="card-text mb-3">
                <strong>Total:</strong> 
                <%= order.totalPrice.toLocaleString('en-IN', { style: 'currency', currency: 'INR' }) %>
              </p>

              <!-- Actions -->
              <a href="/viewOrderDetails/<%=order.orderId%>" class="btn btn-sm btn-primary me-2">View</a>
              <!-- <a href="#" class="btn btn-sm btn-outline-secondary">Track</a> -->
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>


                        <!-- Password Tab -->
                        <div class="tab-pane" id="password">
                            <h2>Change Password</h2>
                            <form id="changePassword" >
                            <div class="form-group">         
                                <label for="currentPassword">Current Password</label>
                                <input type="password" id="currentPassword" name="currentPassword" placeholder="Enter current password" required>
                            </div>
                            <div class="form-group">
                                <label for="newPassword">New Password</label>
                                <input type="password" id="newPassword" name="newPassword" placeholder="Enter new password" required>
                            </div>
                            <div class="form-group">
                                <label for="confirmPassword">Confirm Password</label>
                                <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm new password" required>
                            </div>
                            <button type="submit" class="save-btn">Update Password</button>
                             </form>
                        </div>

                        <!-- Email Tab -->
                        <!-- <div class="tab-pane" id="email">
                            <h2>Account Email</h2>
                            <div class="form-group">
                                <label for="currentEmail">Current Email</label>
                                <input type="email" id="currentEmail" name="currentEmail" placeholder="current@email.com" readonly>
                            </div>
                            <div class="form-group">
                                <label for="newEmail">New Email</label>
                                <input type="email" id="newEmail" name="newEmail" placeholder="Enter new email">
                            </div>
                            <button class="save-btn">Update Email</button>
                        </div> -->

                        <!-- Wallet Tab -->
                        <div class="tab-pane" id="wallet">
                            <h2>Wallet</h2>
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title">Current Balance</h5>
                                    <h3 class="text-success"><%= user.wallet.toLocaleString('en-IN',{style:'currency',currency:'INR'})   %></h3>
                                    <button class="btn btn-primary mt-3" id="walletButton" >Add Money</button>
                                </div>
                            </div>
                            <div class="mt-4">
                                 <table>
                                <h5>Transaction History</h5>
                                    <tr>
                                        <th>OrderId</th>
                                        <th>Product Name</th>
                                        <th>Type</th>
                                        <th>Amount</th>
                                        <th>paymentMethod</th>
                                        <th>Description</th>
                                        <th>Date</th>
                                    </tr>
                                     <% if(transaction ){ %>
                                    <% transaction.forEach(txn=>{ %>
                                    <tr>   
                                        <td><%= txn.orderId  %></td>
                                        <%if(txn.orderDetails && txn.orderDetails.orderedItems ){ %>
                                        <% txn.orderDetails.orderedItems.forEach(i=>{ %>
                                        <td><img class="p-2" src="<%= i.product.productImage[0] %>" alt="">
                                        <%= i.product?.productName ? i.product.productName : 'No product'%></td>
                                        <% }) %>
                                        <% } %>
                                        <td class="<%= txn.type ==='Credit' ? 'text-success' :'text-danger' %>"><%= txn.type %></td>
                                        <td><%= txn.amount %></td>
                                        <td><%= txn.paymentMethod %></td>
                                        <td><%= txn.description %></td> 
                                      <td> <%= new Date(txn.date).toLocaleString("en-IN", {
                                                        day: "2-digit",
                                                        month: "2-digit",
                                                        year: "numeric",
                                                    
                                                        hour: "2-digit",
                                                        minute: "2-digit",
                                                        second: "2-digit"
                                                    }) %>
                                                    </td>
                                    </tr>
                              
                                <% }) %>
                                <% } else {%>
                                    No transaction Found
                                <% } %>
                                  </table>
                                  <!-- 🔹 Pagination Controls -->
                                <div style="margin-top: 20px;">
                                <% if (pagination.totalPages > 1) { %>
                                    <nav1>
                                    <ul style="display: flex; list-style: none; gap: 8px;">

                                        <!-- Prev -->
                                <% if (pagination.page > 1) { %>
                                <li>
                                    <a href="?tab=wallet&page=<%= pagination.page - 1 %>">⬅ Prev</a>
                                </li>
                                <% } %>

                                <!-- Pages -->
                                <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                                <li>
                                    <% if (i === pagination.page) { %>
                                    <strong>[<%= i %>]</strong>
                                    <% } else { %>
                                    <a href="?tab=wallet&page=<%= i %>"><%= i %></a>
                                    <% } %>
                                </li>
                                <% } %>

                                <!-- Next -->
                                <% if (pagination.page < pagination.totalPages) { %>
                                <li>
                                    <a href="?tab=wallet&page=<%= pagination.page + 1 %>">Next ➡</a>
                                </li>
                                <% } %>

                                    </ul>
                                    </nav1>
                                <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

     <!-- <%- include("../../views/partials/user/supportfooter") %>   -->
 
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
     <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
     <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script>
       
 document.addEventListener('DOMContentLoaded',()=>{
    const urlParams = new URLSearchParams(window.location.search);
    const tab = urlParams.get('tab');
    if(tab){
        document.querySelectorAll('.sidebar-link').forEach(l=>l.classList.remove('active'));
        document.querySelectorAll('.tab-pane').forEach(p=>p.classList.remove('show','active'));
       
        const targestLink = document.querySelector(`.sidebar-link[data-tab="${tab}"]`);
        const targestpane = document.getElementById(tab)
        
        if(targestLink && targestpane){
            targestLink.classList.add('active');
            targestpane.classList.add('show','active')
        }
    }
 })
        // Mobile menu toggle
        const hamburger = document.getElementById('hamburger');
        const navLinks = document.getElementById('navLinks');

        if (hamburger) {
            hamburger.addEventListener('click', () => {
                hamburger.classList.toggle('active');
                navLinks.classList.toggle('active');
            });
        }

        // Close mobile menu when clicking on a link
        document.querySelectorAll('.nav-links a').forEach(link => {
            link.addEventListener('click', () => {
                if (hamburger) {
                    hamburger.classList.remove('active');
                    navLinks.classList.remove('active');
                }
            });
        });

        // Tab functionality
        document.querySelectorAll('.sidebar-link').forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                
                const targetTab = link.getAttribute('data-tab');
                
                // Remove active class from all sidebar links
                document.querySelectorAll('.sidebar-link').forEach(l => l.classList.remove('active'));
                
                // Add active class to clicked link
                link.classList.add('active');
                
                // Hide all tab panes
                document.querySelectorAll('.tab-pane').forEach(pane => {
                    pane.classList.remove('show', 'active');
                });
                
                // Show target tab pane
                const targetPane = document.getElementById(targetTab);
                if (targetPane) {
                    targetPane.classList.add('show', 'active');
                }
            });
        });

       document.addEventListener('DOMContentLoaded',()=>{
    const urlParams = new URLSearchParams(window.location.search);
    const tab = urlParams.get('tab');
    if(tab){
        document.querySelectorAll('.sidebar-link').forEach(l=>l.classList.remove('active'));
        document.querySelectorAll('.tab-pane').forEach(p=>p.classList.remove('show','active'));

        const targetLink = document.querySelector(`.sidebar-link[data-tab="${tab}"]`);
        const targetPane = document.getElementById(tab);
        
        if(targetLink && targetPane){
            targetLink.classList.add('active');
            targetPane.classList.add('show','active');
        }
    }
})

       
// <--------address deletion---------------->
        document.addEventListener('DOMContentLoaded',function (){
            const deleteButtons = document.querySelectorAll('.delete-btn');

            deleteButtons.forEach(button => {
              button.addEventListener('click',function(e){
                    e.preventDefault();

                    const addressId = this.getAttribute('data-id');

                      Swal.fire({
                            title: 'Are you sure?',
                            text: "Do you really want to delete this address?",
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#d33',
                            cancelButtonColor: '#3085d6',
                            confirmButtonText: 'Yes, delete it!'
                         }).then((result)=>{
                            if(result.isConfirmed){
                                fetch(`/deleteAddress?id=${addressId}`,{
                                    method:'GET'
                                })
                                .then(response => response.json())
                                .then(data =>{
                                    if(data.message === "Address Delected Successfully"){
                                        Swal.fire(
                                            'Deleted!',
                                            'Your address has been deleted.',
                                            'success'
                                        ).then(()=>{
                                            window.location.reload()
                                        });
                                    }else{
                                        Swal.fire('Error',data.message || "Something Went Wrong");
                                    }
                                })
                                .catch(error =>{
                                    console.log("error in fetch in deleteing address");
                                    Swal.fire('Error', 'Server error occurred.', 'error');;
                                });
                            }
                         });
                });
            });
        });

        // <---------------fetch for change password ----------------->

             // Form validation for password change
        // document.getElementById('newPassword')?.addEventListener('blur', function() {
        //     const confirmPassword = document.getElementById('confirmPassword');
        //     if (confirmPassword.value && this.value !== confirmPassword.value) {
        //         confirmPassword.setCustomValidity('Passwords do notd match');
        //     } else {
        //         confirmPassword.setCustomValidity('');
        //     }
        // });

        // document.getElementById('confirmPassword')?.addEventListener('input', function() {
        //     const newPassword = document.getElementById('newPassword');
        //     if (this.value !== newPassword.value) {
        //         this.setCustomValidity('Passwords do not vqxkuhvgkumatch');
        //     } else {
        //         this.setCustomValidity('');
        //     }
        // });

            document.getElementById('changePassword').addEventListener('submit', async (e)=>{
                e.preventDefault();

               try {
                 const currentPassword = document.getElementById('currentPassword').value.trim();
                const newPassword = document.getElementById('newPassword').value.trim();
                const confirmPassword = document.getElementById('confirmPassword').value.trim();

                if(newPassword !== confirmPassword){
                    Swal.fire({
                        icon:'error',
                        title:"Oops",
                        text:"Password do not Match",
                        showConfrimButton:true
                    })
                }

                const data = await fetch('/changePassword',{
                    method:'POST',
                    headers:{
                        'Content-Type':'application/json'
                    },
                    body:JSON.stringify({currentPassword,newPassword,confirmPassword})
                })

                const response = await data.json();

                if(response.success){
                    Swal.fire({
                        icon:'success',
                        title:'Success',
                        text:response.message
                    }).then(()=>{
                        window.location.reload();
                    })
                }else{
                    Swal.fire({
                        icon:'error',
                        title:'Oops',
                        text:response.message
                    })
                }
               } catch (error) {
                console.log("error in fecth",error)
                        Swal.fire({
                        icon:'error',
                        title:'ERROR',
                        text:response.message
                    })
               }
            })
      
      
      
      
            // mobileview toggle
                document.getElementById('sidebarToggle')?.addEventListener('click', ()=>{
                    const sidebar = document.getElementById('sidebarMenu')
                    sidebar.classList.toggle('show')
                })
               document.querySelectorAll('.sidebar-link').forEach(link => {
    link.addEventListener('click', () => {
        const sidebar = document.getElementById('sidebarMenu');
        if (window.innerWidth <= 768) {
            sidebar.classList.remove('show');
        }
    });
});

// ---------------------------add money to wallet -----------------------------
    document.getElementById('walletButton').addEventListener('click',async()=>{
        const {value:amount} = await Swal.fire({
            title:"ADD MONEY TO WALLET",
            input:'number',
            inputLabel:'Enter amount in rs',
            inputPlaceholder:"Eg: 500",
            showCancelButton:true,
            confirmButtonText:'ADD',
            cancelButtonText:'Cancel',
            inputValidator:(value)=>{
                if(!value || value<=0){
                    return "Please Enter a Valid Amount";
                }
            }
        });

        if(amount){
            const userId = '<%= user._id%>';
            try { 
                
                const response = await fetch('/wallet-top-up',{
                    method:'POST',
                    headers:{
                        'Content-Type':'application/json'
                    },
                    body:JSON.stringify({userId,amount})
                });
               
                    const data = await response.json()
     
                    if(!data.orderId){
                        Swal.fire('Error','Something Went Wrong ,Please try again')
                    }
                     
                    var options = {
                        'key' : data.key,
                        'amount':data.amount,
                        'currency':'INR',
                        'name':'HOURLY WATCHES',
                        'description':'Add to Wallet',
                        'order_id':data.orderId,
                        'handler':function(response){
                            fetch('/verify-wallet-topup',{
                                method:'POST',
                                headers:{
                                    'Content-Type':'application/json'
                                },
                                body:JSON.stringify({...response,amount,userId})
                            })
                            .then(res => {
                                 if(!res.ok){
                                throw new Error("Network response was not ok")
                                 } 
                                 return res.json();
                            })
                            .then(result =>{
                                
                                if(result.success){
                                    Swal.fire('Success',"Money Added To wallet",'success').then(()=>{
                                        window.location.reload()
                                    })
                                }else{
                                    Swal.fire('Failed','Payment Verification Failed','error')
                                }
                              })
                              .catch(err =>{
                                        console.error("Error in verify-wallet-topup:", err);
                                        Swal.fire("OOPS","Something Went Wrong in verification",'error');
                                    });
                        },
                        // 'theme':{'color':'#3399cc'}
                    };
                    var rzp1 = new Razorpay(options);
                    rzp1.open();

            } catch (error) {
                console.log("errror in the razorpay verification",error);
                Swal.fire("OoOPS","Something Went Wrong",'error')
                
            }
        }
        
    });  

    </script>
   
</body>
</html>