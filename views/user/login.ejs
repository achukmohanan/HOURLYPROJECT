<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>HOURLY | LOGIN</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: linear-gradient(to right, #c0f0e5, #e1f4f7);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 15px;
    }

    .login-container {
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
      display: flex;
      flex-direction: row;  /* always side by side by default */
      width: 100%;
      max-width: 900px;
      overflow: hidden;
    }

    .left-section {
      flex: 1;
      padding: 30px;
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    .left-section h2 {
      font-size: 28px;
      font-weight: bold;
      text-align: center;
    }

    .google-login {
      padding: 10px;
      background: rgb(239, 236, 236);
      border: 1px solid #ccc;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      border-radius: 6px;
    }

    .divider {
      text-align: center;
      position: relative;
    }

    .divider span {
      background: white;
      padding: 0 10px;
      position: relative;
      z-index: 1;
    }

    .divider::before {
      content: "";
      position: absolute;
      top: 50%;
      width: 100%;
      height: 1px;
      background: #ccc;
      left: 0;
      z-index: 0;
    }

    input {
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
      width: 100%;
    }

    .login-btn {
      padding: 10px;
      background: #4b4ded;
      color: white;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 16px;
    }

    .login-btn:hover {
      background: #3737d6;
    }

    a {
      text-decoration: none;
      font-size: 14px;
      color: #4b4ded;
    }

    .forgotpass:hover {
      color: rgb(53, 47, 226);
      text-decoration: underline;
    }

    .right-section {
      flex: 1;
      padding: 30px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      background: #ffffff;
    }

    .watch img {
      max-width: 220px;
      width: 100%;
      height: auto;
    }

    /* Responsive tweaks */
    @media (max-width: 768px) {
      .login-container {
        flex-direction: column; /* stack vertically */
        text-align: center;
      }

      .left-section, .right-section {
        padding: 20px;
      }

      .left-section h2 {
        font-size: 24px;
      }

      .google-login {
        font-size: 14px;
      }
    }
  </style>
</head>
<body>
  <form method="post" action="/login">
    <div class="login-container">
      <!-- Left: Login Form -->
      <div class="left-section">
        <h2>Welcome!</h2> 
        <a class="google-login" href="/auth/google">
          <img src="assets/img/gallery/google.png" width="20" alt="Google Logo"/>
          Login with Google
        </a>
        <div class="divider"><span>or</span></div>
        <input type="email" name="email" placeholder="Email" required />
        <input type="password" name="password" placeholder="Password" required />

        <% if (locals.message && locals.message.length > 0) { %>
          <div class="alert alert-danger text-center">
            <%= locals.message %>
          </div>
        <% } %>

        <a href="/forgotpassword" class="forgotpass">Forgot password?</a>  
        <button class="login-btn">Login</button>
        <p>New User? <a href="/signup">Sign up now..!</a></p>
      </div>

      <!-- Right: Logo/Icon -->
      <div class="right-section">
        <div class="watch">
          <img src="assets/img/gallery/HourlyYours.png" alt="HOURLY Logo" class="rounded-4">
        </div>
      </div>
    </div>
  </form>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const params = new URLSearchParams(window.location.search);
    if(params.get('blocked')==="true"){
      Swal.fire({
        icon:"error",
        title:"Blocked",
        text:"You were blocked by Admin",
        confirmButtonText:"OK"
      })
    }
  </script>
</body>
</html>
