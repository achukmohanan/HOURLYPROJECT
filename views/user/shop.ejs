<%- include("../../views/partials/user/supportheader") %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
  
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    .main-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 15px;
      margin-top: 30px;
    }
    
    .shop-topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 15px;
    }

    .search-form {
      display: flex;
      align-items: center;
      background-color: #f1f1f1;
      border-radius: 25px;
      overflow: hidden;
      width: 100%;
      max-width: 300px;
      box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
    }

    .search-input {
      flex: 1;
      padding: 10px 15px;
      font-size: 14px;
      border: none;
      outline: none;
      background-color: transparent;
      min-width: 0;
    }

    .search-button {
      padding: 10px 20px;
      background-color: #1e918b;
      color: #fff;
      border: none;
      cursor: pointer;
      font-size: 14px;
      border-radius: 15px;
      margin-right: 5px;
      transition: background-color 0.3s, transform 0.2s;
      white-space: nowrap;
    }

    .search-button:hover {
      background-color: #0056b3;
      transform: scale(1.05);
    }

    .sidebar {
      flex-shrink: 0;
      width: 280px;
      padding: 20px;
      border: 1px solid #ddd;
      background-color: #f9f9f9;
      border-radius: 8px;
      height: fit-content;
      position: sticky;
      top: 100px;
    }

    .filter-section {
      margin-bottom: 20px;
    }

    .filter-title {
      font-weight: bold;
      margin-bottom: 15px;
      font-size: 18px;
      color: #333;
    }

    .filter-item {
      margin: 8px 0;
    }

    .filter-item a {
      text-decoration: none;
      color: #333;
      padding: 5px 0;
      display: block;
      transition: color 0.3s;
    }

    .filter-item a:hover {
      color: #007bff;
    }

    .product-list-container {
      display: flex;
      gap: 30px;
      align-items: flex-start;
    }

    .product-grid {
      display: grid;
      flex: 1;
      gap: 25px;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    }

    .product-card {
      border: 1px solid #cebfbf;
      padding: 20px;
      border-radius: 12px;
      text-align: center;
      position: relative;
      transition: all 0.3s ease-in-out;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .product-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
      background-color: #f9f9f9;
    }

    .product-card img {
      width: 100%;
      height: 200px;
      border-radius: 8px;
      object-fit: cover;
      transition: transform 0.3s ease;
    }

    .product-card a {
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: inherit;
    }

    .product-card h4 {
      margin: 15px 0 10px 0;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
      min-height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .product-card p {
      margin: 5px 0;
      font-size: 14px;
    }

    .wishlist-btn {
      position: absolute;
      top: 15px;
      right: 15px;
      background-color: rgba(237, 247, 247, 0.9);
      color: #fff;
      padding: 8px;
      border-radius: 50%;
      cursor: pointer;
      transition: transform 0.3s;
      z-index: 10;
    }

    .wishlist-btn:hover {
      transform: scale(1.1);
    }

    .add-to-cart-btn {
      background-color: #46698f;
      color: #fff;
      padding: 12px;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      width: 100%;
      margin-top: 15px;
      transition: background-color 0.3s;
      font-weight: 500;
    }

    .add-to-cart-btn:hover {
      background-color: #218838;
    }

    .pagination {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin: 40px 0;
      flex-wrap: wrap;
    }

    .pagination a {
      padding: 10px 15px;
      background-color: #f0f0f0;
      border: 1px solid #ddd;
      color: #333;
      text-decoration: none;
      border-radius: 5px;
      transition: all 0.3s;
    }

    .pagination a:hover {
      background-color: #007bff;
      color: #fff;
    }

    .pagination .active {
      background-color: #007bff;
      color: #fff;
    }

    .price-filter {
      padding: 15px;
      background-color: #f9f9f9;
      border-radius: 8px;
      margin-top: 20px;
    }

    .price-filter .price-options {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .price-button {
      padding: 12px 20px;
      background-color: #f1f1f1;
      color: #333;
      border: 1px solid #ddd;
      border-radius: 30px;
      cursor: pointer;
      transition: all 0.3s;
      text-align: center;
      font-size: 14px;
      font-weight: 500;
    }

    .price-button:hover {
      background-color: #007bff;
      color: white;
      transform: translateY(-2px);
    }

    .category-brand-container {
      text-align: left;
    }

    .category-brand-container ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .category-brand-container li {
      padding: 8px 0;
      border-bottom: 1px solid #eee;
    }

    .category-brand-container li:last-child {
      border-bottom: none;
    }

    .sign-in-link {
      color: #000000;
      text-decoration: none;
      font-weight: bold;
    }

    .outofstock {
      background: #ffe6e6;
      color: red;
      font-weight: bold;
      padding: 5px 10px;
      border-radius: 5px;
      display: inline-block;
      margin-top: 5px;
    }

    .results-bar {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      margin-bottom: 20px;
      padding: 10px 0;
      border-bottom: 1px solid #eee;
    }

    .results-count {
      font-size: 14px;
      color: #666;
    }

    .sort-dropdown {
      padding: 8px 12px;
      border: 1px solid #ddd;
      border-radius: 6px;
      font-size: 14px;
      background-color: white;
      cursor: pointer;
    }

    .offer-badge {
      position: absolute;
      top: 20px;
      left: 10px;
      background: #ff4d4d;
      color: #fff;
      font-weight: bold;
      font-size: 14px;
      padding: 12px 18px;
      clip-path: polygon(0 0, 100% 0, 100% 70%, 50% 100%, 0 70%);
      box-shadow: 0 3px 6px rgba(0,0,0,0.2);
      z-index: 5;
    }

    /* Mobile Filter Toggle Button */
    .mobile-filter-toggle {
      display: none;
      width: 100%;
      padding: 12px;
      background-color: #1e918b;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      margin-bottom: 15px;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .mobile-filter-toggle:active {
      background-color: #166b66;
    }

    /* Tablet Responsive (992px and below) */
    @media (max-width: 992px) {
      .main-container {
        padding: 12px;
        margin-top: 80px;
      }

      .product-list-container {
        flex-direction: column;
        gap: 20px;
      }
      
      .sidebar {
        width: 100%;
        position: static;
        top: auto;
        order: 2;
      }
      
      .product-grid {
        width: 100%;
        order: 1;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 18px;
      }

      .search-form {
        max-width: 250px;
      }
    }

    /* Mobile Responsive (768px and below) */
    @media (max-width: 768px) {
      .main-container {
        margin-top: 70px;
        padding: 10px;
      }

      .shop-topbar {
        flex-direction: column;
        gap: 12px;
        align-items: stretch;
        margin-bottom: 12px;
      }

      .search-form {
        max-width: 100%;
        width: 100%;
      }

      .mobile-filter-toggle {
        display: flex;
      }

      .sidebar {
        display: none;
        padding: 15px;
        margin-bottom: 15px;
      }

      .sidebar.show {
        display: block;
        animation: slideDown 0.3s ease-out;
      }

      @keyframes slideDown {
        from {
          opacity: 0;
          transform: translateY(-10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .product-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
      }

      .product-card {
        padding: 12px;
      }

      .product-card img {
        height: 160px;
      }

      .product-card h4 {
        font-size: 13px;
        min-height: 38px;
        margin: 10px 0 8px 0;
      }

      .product-card p {
        font-size: 12px;
        margin: 4px 0;
      }

      .add-to-cart-btn {
        padding: 10px;
        font-size: 13px;
        margin-top: 10px;
      }

      .wishlist-btn {
        top: 10px;
        right: 10px;
        padding: 6px;
        font-size: 14px;
      }

      .filter-title {
        font-size: 16px;
      }

      .price-filter .price-options {
        gap: 10px;
      }

      .price-button {
        padding: 10px 15px;
        font-size: 13px;
      }

      .pagination {
        margin: 25px 0;
        gap: 8px;
      }

      .pagination a {
        padding: 8px 12px;
        font-size: 13px;
      }

      .offer-badge {
        font-size: 11px;
        padding: 8px 12px;
        top: 15px;
        left: 8px;
      }

      .results-bar {
        justify-content: center;
        padding: 8px 0;
      }

      .sort-dropdown {
        width: 100%;
        max-width: 300px;
      }
    }

    /* Small Mobile (576px and below) */
    @media (max-width: 576px) {
      .main-container {
        padding: 8px;
      }

      .product-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
      }

      .product-card {
        padding: 10px;
      }

      .product-card img {
        height: 140px;
      }

      .product-card h4 {
        font-size: 12px;
        min-height: 34px;
        margin: 8px 0 6px 0;
      }

      .product-card p {
        font-size: 11px;
        margin: 3px 0;
      }

      .add-to-cart-btn {
        padding: 8px;
        font-size: 12px;
        margin-top: 8px;
      }

      .wishlist-btn {
        top: 8px;
        right: 8px;
        padding: 5px;
        font-size: 12px;
      }

      .sidebar {
        padding: 12px;
      }

      .filter-title {
        font-size: 15px;
        margin-bottom: 10px;
      }

      .filter-item {
        margin: 6px 0;
      }

      .filter-item a {
        font-size: 13px;
        padding: 4px 0;
      }

      .price-button {
        padding: 9px 12px;
        font-size: 12px;
      }

      .search-input {
        padding: 8px 12px;
        font-size: 13px;
      }

      .search-button {
        padding: 8px 12px;
        font-size: 13px;
      }

      .pagination a {
        padding: 6px 10px;
        font-size: 12px;
      }

      .offer-badge {
        font-size: 10px;
        padding: 6px 10px;
        top: 12px;
        left: 6px;
      }

      .outofstock {
        padding: 4px 8px;
        font-size: 11px;
      }

      .mobile-filter-toggle {
        padding: 10px;
        font-size: 14px;
      }
    }

    /* Extra Small Mobile (420px and below) */
    @media (max-width: 420px) {
      .main-container {
        padding: 6px;
      }

      .product-grid {
        gap: 8px;
      }

      .product-card {
        padding: 8px;
      }

      .product-card img {
        height: 130px;
        border-radius: 6px;
      }

      .product-card h4 {
        font-size: 11px;
        min-height: 32px;
        margin: 6px 0 4px 0;
      }

      .product-card p {
        font-size: 10px;
        margin: 2px 0;
      }

      .add-to-cart-btn {
        padding: 7px;
        font-size: 11px;
        border-radius: 6px;
      }

      .wishlist-btn {
        top: 6px;
        right: 6px;
        padding: 4px;
        font-size: 11px;
      }

      .search-input {
        padding: 7px 10px;
        font-size: 12px;
      }

      .search-button {
        padding: 7px 10px;
        font-size: 12px;
      }

      .offer-badge {
        font-size: 9px;
        padding: 5px 8px;
        top: 10px;
        left: 5px;
      }
    }

    /* Very Small Screens (360px and below) */
    @media (max-width: 360px) {
      .main-container {
        padding: 5px;
      }

      .product-card img {
        height: 120px;
      }

      .product-card h4 {
        font-size: 10px;
        min-height: 30px;
      }

      .product-card p {
        font-size: 9px;
      }

      .add-to-cart-btn {
        padding: 6px;
        font-size: 10px;
      }

      .pagination a {
        padding: 5px 8px;
        font-size: 11px;
      }
    }
  </style>
</head>

<body>
  <main class="main" id="top">
    <div class="main-container">
      <section class="shop-page container-fluid">
        <div class="shop-topbar d-flex justify-content-center">
          <div class="search-bar">
            <form action="/search" method="GET" class="search-form">
              <input type="text" name="query" placeholder="Search items..." class="search-input" />
              <button type="submit" class="search-button">Search</button>
            </form>
          </div>
        </div>

        <div class="results-bar">  
          <form action="/shop" method="get">
            <select class="sort-dropdown" name="sort" onchange="this.form.submit()">
              <option value="default" <%= sortOption === 'default' ? 'selected' : '' %>>Default sorting</option>
              <option value="price-low" <%= sortOption === 'price-low' ? 'selected' : '' %>>Price: Low to High</option>
              <option value="price-high" <%= sortOption === 'price-high' ? 'selected' : '' %>>Price: High to Low</option>
              <option value="nameAZ" <%= sortOption === 'nameAZ' ? 'selected' : '' %>>Name: A to Z</option>
              <option value="nameZA" <%= sortOption === 'nameZA' ? 'selected' : '' %>>Name: Z to A</option>
            </select>
          </form>
        </div>

        <!-- Mobile Filter Toggle Button -->
        <button class="mobile-filter-toggle" onclick="toggleFilters()">
          <span>🔍</span>
          <span>Filters & Categories</span>
        </button>

        <div class="product-list-container">
          <aside class="sidebar" id="filterSidebar"> 
            <div class="filter-section">
              <div class="filter-title">Categories</div>
              <div class="category-brand-container">
                <ul>
                  <% for(let i=0; i<category.length; i++) { %>
                  <li class="filter-item">
                    <a href="/filter?category=<%= category[i]._id %>"><%= category[i].name %></a>
                  </li>
                  <% } %>
                </ul>
              </div>
            </div>

            <div class="filter-section">
              <div class="filter-title">Brands</div>
              <div class="category-brand-container">
                <ul>
                  <% for(let i=0; i<brand.length; i++) { %>
                  <li class="filter-item">
                    <a href="/filter?brand=<%= brand[i]._id %>"><%= brand[i].brandName %></a>
                  </li>
                  <% } %>
                </ul>
              </div> 
            </div>

            <div class="price-filter">
              <div class="filter-title">Filter by Price</div>
              <form id="price-filter-form">
                <div class="price-options">
                  <a href="/filterPrice?gt=0&lt=5000"><button type="button" class="price-button">Under ₹5000</button></a>
                  <a href="/filterPrice?gt=5000&lt=10000"><button type="button" class="price-button">₹5000 - ₹10000</button></a>
                  <a href="/filterPrice?gt=10000&lt=15000"><button type="button" class="price-button">₹10000 - ₹20000</button></a>
                  <a href="/filterPrice?gt=15000&lt=1000000"><button type="button" class="price-button">Above ₹20000</button></a>
                </div>
              </form>
            </div>
          </aside>

          <main class="product-grid" id="productContainer">
            <% if(products.length === 0) { %>
              <div class="col-12 text-center m-5">
                <h3 class="text-muted">No products found</h3>
              </div>  
            <% } else { %>
              <% for(let i=0; i<products.length; i++) { %>
                <div class="product-card">
                  <% if(products[i].productOffer) { %>
                    <div class="offer-badge"><%= products[i].productOffer %>% OFF</div>
                  <% } %>
                  
                  <span class="wishlist-btn" onclick="addToWishlist('<%= products[i]._id %>')">❤️</span>
                  <a href="/productDetails?id=<%= products[i]._id %>">
                    <img src="<%= products[i].productImage[0] %>" alt="<%= products[i].productName %>" />
                    <h4><%= products[i].productName %></h4>
                    <p>Brand: <%= products[i].brand %></p>
                    <p>Price: ₹<%= products[i].salePrice.toLocaleString('en-IN') %>
                      <span class="text-muted"><strike> ₹<%= products[i].regularPrice.toLocaleString('en-IN') %></strike></span>
                    </p>
                  </a>
                  <% if(user) { %>
                    <% if(products[i].quantity > 0) { %>
                      <button class="add-to-cart-btn" data-productId="<%= products[i]._id %>" type="button">Add to Cart</button>
                    <% } else { %>
                      <span class="outofstock">Out of Stock</span>
                    <% } %> 
                  <% } %>
                </div>
              <% } %>
            <% } %>
          </main>
        </div>
 
        <!-- Pagination -->
        <div class="pagination">
          <% if (currentPage > 1) { %>
            <a class="btn" href="/shop?page=<%= currentPage-1 %>">Prev</a>
          <% } %>

          <% for (let i = 1; i <= totalPages; i++) { %>
            <a class="btn <%= currentPage === i ? 'active' : '' %>" href="/shop?page=<%= i %>"><%= i %></a>
          <% } %>

          <% if (currentPage < totalPages) { %>
            <a class="btn" href="/shop?page=<%= currentPage + 1 %>">Next</a>
          <% } %>
        </div>

      </section>
    </div>
  </main>
   
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/feather-icons/4.29.0/feather.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <script>
    // Mobile Filter Toggle
    function toggleFilters() {
      const sidebar = document.getElementById('filterSidebar');
      sidebar.classList.toggle('show');
    }

    // Add to Cart
    document.addEventListener('DOMContentLoaded', function() {
      const addtocart = document.querySelectorAll('.add-to-cart-btn');
      addtocart.forEach(button => {
        button.addEventListener('click', async function() {
          const productId = this.getAttribute('data-productId');

          try {
            const response = await fetch('/addtocart', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({productId})
            });
            const result = await response.json();    
            if(result.success) {
              Swal.fire({
                icon: 'success',
                title: 'Added to Cart',
                text: result.message,
                showConfirmButton: true,
                confirmButtonText: 'View Cart'
              }).then((res) => {
                if(res.isConfirmed) {
                  window.location.href = "/cart";
                }
              });
            } else {
              Swal.fire({
                icon: 'error',
                title: 'Oops',
                text: result.message,
                showConfirmButton: true
              });
            }
          } catch (error) {
            Swal.fire({
              icon: 'error',
              title: "ERROR",
              text: "ERROR HAPPENED",
              showConfirmButton: true
            });
          }
        });
      });
    });

    // Add to Wishlist
    async function addToWishlist(productId) {
      try {
        const response = await fetch('/add-to-wishlist', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({productId})
        });

        const result = await response.json();

        if(result.success) {
          Swal.fire({
            icon: 'success',
            title: "Success",
            text: result.message,
          });
        } else {
          Swal.fire({
            icon: 'error',
            title: 'ERROR',
            text: result.message,
            showConfirmButton: true
          });
        }
      } catch (error) {
        console.log("error in frontend addtoWishlist", error);
        Swal.fire('OOPS', 'Something Went Wrong', 'error');
      }
    }

    feather.replace();
  </script>
  
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@300;700&display=swap" rel="stylesheet">
</body>