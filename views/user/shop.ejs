<%- include("../../views/partials/user/supportheader") %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/assets/css/shop.css">
  </head>
  <body>
    <main class="main" id="top">
      <div class="main-container">
        <section class="shop-page container-fluid">
          <div class="shop-topbar">
            <div class="search-bar">

              <form action="/shop" method="GET" class="search-form" id="searchForm">
                <div style="position: relative; display: inline-block;">
                  <input type="text" name="query" placeholder="Search items..." class="search-input"
                    value="<%= searchQuery || '' %>" id="searchInput" style="padding-right: 20px;" />
                  <% if(searchQuery) {%>
                    <button type="button" id="clearSearch"
                      style="position:absolute; right: 8px; top: 50%; transform: translateY(-50%); border:none; background: transparent; cursor: pointer;font-size: 18px; ">
                      &times;
                    </button>
                    <% } %>
                </div>
                <button type="submit" class="search-button">Search</button>
              </form>

            </div>
          </div>

          <div class="results-bar">
            <form action="/shop" method="get">

              <% selectedCategories.forEach(cat=>{ %>
                <input type="hidden" name="category" value="<%= cat %>">
                <% }) %>

                  <% selectedBrand.forEach(b=>{ %>
                    <input type="hidden" name="brand" value="<%= b %>">
                    <% }) %>

                      <% if(selectedPrice){%>
                        <input type="hidden" name="price" value="<%=selectedPrice%>">
                        <% } %>

                          <% if (searchQuery) { %>
                            <input type="hidden" name="query" value="<%= searchQuery %>">
                            <% } %>

                              <select class="sort-dropdown" name="sort" onchange="this.form.submit()">
                                <option value="default" <%=sortOption==='default' ? 'selected' : '' %>>Default sorting
                                </option>
                                <option value="price-low" <%=sortOption==='price-low' ? 'selected' : '' %>>Price: Low to
                                  High</option>
                                <option value="price-high" <%=sortOption==='price-high' ? 'selected' : '' %>>Price: High
                                  to Low</option>
                                <option value="nameAZ" <%=sortOption==='nameAZ' ? 'selected' : '' %>>Name: A to Z
                                </option>
                                <option value="nameZA" <%=sortOption==='nameZA' ? 'selected' : '' %>>Name: Z to A
                                </option>
                              </select>
            </form>
          </div>

          <button class="mobile-filter-toggle" type="button" onclick="toggleFilters(event)">
            <span>🔍</span>
            <span>Filters & Categories</span>
          </button>

          <div class="sidebar-overlay" id="sidebarOverlay"></div>

          <div class="product-list-container">
            <aside class="sidebar" id="filterSidebar">
              <button class="sidebar-close-btn" id="sidebarCloseBtn" type="button"
                onclick="toggleFilters(event)">×</button>
              <form action="/shop" method="get" id="filterForm">

          <button id="clearFilterBtn" class="btn btn-outline-secondary mx-5  mb-2" type="button"
                    style="display:   none;">Clear Filter </button>
                <div class="filter-section">
                  <div class="filter-title">Categories</div>
                  <div class="category-brand-container">
                    <ul>
                      <% category.forEach(cat=>{ %>
                        <li class="filter-item">
                          <label>
                            <input type="checkbox" name="category" value="<%= cat._id %>"
                              <%= selectedCategories.includes(String(cat._id)) ? "checked" : "" %>
                            >
                            <%= cat.name%>
                          </label>
                        </li>
                        <% }) %>
                    </ul>
                  </div>
                </div>

                <div class="filter-section">
                  <div class="filter-title">Brands</div>
                  <div class="category-brand-container">
                    <ul>
                      <% brand.forEach(b=>{ %>
                        <li class="filter-item">
                          <label>
                            <input type="checkbox" name="brand" value="<%= b.brandName %>"
                              <%= selectedBrand.includes(String(b.brandName)) ? "checked" : '' %>
                            >
                            <%= b.brandName %>
                          </label>
                        </li>
                        <% }) %>
                    </ul>
                  </div>
                </div>

                <div class="price-filter">
                  <div class="filter-title">Filter by Price</div>
                  <div class="price-options">
                    <label>
                      <input type="radio" name="price" value="under5000" class="price-button"
                        <%= selectedPrice==="under5000" ? "checked" : "" %> >
                      Under ₹5000
                    </label>
                    <label>
                      <input type="radio" name="price" value="under5000to10000" class="price-button"
                        <%= selectedPrice==="under5000to10000" ? "checked" : "" %>>
                      ₹5000 - ₹10000
                    </label>
                    <label>
                      <input type="radio" name="price" value="under10000to20000" class="price-button"
                        <%= selectedPrice==="under10000to20000" ? "checked" : "" %>>
                      ₹10000 - ₹20000
                    </label>
                    <label>
                      <input type="radio" name="price" value="above20000" class="price-button"
                        <%= selectedPrice==="above20000" ? "checked" : "" %>>
                      Above ₹20000
                    </label>
                  </div>
                </div>
                <div class="filter-action mt-3">
             
                </div>
              </form>
            </aside>

            <main class="product-grid" id="productContainer">
              <% if(products.length===0) { %>
                <div class="col-12 text-center m-5">
                  <h3 class="text-muted">No products found</h3>
                </div>
                <% } else { %>
                  <% for(let i=0; i<products.length; i++) { %>
                    <div class="product-card">
                       <a href="/productDetails?id=<%= products[i]._id %>">
                      <div class="product-image-wrapper">
                        <% if(products[i].biggestOffer> 0 ) { %>
                          <div class="offer-badge">
                            <%= products[i].biggestOffer %>% OFF
                          </div>
                          <% } %>
                            <%if(user){%>

                              <span class="wishlist-btn" onclick="addToWishlist('<%= products[i]._id %>')">
                                <% if (wishlistProductIds.includes(products[i]._id.toString())) { %>
                                  ✅
                                  <% }else{ %>
                                    ❤️
                                    <% } %>

                              </span>
                              <%}%>
                             
                                <img src="<%= products[i].productImage[0] %>" alt="<%= products[i].productName %>" />
                      </div>
                      
                        <div class="product-info">
                          <div class="product-brand">
                            <%= products[i].brand %>
                          </div>
                          <h4>
                            <%= products[i].productName %>
                          </h4>

                          <div class="product-price-wrapper">
                            <% if(products[i].biggestOffer> 0){%>
                              <span class="product-price">₹<%= products[i].salePrice.toLocaleString('en-IN') %></span>
                              <span class="product-regular-price">₹<%= products[i].regularPrice.toLocaleString('en-IN')
                                  %></span>
                              <% }else{%>
                                <span class="product-price">₹<%= products[i].regularPrice.toLocaleString('en-IN') %>
                                </span>
                                <%}%>
                          </div>


                        </div>
                      </a>
                      <% if(user) { %>
                        <% if(products[i].quantity> 0) { %>
                          <button class="add-to-cart-btn " data-productId="<%= products[i]._id %>" type="button">Add to
                            Cart</button>
                          <% } else { %>
                            <span class="outofstock">Out of Stock</span>
                            <% } %>
                              <% } %>
                    </div>
                    <% } %>
                      <% } %>
            </main>
          </div>

          <% let queryParam='' ; 
          if(selectedCategories && selectedCategories.length> 0){
            selectedCategories.forEach(cat =>{
            queryParam += `category=${encodeURIComponent(cat)}`;
            });
            }

            if(selectedBrand && selectedBrand.length > 0){
            selectedBrand.forEach(brand =>{
            queryParam += `&brand=${encodeURIComponent(brand)}`;
            })
            }

            if(selectedPrice){
            queryParam +=`&price=${encodeURIComponent(selectedPrice)}`
            }

            if(sortOption){
            queryParam+= `&sort=${encodeURIComponent(sortOption)}`
            }

            if(searchQuery){
            queryParam +=`&query=${encodeURIComponent(searchQuery)}`
            }

            %>

            <div class="pagination">
              <% if (currentPage> 1) { %>
                <a class="btn" href="/shop?page=<%= currentPage-1 %> <%=queryParam %>"> Prev</a>
                <% } %>

                  <% for (let i=1; i <=totalPages; i++) { %>
                    <a class="btn <%= currentPage === i ? 'active' : '' %>" href="/shop?page=<%= i %><%= queryParam %>">
                      <%= i %>
                    </a>
                    <% } %>

                      <% if (currentPage < totalPages) { %>
                        <a class="btn" href="/shop?page=<%= currentPage + 1 %><%= queryParam %>">Next</a>
                        <% } %>
            </div>

        </section>
      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/feather-icons/4.29.0/feather.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
      // Improved mobile filter toggle
      function toggleFilters(event) {
        event.preventDefault();
        event.stopPropagation(); // Prevent event from bubbling up

        const sidebar = document.getElementById('filterSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const body = document.body;

        sidebar.classList.toggle('show');
        overlay.classList.toggle('show');

        // Prevent body scroll when sidebar is open
        if (sidebar.classList.contains('show')) {
          body.style.overflow = 'hidden';
        } else {
          body.style.overflow = 'auto';
        }
      }
      // Close sidebar when clicking outside
      document.addEventListener('click', function (event) {
        const sidebar = document.getElementById('filterSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const toggleBtn = document.querySelector('.mobile-filter-toggle');

        // Only close if sidebar is open and click is outside both sidebar and toggle button
        if (sidebar.classList.contains('show')) {
          if (!sidebar.contains(event.target) && !toggleBtn.contains(event.target)) {
            sidebar.classList.remove('show');
            overlay.classList.remove('show');
            document.body.style.overflow = 'auto';
          }
        }
      });

      // Close sidebar when clicking on overlay
      document.getElementById('sidebarOverlay')?.addEventListener('click', function () {
        const sidebar = document.getElementById('filterSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        sidebar.classList.remove('show');
        overlay.classList.remove('show');
        document.body.style.overflow = 'auto';
      });

      // Close sidebar on filter submission
      document.getElementById('filterForm')?.addEventListener('submit', function () {
        const sidebar = document.getElementById('filterSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        sidebar.classList.remove('show');
        overlay.classList.remove('show');
        document.body.style.overflow = 'auto';
      });
      // Close sidebar on link click
      document.querySelectorAll('.sidebar a').forEach(link => {
        link.addEventListener('click', function () {
          const sidebar = document.getElementById('filterSidebar');
          const overlay = document.getElementById('sidebarOverlay');
          sidebar.classList.remove('show');
          overlay.classList.remove('show');
          document.body.style.overflow = 'auto';
        });
      });
      // Handle window resize
      window.addEventListener('resize', function () {
        if (window.innerWidth > 768) {
          const sidebar = document.getElementById('filterSidebar');
          const overlay = document.getElementById('sidebarOverlay');
          sidebar.classList.remove('show');
          overlay.classList.remove('show');
          document.body.style.overflow = 'auto';
        }
      });

      document.addEventListener('DOMContentLoaded', function () {
        const addtocart = document.querySelectorAll('.add-to-cart-btn');
        addtocart.forEach(button => {
          button.addEventListener('click', async function () {
            const productId = this.getAttribute('data-productId');

            try {
              const response = await fetch('/addtocart', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify({ productId })
              });
              const result = await response.json();
              if (result.success) {
                Swal.fire({
                  icon: 'success',
                  title: 'Added to Cart',
                  text: result.message,
                  showConfirmButton: true,
                  confirmButtonText: 'View Cart',
                  background: '#e8ffe8',
                  timer: 2000,
                  timerProgressBar: true
                }).then((res) => {
                  if (res.isConfirmed) {
                    window.location.href = "/cart";
                  }
                });
              } else {
                Swal.fire({
                  icon: 'error',
                  title: 'Oops',
                  text: result.message,
                  showConfirmButton: true
                });
              }
            } catch (error) {
              Swal.fire({
                icon: 'error',
                title: "ERROR",
                text: "ERROR HAPPENED",
                showConfirmButton: true
              });
            }
          });
        });
      });

      async function addToWishlist(productId) {
        try {
          const response = await fetch('/add-to-wishlist', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ productId })
          });

          const result = await response.json();

          if (result.success) {
            Swal.fire({
              icon: 'success',
              title: "Success",
              text: result.message,
              timer: 2000,
              timerProgressBar: true,
              showConfirmButton: false,
              background: '#e8ffe8'
            }).then(() => {
              window.location.reload()
            })
          } else {
            Swal.fire({
              icon: 'error',
              title: 'ERROR',
              text: result.message,
              showConfirmButton: true
            });
          }
        } catch (error) {
          console.log("error in frontend addtoWishlist", error);
          Swal.fire('OOPS', 'Something Went Wrong', 'error');
        }
      }

      const clearBtn = document.getElementById('clearSearch');
      const input = document.getElementById('searchInput');

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          input.value = "";
          window.location.href = '/shop'
        })
      }

      feather.replace();

      document.addEventListener('DOMContentLoaded', function () {
        const filterForm = document.getElementById('filterForm');
        const clearBtn = document.getElementById('clearFilterBtn');
        const inputs = filterForm.querySelectorAll("input[name='category'], input[name='brand'], input[name='price']");

        inputs.forEach(input =>{
          input.addEventListener('change',()=>{
            filterForm.submit()
          })
        })

        // Function to check if any filter is applied
        function checkFilter() {
          let anySelected = false;

          

          inputs.forEach(input => {
            if ((input.type === 'checkbox' || input.type === 'radio') && input.checked) {
              anySelected = true;
            }
          });
          clearBtn.style.display = anySelected ? "inline-block" : "none";
        }

        // Add event listener to all inputs
        inputs.forEach(input => {
          input.addEventListener('change', checkFilter);
        });

        // On Clear button click — uncheck all filters instantly
        clearBtn.addEventListener('click', function () {
          inputs.forEach(input => input.checked = false);
          clearBtn.style.display = "none";
          // Submit form without filters or just reload page
          window.location.href = '/shop';
        });

        // Run once on page load
        checkFilter();
      });
    </script>

    <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@300;700&display=swap" rel="stylesheet">
  </body>
  <%- include("../../views/partials/user/supportfooter") %>