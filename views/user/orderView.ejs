 <%- include("../../views/partials/user/supportheader") %>
    <title>Order Details</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .product-img {
            width: 80px;
            height: 80px;
            object-fit: cover;
        }
        
        .cancel-section {
            background-color: #f8f9fa;
            border-left: 4px solid #dc3545;
        }
    </style>
</head>
<body class="bg-light">
    <div class="container-sm py-4" style="max-width: 800px;">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col">
                <h2>Order Details page </h2>
                
            </div>
        </div>

        <!-- Order Products -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Order Items</h5>
            </div>
            <div class="card-body">
            <% if (orders) { %>
              <% orders.forEach(order => { %>
             
                    <!-- Loop through each item in the order -->
                    <div class="row align-items-center py-3 border-bottom">
                            <% order.orderedItems.forEach(item => { %>
                                <hr>
                            <!-- Product Image -->
                            <div class="col-2">
                                <img src="<%= item.product.productImage[0] %>" 
                                    alt="<%= item.product.productName %>" 
                                    class="product-img rounded">
                            </div>
                            
                            <!-- Product Details -->
                             
                            <div class="col-6">
                                <p><strong>Order Id:</strong> <%= order.orderId %></p>
                               <strong> <p class="mb-1"><%= item.product.productName %></p></strong>
                                <p><strong>Description : </strong><%= item.product.description%></p>
                                <p><strong>Brand : </strong><%= item.product.brand%></p>
                                <p><strong>Category : </strong><%= item.product.category.name %></p>
                                <p><strong>Color : </strong><%= item.product.color %></p>
                                <small class="text-muted">Qty: <%= item.quantity %></small>
                                <p><strong>Address : </strong><%= order.address.addressType %> </p>
                                <p><b><%= order.address.name %></b>   <%= order.address.landMark %>(H),<%= order.address.city %>,
                                <%= order.address.state %> <%= order.address.pincode %>,
                              MOB: <%= order.address.phone %>,<%=order.address.altPhone %></p>
                                <p style="color: rgb(223, 47, 2);" > <strong class="text-dark">Status :</strong> <%= order.status %></p>
                                <p>Order Placed On: <%= order.createdOn.toLocaleDateString('en-IN') %></p>
                            </div>

                            <!-- Price & Cancel Button -->
                            <div class="col-4 text-end">
                                    <h6>
                                        <%= item.price.toLocaleString('en-IN',{style:'currency',currency:'INR'})  %>
                                    </h6>
                                    
                               <% if(item.status === 'Cancelled' ||order.status === 'Delivered' || item.status === "Returned" ){ %>
                                 <button type="button" 
                                        class="btn btn-danger mt-2" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#cancelModal"
                                        onclick="setCancelOrderId('<%= order.orderId %>','<%= item._id %>')" disabled>
                                    Cancel Item
                                </button>
                            <% }else {%>
                                 <button type="button" 
                                        class="btn btn-danger mt-2" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#cancelModal"
                                        onclick="setCancelOrderId('<%= order.orderId %>','<%= item._id %>')" >
                                    Cancel Item
                                </button>
                                <%} %>

                                
                                <% if (order.status === 'Delivered') {%>
                                <button type="button" 
                                        class="btn btn-secondary mt-2" 
                                        
                                        onclick="returnOrder('<%= order.orderId %>')" >
                                    Return Order
                                </button>
                           <% }else{%>
                            <button type="button" 
                                        class="btn btn-secondary mt-2" 
                                        
                                        disabled >
                                    Return Order
                                </button>
                            <%}%>
                            <% if(order.status === 'Delivered'){%>
                            <a href="/invoice/<%= order.orderId%>" class="btn btn-primary mt-2">Download Invoice</a>
                            <%}%>
                            </div>

                            

                            <% }) %>
                        
                            <!-- <p> <%= order.totalPrice %></p> -->
                        </div>
                        <% }) %>
           
    <% } else { %>
        <p>No orders found</p>
    <% } %>
</div>

 </div>
        <!-- Cancel Order Section -->
        <div class="card">
            <div class="card-body cancel-section">
                
                    <h5 class="text-danger mb-3">Cancel Order</h5>
             
                <p class="mb-3">You can cancel this order if it hasn't been shipped yet. Once cancelled, you'll receive a full refund within 3-5 business days.</p>
                
                <!-- Cancel Button with Confirmation -->
               
            </div>
        </div>
    </div>

    <!-- Cancel Confirmation Modal -->
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger" id="cancelModalLabel"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p id="cancelText" > </p>
                    <!-- <p class="text-muted mb-0">This action cannot be undone. You will receive a full refund within 3-5 business days.</p> -->
                    <input type="hidden" id="cancelOrderId">
                    <input type="hidden" id="cancelItemId">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Keep Order</button>
                    <button type="button" class="btn btn-danger" onclick="cancelOrder()">Yes, Cancel Order</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Modal -->
    <div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-success" id="successModalLabel">Order Cancelled</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Your order has been successfully cancelled.</p>
                    <p class="text-muted mb-0">You will receive a confirmation email shortly and a full refund within 3-5 business days.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" onclick="goToOrders()">View My Orders</button>
                </div>
            </div>
        </div>
    </div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script>
        function returnOrder(orderId) {
            Swal.fire({
            title: "Are you sure?",
            text: "Please provide a reason for returning this order:",
            input: "textarea",
            inputPlaceholder:"Write your Reason here....",
            showCancelButton: true,
            confirmButtonText: "Yes, Submit Return",
            cancelButtonText: "Cancel"
                 }).then((result) => {
                    if (result.isConfirmed && result.value.trim() !=="") {
                        fetch(`/return-order/${orderId}`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body:JSON.stringify({reason:result.value})
                        })
                        .then(res => res.json())
                        .then(data => {
                        if(data.success){
                            Swal.fire({
                                icon:'success',
                                title:"Requested",
                                text:data.message
                            })
                            .then(() => location.reload());
                        }else{
                            Swal.fire("Error!", data.message, "error");
                        }
                        })
                        .catch(() => Swal.fire("Error!", "Something went wrong.", "error"));
            }
    });
  }




    function setCancelOrderId(orderId,itemId){
        document.getElementById('cancelOrderId').value = orderId;
        document.getElementById('cancelItemId').value = itemId;

        document.getElementById('cancelText').innerHTML = `Are you Want to Cancel this Order Cancel this Order?`
    }



        function cancelOrder() {

            const orderId = document.getElementById('cancelOrderId').value;
            const itemId = document.getElementById('cancelItemId').value;
            fetch(`/cancelOrder/${orderId}/${itemId}`,{
                method:'POST'
            })
            .then(res=>res.json())
            .then(data=>{
                if(data.success){
                    // Hide cancel confirmation modal
                    const cancelModal = bootstrap.Modal.getInstance(document.getElementById('cancelModal'));
                    cancelModal.hide();
                    // Show success modal after a short delay
                    // setTimeout(() => {
                    //     const successModal = new bootstrap.Modal(document.getElementById('successModal'));
                    //     successModal.show();
                    // }, 300);
                    Swal.fire({
                        icon:'success',
                        title:'Success',
                        text:data.message,

                    }).then(()=>{
                        window.location.reload()
                    })
                }else{
                    Swal.fire({
                        icon:'error',
                        title:'OOPS',
                        text:data.message,
                        showConfirmButton:true
                    })
                }
            })
            .catch(err=>{
                alert("eeror in fetch cancel order");

            })

            
            
            // Here you would typically make an API call to cancel the order
            console.log('Order cancelled');
        }
        
        function goToOrders() {
            // Redirect to orders page
            window.location.href = '/viewOrder';
            
        }
    </script>
</body>
