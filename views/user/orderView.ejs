<%- include("../../views/partials/user/supportheader") %>
    <title>Order Details</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .product-img {
            width: 80px;
            height: 80px;
            object-fit: cover;
        }
        
        .cancel-section {
            background-color: #f8f9fa;
            border-left: 4px solid #dc3545;
        }

        /* Mobile Responsive Styles */
        @media (max-width: 768px) {
            .container-sm {
                padding-left: 10px !important;
                padding-right: 10px !important;
            }

            .breadcrumb {
                font-size: 0.85rem;
                flex-wrap: wrap;
            }

            .breadcrumb-item {
                margin-bottom: 5px;
            }

            .card {
                margin-bottom: 1rem;
            }

            .card-body {
                padding: 0.75rem;
            }

            /* Product Row Mobile Layout */
            .product-row {
                flex-direction: column !important;
                align-items: flex-start !important;
            }

            .product-img-col {
                width: 100% !important;
                display: flex;
                justify-content: center;
                margin-bottom: 1rem;
            }

            .product-img {
                width: 120px;
                height: 120px;
            }

            .product-details-col {
                width: 100% !important;
                margin-bottom: 1rem;
            }

            .product-details-col h4 {
                font-size: 1.1rem;
            }

            .product-details-col p {
                font-size: 0.9rem;
                margin-bottom: 0.5rem;
            }

            .product-price-col {
                width: 100% !important;
                text-align: left !important;
                border-top: 1px solid #dee2e6;
                padding-top: 1rem;
            }

            .product-price-col h6 {
                font-size: 1rem;
                margin-bottom: 0.75rem;
            }

            .btn {
                width: 100%;
                margin-bottom: 0.5rem;
            }

            .btn-danger,
            .btn-secondary,
            .btn-primary {
                font-size: 0.9rem;
                padding: 0.5rem;
            }

            /* Order Total Section */
            .cancel-section h5 {
                font-size: 1.1rem;
            }

            .cancel-section p {
                font-size: 0.85rem;
                word-wrap: break-word;
            }

          

            /* Text wrapping for long content */
            .text-wrap-mobile {
                word-wrap: break-word;
                overflow-wrap: break-word;
            }
        }

        @media (max-width: 576px) {
            .py-4 {
                padding-top: 1rem !important;
                padding-bottom: 1rem !important;
            }

            h2, h4, h5 {
                font-size: 1rem;
            }

            .card-header h5 {
                font-size: 1rem;
            }

            small {
                font-size: 0.8rem;
            }
        }

        /* Ensure buttons don't overflow */
        .btn-group-mobile {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        /* Improved spacing for mobile */
        @media (max-width: 768px) {
            .border-bottom {
                padding-bottom: 1rem;
                margin-bottom: 1rem;
            }
        }
    </style>
</head>
<body class="bg-light">
    <div class="container-sm py-4" style="max-width: 800px;">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col">
                <div class="breadcrumb">
                    <span class="breadcrumb-item">Account</span>
                    <span class="breadcrumb-item active">Order</span>
                    <%orders.forEach(order => { %>
                        <span class="breadcrumb-item">OrderId : <%= order.orderId %></span>
                    <% }) %>
                </div>
            </div>
        </div>

        <!-- Order Products -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Order Items</h5>
            </div>
            <div class="card-body">
                <% if (orders) { %>
                    <% orders.forEach(order => { %>
                        <!-- Loop through each item in the order -->
                        <% order.orderedItems.forEach(item => { %>
                            <hr>
                            <div class="row align-items-center py-3 border-bottom product-row">
                                <!-- Product Image -->
                                <div class="col-md-2 col-12 product-img-col">
                                    <img src="<%= item.product.productImage[0] %>" 
                                        alt="<%= item.product.productName %>" 
                                        class="product-img rounded">
                                </div>
                                
                                <!-- Product Details -->
                                <div class="col-md-6 col-12 product-details-col">
                                    <strong><h4 class="mb-1"><%= item.product.productName %></h4></strong>
                                    <p class="text-wrap-mobile"><strong>Description : </strong><%= item.product.description%></p>
                                    <p><strong>Brand : </strong><%= item.product.brand%></p>
                                    <p><strong>Category : </strong><%= item.product.category.name %></p>
                                    <p><strong>Color : </strong><%= item.product.color %></p>
                                    <small class="text-muted">Qty: <%= item.quantity %></small>
                                    <p style="color: rgb(223, 47, 2);"><strong class="text-dark">Item Status :</strong> <%= item.status %></p>
                                    <p style="color: rgb(235, 47, 2);"><strong class="text-dark">Order Status : </strong> <%= order.status %></p>
                                </div>

                                <!-- Price & Cancel Button -->
                                <div class="col-md-4 col-12 text-md-end product-price-col">
                                    <h6>
                                        <b>Item Price : </b>
                                        <span data-bs-toggle="tooltip" title="Order Price: <%= orders[0].totalPrice.toLocaleString('en-IN',{style:'currency',currency:'INR'}) %>">
                                            <%= item.salePrice.toLocaleString('en-IN', { style: 'currency', currency: 'INR' }) %>
                                        </span>
                                    </h6>
                                    
                                    <div class="btn-group-mobile">
                                        <% if(!(item.status === 'Cancelled' ||order.status === 'Delivered' || 
                                        item.status === "Returned" ||item.status ==='Return Approved'||
                                        item.status ==='Return Requested' || item.status === 'Cancellation Requested' ||
                                        order.status === 'Returned' ||item.status === 'Delivered'||
                                        item.status === 'Cancellation Rejected' || item.status ==='Payment-failed')){ %>
                                            <button type="button" 
                                                class="btn btn-danger" 
                                                onclick="setCancelOrderId('<%= order.orderId %>','<%= item._id %>','<%= orders[0].discount %>')">
                                                Cancel Item
                                            </button>
                                        <% } %>  
                                        
                                        <% if(item.status === 'Cancellation Requested'){%>
                                            <button type="button" 
                                                class="btn btn-danger" 
                                                onclick='withdrawCancel("<%=order.orderId %>","<%= item._id%>")'>
                                                Withdraw Cancel Request
                                            </button>
                                        <% } %>
                                        
                                        <!-- Messages for admin rejection -->
                                        <% if(item.status === 'Cancellation Rejected'){%>
                                            <span class="text-danger d-block mb-2">Your cancel request was rejected by admin. Order is still active.</span> 
                                        <% } %>
                                        
                                        <% if(  order.status === 'Return Rejected'){%>
                                            <span class="text-danger d-block mb-2">Your Order Return request was rejected by admin</span> 
                                        <% } %>
                                        
                                        <% if ((item.status === 'Delivered')) {%>
                                            <button type="button" 
                                                class="btn btn-secondary" 
                                                onclick="returnOrder('<%= order.orderId %>','<%= item._id%>')">
                                                Return Order
                                            </button>
                                        <% } %>
                                        
                                        <% if ((item.status === 'Return Requested')) {%>
                                            <button type="button" 
                                                class="btn btn-secondary" 
                                                onclick="">
                                                Cancel Return Request
                                            </button>
                                        <% } %>
                                         
                                        <% if(item.status === 'Payment-failed'){ %>
                                        <button class="btn btn-warning text-dark fw-bolder"
                                        onclick="retryPayment('<%= order.orderId %>' , '<%= item._id %>', '<%= item.price %>' )"
                                        >Retry Payment</button>
                                        <% } %>

                                        <% if(item.status === 'Delivered' ){%>
                                            <a href="/invoice/<%= order.orderId%>" class="btn btn-primary">Download Invoice</a>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% }) %>
                <% } else { %>
                    <p>No orders found</p>
                <% } %>
            </div>
        </div>

        <!-- Order Total -->
        <div class="card mt-2">
            <div class="card-body cancel-section">
                <h5 class="text-danger mb-3">Order Total</h5>
                <% orders.forEach(order =>{%>
                    <p class="text-wrap-mobile"><strong>OrderId : </strong> <%=order.orderId%></p> 
                    <p class="text-wrap-mobile"><strong>Address : </strong><b><%= order.address.name %></b> 
                        <%= order.address.landMark %>(H), <%= order.address.city %>,
                        <%= order.address.state %> <%= order.address.pincode %>,
                        <br>MOB: <%= order.address.phone %>, <%=order.address.altPhone %>
                    </p>
                    <% if(order.deliveredAt){%>
                        <p><strong>Order Placed On : </strong><%= order.createdOn.toLocaleString('en-IN') %></p>
                        <p><strong>Order Delivered On : </strong><%= order.deliveredAt.toLocaleString('en-IN') %></p>
                    <% } %>
                    <p><strong>Payment Method : </strong> <%= order.paymentMethod %></p>
                <%} ) %>
                <p><strong>Coupon Applied : </strong><%= orders[0].couponApplied ? 'YES' : 'NO' %></p>
                <p><strong>Discount : </strong><%= orders[0].discount ? orders[0].discount.toLocaleString('en-IN',{style:'currency',currency:'INR'}) : 0 %></p>
                <p><strong>Order Total : </strong><%= orders[0].totalPrice.toLocaleString('en-IN',{style:'currency',currency:'INR'}) %></p>
            </div>
        </div>

        <!-- Cancel Order Section -->
        <div class="card mt-3">
            <div class="card-body cancel-section">
                <h5 class="text-danger mb-3">Cancel Order</h5>
                <p class="mb-3">You can cancel this order if it hasn't been shipped yet. Once cancelled, you'll receive a full refund within 3-5 business days.</p>
            </div>
        </div>
    </div>

 <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script>
        function returnOrder(orderId, itemId) {
            Swal.fire({
                title: "Are you sure?",
                text: "Please provide a reason for returning this order:",
                input: "textarea",
                inputPlaceholder: "Write your Reason here....",
                showCancelButton: true,
                confirmButtonText: "Yes, Submit Return",
                cancelButtonText: "Cancel"
            }).then((result) => {
                if (result.isConfirmed && result.value.trim() !== "") {
                    fetch(`/return-order/${orderId}/${itemId}`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ reason: result.value })
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: "Requested",
                                text: data.message
                            }).then(() => location.reload());
                        } else {
                            Swal.fire("Error!", data.message, "error");
                        }
                    })
                    .catch(() => Swal.fire("Error!", "Something went wrong.", "error"));
                }
            });
        }

        function setCancelOrderId(orderId, itemId, discount) {
            Swal.fire({
                title: "Are you Sure?",
                text: 'Do you really want to cancel this order?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Cancel',
                cancelButtonText: 'No, Keep Order',
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Reason For Cancel',
                        input: 'radio',
                        inputOptions: {
                            'I change my mind': 'I change my mind',
                            "I don't like this color": "I don't like this color",
                            'Found a better price': 'Found a better price',
                            reason4: 'Other'
                        },
                        inputValidator: (value) => {
                            if (!value) {
                                return 'You need to choose a reason!';
                            }
                        },
                        showCancelButton: true,
                        confirmButtonText: 'Next',
                        cancelButtonText: 'No, Keep Order',
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#3085d6'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            if (result.value === 'reason4') {
                                Swal.fire({
                                    title: 'Please specify your reason',
                                    input: 'textarea',
                                    inputPlaceholder: 'Type your feedback here...',
                                    showCancelButton: true,
                                    confirmButtonText: 'Submit'
                                }).then((feedResult) => {
                                    if (feedResult.isConfirmed) {
                                        cancelOrder(orderId, itemId, feedResult.value, discount);
                                    }
                                });
                            } else {
                                cancelOrder(orderId, itemId, result.value, discount);
                            }
                        }
                    });
                }
            });
        }

        function cancelOrder(orderId, itemId, reason, discount) {
            fetch(`/cancelOrder/${orderId}/${itemId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ action: 'request', reason, discount })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Order Cancellation Request Send...',
                        text: data.message,
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'OOPS',
                        text: data.message,
                        showConfirmButton: true
                    });
                }
            })
            .catch(err => {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Something went wrong while cancelling the order.'
                });
            });
        }

        async function withdrawCancel(orderId, itemId) {
            fetch(`/cancelOrder/${orderId}/${itemId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ action: 'withdraw' })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Successfully Withdraw',
                        text: data.message
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'OOPS',
                        text: data.message,
                        showConfirmButton: true
                    });
                }
            })
            .catch(err => {
                Swal.fire({
                    icon: 'error',
                    title: "ERROR",
                    text: "Something Went Wrong"
                });
            });
        }

 async function retryPayment(orderId,itemId,itemPrice) {
    try {
        const respose = await fetch('/retry-payment',{
            method:'POST',
            headers:{
                'Content-Type':'application/json'
            },
            body:JSON.stringify({orderId,itemId,itemPrice})
        });

        const data = await respose.json();

        if(!data.success){
            Swal.fire({
                icon:'error',
                title:'OOPS',
                text:data.message,
                showConfirmButton:true
            })
            return;
        }

        const options = {
            key:data.key,
            amount:data.amount,
            currency:'INR',
            name:'HOURLY WATCHES',
            description:'Retry Payment',
            order_id:data.razorpayOrderId,

            //success
            handler: async function(response){
                const verifyRes = await fetch('/verify-retry-payment',{
                    method:'POST',
                    headers:{'Content-Type':'application/json'},
                    body:JSON.stringify({
                        orderId,
                        itemId,
                        razorpay_order_id:response.razorpay_order_id,
                        razorpay_payment_id:response.razorpay_payment_id,
                        razorpay_signature:response.razorpay_signature
                    })
                });

                const verify = await verifyRes.json();

                if(verify.success){
                    Swal.fire({
                        icon:'success',
                        title:'Success',
                        text:verify.message || 'Payment verified & order updated successfully'
                    }).then(()=>{
                        window.location.href = '/order-success'
                    })
                }else{
                    Swal.fire({
                        icon:'error',
                        title:'OOPS',
                        text:verify.message || "Payment Verification Went Wrong"
                    })
                }
            },

             modal : {
                ondismiss : function (){
                    console.log("Payment popup was closed by the user.")
                }
            }
        };

           const rzp = new Razorpay(options);

        rzp.on('payment.failed',async function(response){
                    const failResponse = await fetch('/verify-retry-payment',{
                        method:'POST',
                        headers:{'Content-Type' : 'application/json'},
                        body:JSON.stringify({
                            orderId,
                            itemId,
                            razorpay_order_id: response.error.metadata.order_id,
                            razorpay_payment_id:null,
                            razorpay_signature:null,
                            error:response.error
                        })
                    });

                    const fail = await failResponse.json();

                    Swal.fire({
                        icon:'error',
                        title:'Payment Failed',
                        text:fail.message || 'Retry Payment Failed'
                    }).then(()=>{
                        window.location.reload()
                    })

                })
            

           
            rzp.open();
        

     

    } catch (error) {
        console.log('error in the retry-verify script ',error)
        Swal.fire({
            icon:'error',
            title:'ERROR',
            text:"Somthing Went Wrong , Internal Server Error",
            showConfirmButton:true
        })
    }
    
 }
 
       

      
    </script>
</body>