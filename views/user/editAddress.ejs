
<%-include('../../views/partials/user/supportheader')%>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Address - HOURLY</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #ffffff;
            --secondary-color: #ffffff;
            --accent-color: #20c997;
            --text-dark: #333;
            --bg-light: #f8f9fa;
            --border-color: #e9ecef;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-light);
            color: var(--text-dark);
        }

      
        /* Main Content */
        .main-content {
            min-height: calc(100vh - 200px);
            padding: 2rem 0;
        }

        .form-container {
            background: white;
            border-radius: 10px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            padding: 2rem;
            margin-top: 2rem;
        }

        .page-title {
            color:rgb(91, 87, 87);
            font-weight: 700;
            margin-bottom: 2rem;
            position: relative;
        }

        .page-title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 50px;
            height: 3px;
            background: var(--accent-color);
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 0.5rem;
            display: block;
        }

        .form-control {
            border: 2px solid var(--border-color);
            border-radius: 8px;
            padding: 0.75rem;
            font-size: 1rem;
            transition: all 0.3s;
        }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.2rem rgba(4, 105, 99, 0.25);
        }

        .form-control.is-invalid {
            border-color: #dc3545;
        }

        .invalid-feedback {
            display: block;
            color: #dc3545;
            font-size: 0.875rem;
            margin-top: 0.25rem;
        }

        .btn-primary {
            background: blue;
            border: none;
            padding: 0.75rem 2rem;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-primary:hover {
            background: rgb(152, 215, 229);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .btn-secondary {
            background: #6c757d;
            border: none;
            padding: 0.75rem 2rem;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: white;
            text-decoration: none;
            display: inline-block;
        }

        .btn-secondary:hover {
            background: #5a6268;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            color: white;
        }


      
        /* Responsive Design */
        @media (max-width: 768px) {
          

            .form-container {
                padding: 1rem;
            }

            .footer-content {
                grid-template-columns: 1fr;
                text-align: center;
            }
        }

        /* Loading Animation */
        .loading {
            display: none;
            text-align: center;
            padding: 1rem;
        }

        .spinner {
            border: 4px solid #f3f3f3;
            border-top: 4px solid var(--primary-color);
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 0 auto 1rem;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body>

    <main class="main-content">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="form-container">
                        <h2 class="page-title">
                            <i class="fas fa-edit me-2"></i>Edit Address
                        </h2>
                        
                        <form id="addressForm"   novalidate>
                            <input type="hidden" name="id" value="<%= address._id %>">
                            
                            <div class="row">
                                <div class="col-md-4">
                                    <!--  -->
                                    <div class="form-group">
                                        <label>
                                            <i class="fas fa-tag me-1"></i>Address Type
                                        </label>
                                        </div>
                                        <div class="d-flex gap-3 mt-2">
                                            <div>
                                                <input type="radio" name="addressTypeRadio" id="home" value="Home">
                                                <label for="home">Home</label>
                                            </div>

                                             <div>
                                            <input type="radio" name="addressTypeRadio" id="work" value="Work">
                                            <label for="work">Work</label>
                                            </div>

                                            <div>
                                            <input type="radio" name="addressTypeRadio" id="other" value="Other">
                                            <label for="other">Other</label>
                                            </div>

                                            </div>

                                            <input type="hidden" id="addressType" name="addressType"
                                            value="<%= address.addressType %>">

                                            <input type="text" id="otherAddressType" class="form-control mt-2 d-none"  placeholder="Enter address type (e.g., Hostel, Parents House)">

                                        
                                        <!-- <input type="text" class="form-control border-3" value="<%= address.addressType %>" id="addressType" name="addressType" required> -->
                                        <div class="invalid-feedback"></div>
                                    </div>
                                
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="name">
                                            <i class="fas fa-user me-1"></i> Name
                                        </label>
                                        <input type="text" class="form-control" id="name" name="name" 
                                               value="<%= address.name %>" required minlength="2" maxlength="50">
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                      <div class="form-group">
                                        <label for="pincode">
                                            <i class="fas fa-mail-bulk me-1"></i>Pincode
                                        </label>
                                        <input type="text" class="form-control" id="pincode" name="pincode" 
                                               value="<%= address.pincode %>" required pattern="[0-9]{6}" maxlength="6">
                                        <div class="invalid-feedback"></div>
                                    </div>
                                   
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="landMark">
                                            <i class="fas fa-map-marker-alt me-1"></i>Landmark
                                        </label>
                                        <input type="text" class="form-control" id="landMark" name="landMark" 
                                               value="<%= address.landMark%>" required maxlength="100">
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="state">
                                            <i class="fas fa-map me-1"></i>State
                                        </label>
                                        <input type="text" class="form-control" id="state" name="state" 
                                               value="<%= address.state %>" required minlength="2" maxlength="50" readonly>
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                     <div class="form-group">
                                        <label for="city">
                                            <i class="fas fa-city me-1"></i>City
                                        </label>
                                        <input type="text" class="form-control" id="city" name="city" 
                                               value="<%= address.city %>" required minlength="2" maxlength="50" readonly>
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="phone">
                                            <i class="fas fa-phone me-1"></i>Phone Number
                                        </label>
                                        <input type="tel" class="form-control" id="phone" name="phone" 
                                               value="<%= address.phone %>" required pattern="[0-9]{10}" maxlength="10">
                                          <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="altPhone">
                                            <i class="fas fa-phone-alt me-1"></i>Alternate Phone
                                        </label>
                                        <input type="tel" class="form-control" id="altPhone" name="altPhone" 
                                               value="<%= address.altPhone %>" pattern="[0-9]{10}" maxlength="10">
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                            </div>


                            <div class="d-flex gap-3 mt-4">
                                  <button type="submit" id="submitButton" class="btn btn-primary">
                                Update Address
                                    <i class="fas fa-save me-2"></i>
                                </button>
                                <a href="/account" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left me-2"></i>Back to Addresses
                                </a>
                            </div>
                        </form>
                    </div> 
                </div>
            </div>
        </div>
    </main>

   

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>

        let isPincodeValid = false;

        const radios = document.querySelectorAll('input[name="addressTypeRadio"]');
        const otherInput = document.getElementById('otherAddressType');
        const hiddenAddressType = document.getElementById('addressType');


        // Set initial value while editing
        const existingType = hiddenAddressType.value;

        radios.forEach(radio => {
             if (radio.value === existingType) {
                    radio.checked = true;
                }
            });

            // If not Home or Work → Other
                if (existingType !== "Home" && existingType !== "Work") {
                document.getElementById("other").checked = true;
                otherInput.classList.remove("d-none");
                otherInput.value = existingType;
                }

                // Change handler
                radios.forEach(radio => {
                radio.addEventListener('change', () => {
                    if (radio.value === "Other") {
                    otherInput.classList.remove("d-none");
                    hiddenAddressType.value = "";
                    } else {
                    otherInput.classList.add("d-none");
                    otherInput.value = "";
                    hiddenAddressType.value = radio.value;
                    }
                });
                });

                // Sync "Other" input
            otherInput.addEventListener("input", () => {
            hiddenAddressType.value = otherInput.value.trim();
            });

         document.querySelectorAll(".form-control").forEach(input => {
    input.addEventListener("input", () => {
        input.classList.remove("is-invalid");
        if (input.nextElementSibling) input.nextElementSibling.textContent = "";
    });
});

//pincode

    document.getElementById('pincode').addEventListener('blur',fetchLocationPincode)

    async function fetchLocationPincode(){
        const pincode = document.getElementById('pincode').value.trim();
         isPincodeValid = false;
        if(!/^\d{6}$/.test(pincode)){
            Swal.fire({
                icon:'error',
                title:'Please',
                text:'Please enter a valid 6-digit pincode'
            })
            return;
        }

        try {
            const res = await fetch(`https://api.postalpincode.in/pincode/${pincode}`);

            const data = await res.json();
            console.log("data isss",data)
            if(data[0].Status === 'Success'){
                const postOffice = data[0].PostOffice[0];

                document.getElementById('city').value = postOffice.District
                document.getElementById('state').value = postOffice.State;

                isPincodeValid = true;
            }else{
                Swal.fire({
                    icon: "error",
                    title: "Not Found",
                    text: "No location found for this pincode",
                });

                document.getElementById('city').value = '';
                document.getElementById('state').value = '';
                
            }

        } catch (error) {
           console.error("errror in the fetch api of pincode",error)
             Swal.fire({
          icon: "error",
          title: "Error", 
          text: "Unable to fetch location details",
        });
        document.getElementById('city').value = '';
        document.getElementById('state').value = '';
        }
    }
   
        
document.getElementById('addressForm').addEventListener('submit',async function (event) {
        event.preventDefault()
       if (!validateForm()) {
           return;
       }

       const form = event.target;
       const formData = new FormData(form);
       const data = Object.fromEntries(formData.entries());

    //    const addressId = "<%=address._id %>";

       try {
        const response =await fetch ("/editAddress?id=<%= address._id.toLocaleString() %>",{
            method:'POST',
            headers:{
                'Content-Type' : 'application/json'
            },
            body:JSON.stringify(data)
        })

        const result = await response.json();
        if(response.ok){
            Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: result.message,
                timer: 2000,
                showConfirmButton: false,
                timerProgressBar:true
            }).then(()=>{
                window.location.href="/account?address=&tab=address"
            })
        }else{
            Swal.fire({
                icon: 'error',
                title: 'Error!',
                text: result.message || 'Failed to update address.'
                });
        }

       } catch (error) {
        console.error("Fetch error: in the edit address", error);
            Swal.fire({
                icon: 'error',
                title: 'Error!',
                text: 'Something went wrong. Try again.'
            });
       }

   });


   function validateForm() {
    let isValid = true;

        if(hiddenAddressType.value.trim() === ""){
        Swal.fire({
            icon:'error',
            title:'Address Type Required',
            text:'Please select or enter an address type'
        });
        return false;
    }

    if(!isPincodeValid){
            Swal.fire({
                icon:'error',
                title:'Invalid Pincode',
                text:'Please enter a valid pincode and wait for address auto-fill'
            });
            return false;
        }

    document.querySelectorAll(".invalid-feedback").forEach(div => div.textContent = "");
    document.querySelectorAll(".form-control").forEach(input => input.classList.remove("is-invalid"));

   const selectedType = document.querySelector('input[name="addressTypeRadio"]:checked');

        if(!selectedType){
            Swal.fire({
                icon:'error',
                title:'Address Type',
                text:'Please select an address type'
            });
            return false;
        }


    const fields = {
        addressType:{required:true,min:2},
        name:{required:true,min:2},
        city: { required: true, min: 2 },
        landMark: { required: true, min: 2 },
        state: { required: true, min: 2 },
        pincode:{required:true,regex:/^[0-9]{6}$/,message:'Pincode must be 6 digits' },
        phone:{required:true,regex:/^[0-9]{10}$/, message:'phone number must be 10 digits'},
        altPhone:{required:false,regex:/^[0-9]{10}$/,message:'Alt phone number must be 10 digits'}
    };

    for(let key in fields){
        const input = document.getElementById(key);
        const value = input.value.trim();
        const rules = fields[key]
        const errorDiv = input.nextElementSibling;

        if(rules.required && value === ''){
            errorDiv.textContent  = `${key} is required`;
            input.classList.add('is-invalid');
            isValid = false;
            continue;
        }

        if(rules.regex && value !== "" && !rules.regex.test(value)){
            errorDiv.textContent = rules.message;
            input.classList.add('is-invalid');
            isValid = false
            continue;
        }

        if(rules.min && value.length < rules.min){
            errorDiv.textContent =  `Minimum ${rules.min} characters required`;
            input.classList.add('is-invalid');
            isValid = false
            continue
        }
    }

    return isValid

}
document.getElementById('pincode').addEventListener('input', () => {
    isPincodeValid = false;
});
        
    </script>
</body>

<%-include('../../views/partials/user/supportfooter')%>